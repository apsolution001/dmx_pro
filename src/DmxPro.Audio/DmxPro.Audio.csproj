<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Decoding/playback use Windows Media Foundation (NAudio); pure analysis code builds and tests anywhere. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>DmxPro.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are required on types and non-obvious members, not on every trivial property. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DmxPro.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxPro.Core\DmxPro.Core.csproj" />
  </ItemGroup>

</Project>
