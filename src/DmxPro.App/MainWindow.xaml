<ui:FluentWindow
    x:Class="DmxPro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1440"
    Height="900"
    MinWidth="1024"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/Logo/dmxpro.ico"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!-- Section shortcuts follow the rail order (ShellViewModel.NavigationItems). -->
    <Window.InputBindings>
        <KeyBinding Command="{Binding NewProjectCommand}" Gesture="Ctrl+N" />
        <KeyBinding Command="{Binding OpenProjectCommand}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveProjectCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding SaveProjectAsCommand}" Gesture="Ctrl+Shift+S" />
        <KeyBinding Command="{Binding ToggleFullScreenCommand}" Gesture="F11" />
        <!-- Only enabled in full screen, so Esc is not swallowed otherwise. -->
        <KeyBinding Command="{Binding ExitFullScreenCommand}" Gesture="Escape" />
        <KeyBinding Command="{Binding AddFixtureCommand}" Gesture="Ctrl+Shift+A" />
        <KeyBinding Command="{Binding InputOutput.EnableOutputCommand}" Gesture="Ctrl+E" />
        <KeyBinding Command="{Binding InputOutput.DisableOutputCommand}" Gesture="Ctrl+Shift+E" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="0" Gesture="Ctrl+1" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="1" Gesture="Ctrl+2" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="2" Gesture="Ctrl+3" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="3" Gesture="Ctrl+4" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="4" Gesture="Ctrl+5" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="5" Gesture="Ctrl+6" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="7" Gesture="Ctrl+7" />
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="7" Gesture="Ctrl+OemComma" />
        <!-- Stage sits before Settings in the rail (index 6) but got Ctrl+8, so Ctrl+1 … Ctrl+7 did not move. -->
        <KeyBinding Command="{Binding NavigateToCommand}" CommandParameter="6" Gesture="Ctrl+8" />
        <KeyBinding Command="{Binding OpenStageWindowCommand}" Gesture="Ctrl+Shift+8" />
        <!-- Menu actions that work anywhere. Ctrl+X/C/V, Ctrl+D, Del and F2 are bound on the page lists instead (the
             focused list decides what they act on). Ctrl+B / Shift+Esc / F12 are free on every page: console widget
             shortcuts are unmodified keys, and the console handles F12 itself while it has focus. -->
        <KeyBinding Command="{Binding ShowMonitorCommand}" Gesture="Ctrl+M" />
        <KeyBinding Command="{Binding ToggleBlackoutCommand}" Gesture="Ctrl+B" />
        <KeyBinding Command="{Binding ReleaseAllCommand}" Gesture="Shift+Escape" />
        <KeyBinding Command="{Binding ToggleOperatorModeCommand}" Gesture="F12" />
        <!-- Go live (operate mode). Not F5: the Input / Output page refreshes devices on F5 and console keys may use it. -->
        <KeyBinding Command="{Binding ToggleLiveModeCommand}" Gesture="Ctrl+F5" />
    </Window.InputBindings>

    <!-- Desktop layout modelled on QLC+: title bar, menu, main toolbar, section rail + page area, status bar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Keeps WPF-UI's minimize / maximize / close buttons; hidden in full screen (MainWindow.xaml.cs). -->
        <!-- The small logo variant is drawn for 16-24 px, so it stays crisp at 100-150 % scaling. -->
        <ui:TitleBar
            x:Name="AppTitleBar"
            Title="{Binding WindowTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    AutomationProperties.Name="DMX Pro"
                    Source="{StaticResource Dmx.Logo.Small.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ═══ Menu bar: plan in docs/ui-plan.md §2. Items act on (and go to) the page they belong to; items for
             features that are not built yet are disabled with a "Coming soon" tooltip. ═══ -->
        <Menu
            x:Name="MainMenu"
            Grid.Row="1"
            xmlns:fn="clr-namespace:DmxPro.Core.Functions;assembly=DmxPro.Core"
            AutomationProperties.Name="Main menu"
            Style="{StaticResource TopMenu}">
            <MenuItem Header="_File">
                <MenuItem
                    Command="{Binding NewProjectCommand}"
                    Header="_New project"
                    InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="New" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding OpenProjectCommand}"
                    Header="_Open project…"
                    InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Open" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Last opened / saved projects (app settings). A missing file is removed with a message. -->
                <MenuItem
                    Header="Open _recent"
                    IsEnabled="{Binding HasRecentProjects}"
                    ItemsSource="{Binding RecentProjects}">
                    <MenuItem.Style>
                        <Style BasedOn="{StaticResource Dmx.MenuItem}" TargetType="MenuItem">
                            <Setter Property="ToolTip" Value="Projects you opened or saved recently" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                    <Setter Property="ToolTip" Value="No recent projects yet: open or save a project first" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem.ItemContainerStyle>
                        <Style BasedOn="{StaticResource Dmx.MenuItem}" TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Recent" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding SaveProjectCommand}"
                    Header="_Save"
                    InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Save" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding SaveProjectAsCommand}"
                    Header="Save _as…"
                    InputGestureText="Ctrl+Shift+S">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="SaveAs" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Header="Import QLC+ workspace (.qxw)…"
                    IsEnabled="False"
                    ToolTip="Coming soon">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Import" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Header="Export show report (PDF)…"
                    IsEnabled="False"
                    ToolTip="Coming soon">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Export" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding ExitCommand}"
                    Header="E_xit"
                    InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Exit" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Edit acts on the current page; items are disabled when that page has nothing to act on. -->
            <MenuItem Header="_Edit">
                <MenuItem
                    Command="{Binding UndoCommand}"
                    Header="_Undo"
                    InputGestureText="Ctrl+Z"
                    ToolTip="{Binding UndoToolTip}">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Undo" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding RedoCommand}"
                    Header="_Redo"
                    InputGestureText="Ctrl+Y"
                    ToolTip="{Binding RedoToolTip}">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Redo" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding CutCommand}"
                    Header="Cu_t"
                    InputGestureText="Ctrl+X"
                    ToolTip="Functions page: copy the selected function and delete it">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Cut" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding CopyCommand}"
                    Header="_Copy"
                    InputGestureText="Ctrl+C"
                    ToolTip="Functions page: copy the selected function">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Copy" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding PasteCommand}"
                    Header="_Paste"
                    InputGestureText="Ctrl+V"
                    ToolTip="Functions page: add a copy of the copied function">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Paste" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding DuplicateCommand}"
                    Header="_Duplicate"
                    InputGestureText="Ctrl+D"
                    ToolTip="Duplicate the selected fixtures, function, timeline item or console widget">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding DeleteCommand}"
                    Header="De_lete"
                    InputGestureText="Del"
                    ToolTip="Delete the selected fixtures, function, timeline item or console widget">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding RenameCommand}"
                    Header="Rena_me"
                    InputGestureText="F2"
                    ToolTip="Rename the selected function, show or console page">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Routed to the focused control: selects every row of a table or all text of a text box. -->
                <MenuItem
                    Command="ApplicationCommands.SelectAll"
                    Header="Select _all"
                    InputGestureText="Ctrl+A"
                    ToolTip="Select every row of the focused table, or all text of the focused text box">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="SelectAll" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Header="_Search everything…"
                    InputGestureText="Ctrl+K"
                    IsEnabled="False"
                    ToolTip="Coming soon">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Search" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="0"
                    Header="_Fixtures"
                    InputGestureText="Ctrl+1">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Fixtures" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="1"
                    Header="F_unctions"
                    InputGestureText="Ctrl+2">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Functions" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="2"
                    Header="_Shows"
                    InputGestureText="Ctrl+3">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Timeline" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="3"
                    Header="_Virtual Console"
                    InputGestureText="Ctrl+4">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Console" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="4"
                    Header="T_est &amp; Preview"
                    InputGestureText="Ctrl+5">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Test" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="5"
                    Header="_Input / Output"
                    InputGestureText="Ctrl+6">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="InputOutput" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="6"
                    Header="St_age"
                    InputGestureText="Ctrl+8">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Stage" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="7"
                    Header="Se_ttings"
                    InputGestureText="Ctrl+7">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Settings" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding ShowMonitorCommand}"
                    Header="DMX _monitor"
                    InputGestureText="Ctrl+M"
                    ToolTip="Opens Test &amp; Preview with the live DMX values of every channel">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Monitor" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding OpenStageWindowCommand}"
                    Header="Stage _window"
                    InputGestureText="Ctrl+Shift+8"
                    ToolTip="Opens the live stage in its own window">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Stage" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- The checkmark replaces the icon on the active theme. -->
                <MenuItem
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="Dark"
                    Header="_Dark theme"
                    IsCheckable="False"
                    IsChecked="{Binding IsDarkTheme, Mode=OneWay}">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="ThemeDark" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="Light"
                    Header="Lig_ht theme"
                    IsCheckable="False"
                    IsChecked="{Binding IsDarkTheme, Mode=OneWay, Converter={StaticResource InvertBool}}">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="ThemeLight" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding ToggleFullScreenCommand}"
                    Header="Full sc_reen"
                    InputGestureText="F11"
                    IsCheckable="False"
                    IsChecked="{Binding IsFullScreen, Mode=OneWay}">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="FullScreen" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Fi_xtures">
                <MenuItem
                    Command="{Binding AddFixtureCommand}"
                    Header="_Add fixture…"
                    InputGestureText="Ctrl+Shift+A">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewGroupCommand}"
                    Header="Add _group"
                    ToolTip="New group from the fixtures selected on the Fixtures page (empty when none is selected)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Group" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding AutoPatchCommand}"
                    Header="Auto-_patch selected"
                    ToolTip="Moves the fixtures selected on the Fixtures page to the first free addresses, one after another">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="AutoPatch" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding ImportProfileCommand}" Header="_Import fixture profile (.qxf / .json)…">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Import" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFixtureProfileCommand}"
                    Header="_New fixture profile…"
                    ToolTip="Opens the channel layout editor for a new layout">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="ProfileNew" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- New … opens the Functions page with the new function in its editor. -->
            <MenuItem Header="F_unctions">
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Scene}"
                    Header="New _scene">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Scenes" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Chaser}"
                    Header="New _chaser">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Chaser" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Sequence}"
                    Header="New se_quence">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Sequence" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.ColorCycle}"
                    Header="New color c_ycle">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="ColorCycle" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Fade}"
                    Header="New _fade">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Fade" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Pulse}"
                    Header="New _pulse">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Pulse" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Flash}"
                    Header="New f_lash">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Flash" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Strobe}"
                    Header="New st_robe">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Strobe" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Header="Create starter sce_nes"
                    IsEnabled="False"
                    ToolTip="Coming soon">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Wizard" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding ReleaseAllCommand}"
                    Header="S_top all functions"
                    InputGestureText="Shift+Esc"
                    ToolTip="Stops every function and show and returns channels to their defaults (same as Release all)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="StopAll" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Acts on the show selected on the Shows page (and opens that page). -->
            <MenuItem Header="_Show">
                <MenuItem Command="{Binding NewShowCommand}" Header="_New show">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Timeline" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding AddTrackCommand}"
                    Header="Add _track"
                    ToolTip="Adds a track to the show selected on the Shows page">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding ShowPlayPauseCommand}"
                    Header="_Play / Pause"
                    InputGestureText="Space"
                    ToolTip="Plays or pauses the show selected on the Shows page (Space on the timeline)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Play" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding ShowStopCommand}"
                    Header="_Stop &amp; return to start"
                    ToolTip="Stops the show selected on the Shows page and moves the playhead to 0:00">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Stop" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Output">
                <MenuItem
                    Command="{Binding InputOutput.EnableOutputCommand}"
                    Header="_Enable DMX output"
                    InputGestureText="Ctrl+E">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="OutputOn" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding InputOutput.DisableOutputCommand}"
                    Header="_Disable DMX output"
                    InputGestureText="Ctrl+Shift+E">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="OutputOff" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Safety rule 3: Blackout sends a dark frame; it never disables output. Checked while on. -->
                <MenuItem
                    Command="{Binding ToggleBlackoutCommand}"
                    Header="_Blackout"
                    InputGestureText="Ctrl+B"
                    IsCheckable="False"
                    IsChecked="{Binding IsBlackout, Mode=OneWay}"
                    ToolTip="All lights dark while on; DMX output keeps sending (this is not Disable DMX output)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Blackout" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding ReleaseAllCommand}"
                    Header="_Release all"
                    InputGestureText="Shift+Esc"
                    ToolTip="Stops every function and show and returns channels to their defaults">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="ReleaseAll" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Live mode is a mode switch (only the Virtual Console drives the lights), not output enable. -->
                <MenuItem
                    Command="{Binding ToggleLiveModeCommand}"
                    Header="Go _live"
                    InputGestureText="Ctrl+F5"
                    IsCheckable="False"
                    IsChecked="{Binding IsLive, Mode=OneWay}"
                    ToolTip="Only the Virtual Console drives the lights while checked; DMX output on/off is separate">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Live" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="5"
                    Header="_Configure outputs…">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="InputOutput" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="4"
                    Header="_Test fixture…">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Test" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding OpenProfileEditorCommand}"
                    Header="_Profile editor…"
                    ToolTip="Edits the channel layout of the light selected on the Fixtures page, or starts a new layout">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Profile" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding ToggleOperatorModeCommand}"
                    Header="_Operator mode (lock editing)"
                    InputGestureText="F12"
                    IsCheckable="False"
                    IsChecked="{Binding IsOperatorMode, Mode=OneWay}"
                    ToolTip="Locks the Virtual Console for live use (hides page and layout editing)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Lock" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="7"
                    Header="_Settings"
                    InputGestureText="Ctrl+,">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Settings" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem
                    Header="_Getting started"
                    InputGestureText="F1"
                    IsEnabled="False"
                    ToolTip="Coming soon">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Help" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ShowShortcutsCommand}" Header="_Keyboard shortcuts">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Keyboard" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Header="_DMX basics"
                    IsEnabled="False"
                    ToolTip="Coming soon">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Info" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Command="{Binding ShowAboutCommand}" Header="_About DMX Pro">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="About" Size="{StaticResource Dmx.MenuIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ═══ Main toolbar: [file] | [undo/redo] | [monitor, stop all, blackout] | [full screen]. ═══ -->
        <Border Grid.Row="2" Style="{StaticResource ToolbarStrip}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="New project"
                        Command="{Binding NewProjectCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="New project (Ctrl+N)">
                        <c:DmxIcon Kind="New" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Open project"
                        Command="{Binding OpenProjectCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Open project (Ctrl+O)">
                        <c:DmxIcon Kind="Open" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Save"
                        Command="{Binding SaveProjectCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Save (Ctrl+S)">
                        <c:DmxIcon Kind="Save" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Save as"
                        Command="{Binding SaveProjectAsCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Save as (Ctrl+Shift+S)">
                        <c:DmxIcon Kind="SaveAs" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button
                        AutomationProperties.HelpText="{Binding UndoToolTip}"
                        AutomationProperties.Name="Undo"
                        Command="{Binding UndoCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="{Binding UndoToolTip}">
                        <c:DmxIcon Kind="Undo" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.HelpText="{Binding RedoToolTip}"
                        AutomationProperties.Name="Redo"
                        Command="{Binding RedoCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="{Binding RedoToolTip}">
                        <c:DmxIcon Kind="Redo" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button
                        AutomationProperties.Name="DMX monitor"
                        Command="{Binding ShowMonitorCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="DMX monitor (Ctrl+M): live values of every channel, on Test &amp; Preview">
                        <c:DmxIcon Kind="Monitor" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Stop all functions"
                        Command="{Binding ReleaseAllCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Stop all functions and shows (Shift+Esc)">
                        <c:DmxIcon Kind="StopAll" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Blackout"
                        Command="{Binding ToggleBlackoutCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Blackout on/off (Ctrl+B): lights dark, DMX output keeps sending">
                        <c:DmxIcon Kind="Blackout" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button
                        AutomationProperties.Name="Full screen"
                        Command="{Binding ToggleFullScreenCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Full screen (F11)">
                        <c:DmxIcon Kind="FullScreen" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                </StackPanel>
                <!--
                    Right side: live actions. Go live (operate mode, Ctrl+F5) left of the Stage window button; the
                    Blackout / Output buttons (phases 4 and 7) follow.
                -->
                <StackPanel
                    x:Name="ToolbarRightPanel"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <!--
                        Go live: a mode switch, NOT output enable. On = accent fill + filled broadcast icon + "Live" (not colour only).
                        Labelled, so the fixed 24 px width of ToolbarToggleButton is lifted here.
                    -->
                    <ToggleButton
                        Width="Auto"
                        Height="{StaticResource Dmx.ControlHeight}"
                        Padding="{StaticResource Dmx.LabelledButtonPadding}"
                        AutomationProperties.Name="{Binding LiveAutomationName}"
                        IsChecked="{Binding IsLive, Mode=TwoWay}"
                        Style="{StaticResource ToolbarToggleButton}"
                        ToolTip="{Binding LiveToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="{Binding LiveIconKind}" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding LiveButtonText}" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Style="{StaticResource ToolbarSeparator}" />
                    <Button
                        AutomationProperties.Name="Open the live stage window"
                        Command="{Binding OpenStageWindowCommand}"
                        Style="{StaticResource ToolbarLabelButton}"
                        ToolTip="Open the live stage in its own window (Ctrl+Shift+8)">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Stage" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Stage window" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Body: section rail + page area ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vertical section rail (icon above label), like QLC+'s main tabs. -->
            <Border
                Grid.Column="0"
                Width="{StaticResource Dmx.NavRailWidth}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    AutomationProperties.Name="Main sections"
                    ItemsSource="{Binding NavigationItems}"
                    SelectedItem="{Binding SelectedItem}"
                    Style="{StaticResource NavRail}">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource NavRailItem}" TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel>
                                <c:DmxIcon
                                    HorizontalAlignment="Center"
                                    Kind="{Binding IconKind}"
                                    Size="{StaticResource Dmx.NavIconSize}" />
                                <TextBlock Style="{StaticResource NavRailLabel}" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!--
                Page area: shell messages (open/save/import results) above the current page. Success messages hide after
                ~3 s; warnings/errors stay until closed. IsOpen is two-way so the close button clears the message
                (ShellViewModel.ShowInfo).
            -->
            <DockPanel Grid.Column="1">
                <ui:InfoBar
                    Margin="2,2,2,0"
                    DockPanel.Dock="Top"
                    IsClosable="True"
                    IsOpen="{Binding IsInfoOpen, Mode=TwoWay}"
                    Message="{Binding InfoMessage}"
                    Severity="{Binding InfoSeverity}"
                    Visibility="{Binding InfoMessage, Converter={StaticResource NullToVisibility}}" />
                <!-- Keeps each page view alive once built: switching pages no longer rebuilds the whole view. -->
                <c:PageHost Margin="0,2,0,0" Page="{Binding CurrentPage}">
                    <c:PageHost.Style>
                        <Style TargetType="c:PageHost">
                            <Style.Triggers>
                                <!-- No gap above the page toolbar when there is no message. -->
                                <DataTrigger Binding="{Binding InfoMessage}" Value="{x:Null}">
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:PageHost.Style>
                </c:PageHost>
            </DockPanel>
        </Grid>

        <!-- ═══ Status bar: always visible (spec §1 "clear status"). ═══ -->
        <Border Grid.Row="4" Style="{StaticResource StatusBarStrip}">
            <DockPanel LastChildFill="False">
                <!-- Safety rule 1: output starts disabled on every launch; the pill says so in words, not colour only. -->
                <Border
                    AutomationProperties.Name="{Binding OutputStatusText}"
                    DockPanel.Dock="Left"
                    ToolTip="{Binding OutputStatusToolTip}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource StatusPill}" TargetType="Border">
                            <Setter Property="Tag" Value="{Binding OutputState}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputState}" Value="Connecting">
                                    <Setter Property="Tag" Value="Connected" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding OutputStatusText}" />
                    </StackPanel>
                </Border>
                <Rectangle
                    Margin="6,0"
                    DockPanel.Dock="Left"
                    Style="{StaticResource ToolbarSeparator}" />
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource StatusText}"
                    Text="{Binding PatchStatusText}" />
                <TextBlock
                    MaxWidth="560"
                    DockPanel.Dock="Right"
                    Style="{StaticResource StatusText}"
                    Text="{Binding FileStatusText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding FileStatusText}" />
            </DockPanel>
        </Border>

        <!-- ═══ Floating "Exit full screen" button (only in full screen, where the title bar is hidden). ═══ -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="5"
            Margin="0,2,6,0"
            Padding="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Dmx.CornerRadius}"
            Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVisibility}}">
            <Button
                AutomationProperties.Name="Exit full screen"
                Command="{Binding ExitFullScreenCommand}"
                Style="{StaticResource ToolbarButton}"
                ToolTip="Exit full screen (F11 or Esc)">
                <c:DmxIcon Kind="ExitFullScreen" Size="{StaticResource Dmx.ToolbarIconSize}" />
            </Button>
        </Border>
    </Grid>
</ui:FluentWindow>
