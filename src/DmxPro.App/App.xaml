<Application
    x:Class="DmxPro.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DmxPro.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dark by default: operators work in dark venues. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBooleanConverter x:Key="InvertBool" />

            <!-- Each page ViewModel is rendered by its View. -->
            <DataTemplate DataType="{x:Type vm:FixturesViewModel}">
                <views:FixturesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <views:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
                <views:ComingSoonView />
            </DataTemplate>

            <!--
                Desktop (QLC+-style) building blocks: toolbars, panels with title bars, splitters, dense forms.
                See docs/standards/ui-ux-guidelines.md.
            -->

            <!-- Horizontal strip that holds a page's or the window's tool buttons. -->
            <Style x:Key="ToolbarStrip" TargetType="Border">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <!-- Vertical divider between groups of tool buttons. -->
            <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- A docked panel (fixture list, properties, groups…). -->
            <Style x:Key="PanelBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Title row at the top of a panel. -->
            <Style x:Key="PanelHeader" TargetType="Border">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="VerticalSplitter" TargetType="GridSplitter">
                <Setter Property="Width" Value="5" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
                <Setter Property="ResizeDirection" Value="Columns" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="HorizontalSplitter" TargetType="GridSplitter">
                <Setter Property="Height" Value="5" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
                <Setter Property="ResizeDirection" Value="Rows" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
