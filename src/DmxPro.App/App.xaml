<Application
    x:Class="DmxPro.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:conv="clr-namespace:DmxPro.App.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dark by default: operators work in dark venues. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Icon geometries (Icon.<Name>), generated by tools/icons; used by Controls/DmxIcon. -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <!-- DMX Pro design system: toolbars, panels, forms, menu, nav rail, tables, status bar, plus the
                     layout metrics (Themes/Metrics.xaml). Key contract: top of Themes/Styles.xaml. -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/ChannelFader.xaml" />
                <!-- App logo as vector images (Dmx.Logo.Image, Dmx.Logo.Small.Image); see the key list in the file. -->
                <ResourceDictionary Source="Themes/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBooleanConverter x:Key="InvertBool" />

            <!--
                Compact density (owner request 2026-10-18). WPF-UI reads these keys with {DynamicResource}, and keys in
                this dictionary win over the merged WPF-UI dictionaries, so every WPF-UI control shrinks centrally.
                Values mirror Themes/Metrics.xaml (Dmx.FontSize.Body, Dmx.TextControlPadding, Dmx.ControlHeight,
                Dmx.ListRowMinHeight) - keep them in sync. Do NOT use <StaticResource x:Key="..."/> items here: in a
                compiled application dictionary they make neighbouring keys (e.g. InvertBool) vanish at runtime.
            -->
            <sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
            <sys:Double x:Key="ContentControlFontSize">12</sys:Double>
            <sys:Double x:Key="TreeViewItemFontSize">12</sys:Double>
            <sys:Double x:Key="DefaultDataGridFontSize">12</sys:Double>
            <Thickness x:Key="TextControlThemePadding">6,3,6,1</Thickness>
            <!-- MinHeight of every WPF-UI TextBox / NumberBox / PasswordBox / ComboBox (WPF-UI default 32). -->
            <sys:Double x:Key="TextControlThemeMinHeight">24</sys:Double>
            <Thickness x:Key="ComboBoxPadding">6,2,0,2</Thickness>
            <Thickness x:Key="ComboBoxItemMargin">4,1,4,0</Thickness>
            <sys:Double x:Key="ListViewItemMinHeight">20</sys:Double>
            <sys:Double x:Key="TreeViewItemMinHeight">20</sys:Double>

            <!--
                Design-system styles that derive from WPF-UI's defaults (BasedOn="{StaticResource {x:Type ...}}").
                They must live in this dictionary, not in Themes/Styles.xaml: a StaticResource inside a merged
                dictionary cannot see its sibling merged dictionaries (ui:ControlsDictionary).
                Documented with the rest of the key contract at the top of Themes/Styles.xaml.
            -->
            <Style
                x:Key="FormTextBox"
                BasedOn="{StaticResource {x:Type ui:TextBox}}"
                TargetType="ui:TextBox">
                <!-- WPF-UI's template sizes its border from MinHeight (not Height), so set both. -->
                <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
                <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
                <!-- 1 px border + 3 + ~16 px text line (12 px font) + rest = 24: text sits centred. -->
                <Setter Property="Padding" Value="6,3,6,0" />
                <Setter Property="Margin" Value="{StaticResource Dmx.FormRowMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style
                x:Key="FormNumberBox"
                BasedOn="{StaticResource {x:Type ui:NumberBox}}"
                TargetType="ui:NumberBox">
                <Style.Resources>
                    <!--
                        WPF-UI hard-codes the inline spin buttons as 24x24, 5 px below the top border (sized for 32 px
                        boxes), and sets Width/Height/Margin locally, so only a render transform can move them. Shrink
                        them to 20x20 around their centre and lift them 6 px: centre = 1 + 5 + 12 - 6 = 12, the middle
                        of the 24 px box (Dmx.ControlHeight). Re-check these numbers if Dmx.ControlHeight changes.
                    -->
                    <Style BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="ui:Button">
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.8333" ScaleY="0.8333" />
                                    <TranslateTransform Y="-6" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
                <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
                <Setter Property="Padding" Value="6,3,6,0" />
                <Setter Property="Margin" Value="{StaticResource Dmx.FormRowMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SpinButtonPlacementMode" Value="Inline" />
                <Setter Property="MaxDecimalPlaces" Value="0" />
                <Setter Property="SmallChange" Value="1" />
                <Setter Property="LargeChange" Value="10" />
                <Setter Property="ClearButtonEnabled" Value="False" />
            </Style>

            <Style
                x:Key="FormComboBox"
                BasedOn="{StaticResource {x:Type ComboBox}}"
                TargetType="ComboBox">
                <!-- WPF-UI's template sizes its border from MinHeight (not Height), so set both. -->
                <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
                <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
                <Setter Property="MinWidth" Value="110" />
                <Setter Property="Padding" Value="6,0,0,0" />
                <Setter Property="Margin" Value="{StaticResource Dmx.FormRowMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="DataTable"
                BasedOn="{StaticResource {x:Type DataGrid}}"
                TargetType="DataGrid">
                <Style.Resources>
                    <!-- The filler header right of the last column picks this up too. -->
                    <Style BasedOn="{StaticResource DataTableColumnHeader}" TargetType="DataGridColumnHeader" />
                </Style.Resources>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="AlternatingRowBackground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeight" Value="{StaticResource Dmx.TableRowHeight}" />
                <Setter Property="ColumnHeaderHeight" Value="{StaticResource Dmx.TableHeaderHeight}" />
                <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Body}" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="RowStyle" Value="{StaticResource DataTableRow}" />
                <Setter Property="CellStyle" Value="{StaticResource DataTableCell}" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataTableColumnHeader}" />
            </Style>

            <!--
                Implicit compact styles for WPF-UI controls (they keep WPF-UI's look; only spacing and size shrink).
                Views that BasedOn="{StaticResource {x:Type ...}}" pick these up too.
                These implicit styles carry NO BasedOn in XAML: inside App.xaml a BasedOn="{StaticResource {x:Type T}}"
                finds the style being defined and silently ends up null (the TitleBar then had no template and crashed).
                App.ChainImplicitStylesToWpfUi links each one to WPF-UI's style for the same type at startup.
            -->
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Body}" />
            </Style>

            <!-- No MinHeight here: templated Buttons (address map cells, NumberBox spin buttons) must keep their size. -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="{StaticResource Dmx.ButtonPadding}" />
            </Style>
            <Style TargetType="ui:Button">
                <Setter Property="Padding" Value="{StaticResource Dmx.ButtonPadding}" />
            </Style>

            <!--
                Compact check box: WPF-UI hard-codes a 22 px box on a 32 px row. Same brushes and states, 16 px box
                (Dmx.CheckBoxSize) on a 20 px row (Dmx.CheckRowHeight). Keyboard focus keeps WPF-UI's focus visual.
            -->
            <Style TargetType="CheckBox">
                <Setter Property="MinHeight" Value="{StaticResource Dmx.CheckRowHeight}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="6,0,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="Box"
                                    Width="{StaticResource Dmx.CheckBoxSize}"
                                    Height="{StaticResource Dmx.CheckBoxSize}"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                    <Grid>
                                        <c:DmxIcon
                                            x:Name="CheckGlyph"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource CheckBoxCheckGlyphForeground}"
                                            Kind="Check"
                                            Size="{StaticResource Dmx.DenseIconSize}"
                                            Visibility="Collapsed" />
                                        <Rectangle
                                            x:Name="IndeterminateGlyph"
                                            Width="8"
                                            Height="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource CheckBoxCheckGlyphForeground}"
                                            RadiusX="1"
                                            RadiusY="1"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="ContentPresenter" Property="Margin" Value="0" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPointerOver}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="IndeterminateGlyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBorderBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOver}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="{x:Null}" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOver}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedDisabled}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}" />
                                    <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}" />
                                    <Setter TargetName="IndeterminateGlyph" Property="Fill" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact radio button: WPF-UI hard-codes 20 px circles on a 32 px row; here 16 px on a 20 px row. -->
            <Style TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="{StaticResource Dmx.CheckRowHeight}" />
                <Setter Property="Padding" Value="6,0,0,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid
                                MinHeight="{TemplateBinding MinHeight}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="{StaticResource Dmx.CheckBoxSize}"
                                    Height="{StaticResource Dmx.CheckBoxSize}"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="OuterEllipse"
                                        Fill="{DynamicResource RadioButtonOuterEllipseFill}"
                                        Stroke="{DynamicResource RadioButtonOuterEllipseStroke}"
                                        StrokeThickness="1"
                                        UseLayoutRounding="False" />
                                    <Ellipse
                                        x:Name="CheckOuterEllipse"
                                        Fill="{TemplateBinding Background}"
                                        Opacity="0"
                                        Stroke="{TemplateBinding Background}"
                                        StrokeThickness="1"
                                        UseLayoutRounding="False" />
                                    <Ellipse
                                        x:Name="CheckGlyph"
                                        Width="8"
                                        Height="8"
                                        Fill="{DynamicResource RadioButtonCheckGlyphFill}"
                                        Opacity="0"
                                        Stroke="{DynamicResource CircleElevationBorderBrush}"
                                        UseLayoutRounding="False" />
                                </Grid>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="ContentPresenter" Property="Margin" Value="0" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="OuterEllipse" Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillPointerOver}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsPressed" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="CheckGlyph" Property="Opacity" Value="1" />
                                    <Setter TargetName="OuterEllipse" Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillPressed}" />
                                    <Setter TargetName="OuterEllipse" Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseStrokePressed}" />
                                </MultiTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckGlyph" Property="Opacity" Value="1" />
                                    <Setter TargetName="OuterEllipse" Property="Opacity" Value="0" />
                                    <Setter TargetName="CheckOuterEllipse" Property="Opacity" Value="1" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <!-- Fluent: the dot grows slightly on hover. -->
                                    <Setter TargetName="CheckGlyph" Property="Width" Value="10" />
                                    <Setter TargetName="CheckGlyph" Property="Height" Value="10" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="False" />
                                        <Condition Property="IsEnabled" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{DynamicResource RadioButtonForegroundDisabled}" />
                                    <Setter TargetName="OuterEllipse" Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillDisabled}" />
                                    <Setter TargetName="OuterEllipse" Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseStrokeDisabled}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsEnabled" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{DynamicResource RadioButtonForegroundDisabled}" />
                                    <Setter TargetName="OuterEllipse" Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillDisabled}" />
                                    <Setter TargetName="OuterEllipse" Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseCheckedStrokeDisabled}" />
                                    <Setter TargetName="CheckGlyph" Property="Opacity" Value="0.7" />
                                    <Setter TargetName="CheckOuterEllipse" Property="Opacity" Value="0.7" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="6,2" />
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Body}" />
            </Style>

            <!--
                Compact info bar: WPF-UI's template ignores Padding (hard-coded 16,14,16,10, ~50 px tall). One line,
                24 px min height: [severity icon] Title Message ... [close]. Same severity brushes; the icon changes
                shape per severity too, so state is never colour-only. Appears with a short fade + 4 px drop
                (DmxMotion.Normal, ease-out; instant when Windows animations are off).
            -->
            <Style TargetType="ui:InfoBar">
                <Setter Property="Padding" Value="6,1,2,1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:InfoBar">
                            <Border
                                x:Name="ContentBorder"
                                MinHeight="{StaticResource Dmx.ControlHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Dmx.CornerRadius}"
                                SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <DockPanel>
                                    <c:DmxIcon
                                        x:Name="SeverityIcon"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Kind="Info"
                                        Size="{StaticResource Dmx.SmallIconSize}">
                                        <c:DmxIcon.Foreground>
                                            <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                        </c:DmxIcon.Foreground>
                                    </c:DmxIcon>
                                    <Button
                                        x:Name="CloseButton"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="Close message"
                                        Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource PanelHeaderButton}"
                                        ToolTip="Close">
                                        <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TitleText"
                                            Margin="0,0,6,0"
                                            FontWeight="SemiBold"
                                            Text="{TemplateBinding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" />
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsOpen" Value="False">
                                    <Setter TargetName="ContentBorder" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsOpen" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="Stop">
                                                <DoubleAnimation
                                                    EasingFunction="{x:Static c:DmxMotion.EaseOut}"
                                                    Storyboard.TargetName="ContentBorder"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0"
                                                    To="1"
                                                    Duration="{x:Static c:DmxMotion.Normal}" />
                                                <DoubleAnimation
                                                    EasingFunction="{x:Static c:DmxMotion.EaseOut}"
                                                    Storyboard.TargetName="ContentBorder"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                    From="-4"
                                                    To="0"
                                                    Duration="{x:Static c:DmxMotion.Normal}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsClosable" Value="False">
                                    <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Title" Value="{x:Null}">
                                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Title" Value="">
                                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Success">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                                    <Setter TargetName="SeverityIcon" Property="Kind" Value="Verified" />
                                    <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Warning">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                                    <Setter TargetName="SeverityIcon" Property="Kind" Value="Warning" />
                                    <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Error">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                                    <Setter TargetName="SeverityIcon" Property="Kind" Value="Error" />
                                    <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ui:TitleBar">
                <Setter Property="Height" Value="{StaticResource Dmx.TitleBarHeight}" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <!-- Context menus use the menu bar's compact item style (22 px rows, icon slot, gesture column). -->
            <Style TargetType="ContextMenu">
                <Style.Resources>
                    <Style BasedOn="{StaticResource Dmx.MenuItem}" TargetType="MenuItem">
                        <Setter Property="Margin" Value="4,0" />
                    </Style>
                    <Style
                        x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                        BasedOn="{StaticResource Dmx.MenuSeparator}"
                        TargetType="Separator" />
                </Style.Resources>
            </Style>

            <!-- Each page ViewModel is rendered by its View. -->
            <DataTemplate DataType="{x:Type vm:FixturesViewModel}">
                <views:FixturesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FunctionsViewModel}">
                <views:FunctionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShowsViewModel}">
                <views:ShowsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VirtualConsoleViewModel}">
                <views:VirtualConsoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InputOutputViewModel}">
                <views:InputOutputView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TestPageViewModel}">
                <views:TestPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StagePageViewModel}">
                <views:StageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
                <views:ComingSoonView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
