<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DmxPro.App</RootNamespace>
    <AssemblyName>DmxPro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe / taskbar / Explorer icon (embedded in the apphost, so single-file publish keeps it). -->
    <ApplicationIcon>Assets\Logo\dmxpro.ico</ApplicationIcon>
    <!-- Lets the solution build in Linux CI/cloud containers; the app itself runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projects leave System.IO out of implicit usings (it clashes with System.Windows.Shapes.Path in XAML). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DmxPro.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxPro.Core\DmxPro.Core.csproj" />
    <ProjectReference Include="..\DmxPro.Engine\DmxPro.Engine.csproj" />
    <ProjectReference Include="..\DmxPro.Output\DmxPro.Output.csproj" />
    <ProjectReference Include="..\DmxPro.Audio\DmxPro.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icons (pack://application:,,,/Assets/Logo/dmxpro.ico). The SVG/PNG next to it are source/docs only. -->
    <Resource Include="Assets\Logo\dmxpro.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped as a real folder next to DmxPro.exe (also in single-file publish) so users can see and add profiles. -->
    <Content Include="..\..\profiles\*.dmxprofile.json" LinkBase="profiles" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
