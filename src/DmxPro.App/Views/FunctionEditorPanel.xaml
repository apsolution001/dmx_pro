<UserControl
    x:Class="DmxPro.App.Views.FunctionEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=ed:FunctionEditorViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="1100"
    AutomationProperties.Name="{Binding EditorAutomationName}"
    mc:Ignorable="d">
    <!--
        The function editor host (DataContext: a FunctionEditorViewModel), shared by the Functions page (below the
        function tree) and the Shows page (a show's own copy). Toolbar row (save, revert, preview / live, show-in-list,
        name, close), the show-copy banner, then the editor of the function's type, picked by
        the DataTemplates below: Scene = General / Channels tabs; Chaser, Sequence, Color cycle, Fade, Pulse, Flash and
        Strobe = their own views in Views/Editors. Esc anywhere in the editor = Close (asks when there are unsaved
        changes); controls that use Esc themselves (value boxes, lists, flyouts) handle it first.

        [✓][✕] | [▶ Preview] (Live on lights) | [ ] Show in function list | (icon) [name......] | Fade in [0] s  Fade out [0] s  Unsaved changes [Close]
        (the fade boxes only for scenes; the other types set their timing in their own editors)
        (editor of the type)
    -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding CloseCommand}" Gesture="Escape" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- ═════ Editor tabs: flat strip, accent underline on the selected tab ═════ -->
        <Style x:Key="EditorTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Body}" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.TabHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4,4,0,0"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter
                                    Margin="0,0,0,2"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                                <Border
                                    x:Name="Underline"
                                    Height="2"
                                    Margin="-4,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1"
                                    Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorTabItem}" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <Border
                                Padding="4,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                DockPanel.Dock="Top"
                                SnapsToDevicePixels="True">
                                <ScrollViewer
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled">
                                    <StackPanel
                                        IsItemsHost="True"
                                        KeyboardNavigation.TabIndex="1"
                                        Orientation="Horizontal" />
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                ContentSource="SelectedContent"
                                KeyboardNavigation.TabIndex="2" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seconds box of the scene fade times in the toolbar (CommitTextBox: Enter/Tab applies, Esc undoes the typing). -->
        <Style
            x:Key="ToolbarSecondsBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:CommitTextBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border
            DockPanel.Dock="Top"
            Style="{StaticResource PageToolbar}">
            <DockPanel LastChildFill="False">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Save function"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Save the changes to this function">
                        <c:DmxIcon Kind="Check" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Revert changes"
                        Command="{Binding RevertCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Revert: throw away the unsaved changes">
                        <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <!--
                        Live edit preview hint (owner decision 2026-10-22): the open editor's draft shows on the lights
                        automatically while not live, so there is no Preview button / "Live on lights" switch. Neutral
                        info style, not a warning.
                    -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Orientation="Horizontal"
                        ToolTip="While this editor is open, your unsaved changes show on the lights. Not in live mode (Ctrl+F5), and only while DMX output is enabled."
                        Visibility="{Binding HasPreviewStatus, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Kind="Preview"
                            Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding PreviewStatus}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsShowCopy, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Style="{StaticResource ToolbarSeparator}" />
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Show in function list"
                            Content="Show in function list"
                            IsChecked="{Binding ShowInFunctionList}"
                            ToolTip="This is a show's own copy: changing it never changes the original. Untick to list it only in its show." />
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />
                </StackPanel>

                <DockPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                    <c:DmxIcon
                        Margin="2,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Kind="{Binding IconKind}"
                        Size="{StaticResource Dmx.SmallIconSize}"
                        ToolTip="{Binding TypeName}" />
                    <ui:TextBox
                        Width="180"
                        Margin="0"
                        AutomationProperties.Name="Function name"
                        PlaceholderText="Name"
                        Style="{StaticResource FormTextBox}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding TypeName, StringFormat={}{0} name}" />
                </DockPanel>

                <!-- Scene fade times; other function types get the empty template (their timing is in their editor). -->
                <ContentControl
                    VerticalAlignment="Center"
                    Content="{Binding}"
                    DockPanel.Dock="Left"
                    Focusable="False"
                    IsTabStop="False">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type ed:FunctionEditorViewModel}">
                            <Border />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SceneEditorViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                                <TextBlock
                                    Margin="2,0,4,0"
                                    VerticalAlignment="Center"
                                    Text="Fade in" />
                                <c:CommitTextBox
                                    AutomationProperties.Name="Fade in, seconds"
                                    Style="{StaticResource ToolbarSecondsBox}"
                                    Text="{Binding FadeInText}"
                                    ToolTip="Fade in, seconds (e.g. 0.5) · Enter or Tab applies, Esc undoes the typing · invalid text reverts" />
                                <TextBlock
                                    Margin="2,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="s" />
                                <TextBlock
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Text="Fade out" />
                                <c:CommitTextBox
                                    AutomationProperties.Name="Fade out, seconds"
                                    Style="{StaticResource ToolbarSecondsBox}"
                                    Text="{Binding FadeOutText}"
                                    ToolTip="Fade out, seconds (e.g. 0.5) · Enter or Tab applies, Esc undoes the typing · invalid text reverts" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="s" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <Button
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Close editor"
                    Command="{Binding CloseCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarLabelButton}"
                    ToolTip="Close the editor (Esc). Asks first when there are unsaved changes.">
                    <TextBlock Text="Close" />
                </Button>

                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontSize="{StaticResource Dmx.FontSize.Small}"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="Unsaved changes"
                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- A show's own copy: say whose copy this is (text + icon, not colour alone). -->
        <Border
            Padding="8,2"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            BorderThickness="3,0,0,1"
            DockPanel.Dock="Top"
            Visibility="{Binding ShowCopyText, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <c:DmxIcon
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Kind="Timeline"
                    Size="{StaticResource Dmx.SmallIconSize}" />
                <TextBlock Text="{Binding ShowCopyText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- The editor of the function's type. -->
        <ContentControl
            Content="{Binding}"
            Focusable="False"
            IsTabStop="False">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:SceneEditorViewModel}">
                    <TabControl
                        AutomationProperties.Name="Scene editor tabs"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Style="{StaticResource EditorTabControl}">
                        <TabControl.Resources>
                            <DataTemplate DataType="{x:Type vm:SceneGeneralTabViewModel}">
                                <views:SceneGeneralTab />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SceneChannelsTabViewModel}">
                                <views:SceneChannelsTab />
                            </DataTemplate>
                        </TabControl.Resources>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="{Binding IconKind}"
                                        Size="{StaticResource Dmx.DenseIconSize}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:ChaserEditorViewModel}">
                    <edv:ChaserEditorView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:SequenceEditorViewModel}">
                    <edv:SequenceEditorView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:ColorCycleEditorViewModel}">
                    <edv:ColorCycleEditorView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:FadeEditorViewModel}">
                    <edv:FadeEditorView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:PulseEditorViewModel}">
                    <edv:PulseEditorView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:FlashEditorViewModel}">
                    <edv:FlashEditorView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type ed:StrobeEditorViewModel}">
                    <edv:StrobeEditorView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </DockPanel>
</UserControl>
