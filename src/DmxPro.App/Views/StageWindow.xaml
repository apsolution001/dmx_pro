<ui:FluentWindow
    x:Class="DmxPro.App.Views.StageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    Title="Live stage — DMX Pro"
    Width="960"
    Height="600"
    MinWidth="480"
    MinHeight="320"
    d:DataContext="{d:DesignInstance Type=vm:StagePageViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/Logo/dmxpro.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--
        Live stage window: the Stage page's plan in its own top-level window, so the stage stays in view while working
        on Functions, Virtual Console, Shows or Test & Preview (or on a second monitor). One shared instance, opened by
        StageWindowService. No Owner on purpose: an owned window always floats above the main window, which would cover
        the page being worked on. The main window closes it on exit.

        ┌ Live stage — DMX Pro ─────────────────────────────────────── _ □ ✕ ┐
        │ [Place unplaced] [Arrange ▾] [✕] │ [Fit] [Names] │ Stage [12] × [8] m │
        │ ┌──────────── dark stage floor, lights glowing live ─────────────┐   │
        │ └════════════════════════ front edge ════════════════════════════┘   │
        ├ 38 lights · 36 on stage · live   Showing what would be sent — output is disabled ┤
        └──────────────────────────────────────────────────────────────────────┘
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Live stage — DMX Pro"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    AutomationProperties.Name="DMX Pro"
                    Source="{StaticResource Dmx.Logo.Small.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Same view as the Stage page (shared ViewModel), without the lights list: the window is for watching. -->
        <views:StageView Grid.Row="1" ShowLightList="False" />
    </Grid>
</ui:FluentWindow>
