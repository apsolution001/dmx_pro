<UserControl
    x:Class="DmxPro.App.Views.Editors.SequenceEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:conv="clr-namespace:DmxPro.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=ed:SequenceEditorViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <!--
        Sequence editor (DataContext: SequenceEditorViewModel): a chaser of mini-scenes. Three tabs like the scene
        editor. The tab contents stay loaded (only hidden), so the Choose lights dialog and the step list keep working
        and keep their scroll position when switching.

        [Lights] [Steps] [Playback]
        ── Lights ── the lights every step uses (Fixtures panel + Choose lights dialog)
        ── Steps ──
        ┌ [+ Add step] [Add blank] | ⧉ − ↑ ↓      4 steps · Cycle: 4 s ┐║┌ Step 2  [Colours] [All channels]   Lights show (•) This step ( ) Whole sequence ┐
        │ Removed step 3.  [Undo]                                       │║│ Lights [All][None] ║ Colour  ● ● ● ● ● ● ● ● ●  [Off]                       │
        │ #  Colours    Name     Fade in  Hold  Fade out               │║│ ■ PAR 1            ║ Intensity ─────────● [255]                             │
        │ 1  ■■■■       Step 1   0        1     0                      │║│ ■ PAR 2            ║ Red       ─────●──── [200]                             │
        │ 2  ■□■□       Step 2   0        1     0                      │║│                    ║ Green ... Blue ... White ...                           │
        │ Fade in [0] Hold [1] Fade out [0] s [Apply to selected] 2 sel │║│ (All channels: the scene editor's fader banks for this step)            │
        └───────────────────────────────────────────────────────────────┘║└──────────────────────────────────────────────────────────────────────────┘
        ── Playback ── run order (Loop / Play once / Back and forth), direction, same time for all steps, cycle length

        Step list keys: Insert add step (copy), Ctrl+D duplicate, Del remove, Ctrl+Up / Ctrl+Down (or Alt+) move.
    -->
    <UserControl.Resources>
        <conv:EqualsToVisibilityConverter x:Key="IndexToVisibility" />

        <!-- Tab header like the scene editor's tabs (flat, accent underline on the selected tab). -->
        <Style x:Key="SequenceTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Body}" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.TabHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4,4,0,0"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter
                                    Margin="0,0,0,2"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                                <Border
                                    x:Name="Underline"
                                    Height="2"
                                    Margin="-4,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1"
                                    Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header-only tab strip: the pages below are separate panels shown by the selected index. -->
        <Style x:Key="SequenceTabStrip" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SequenceTabItem}" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seconds cell of the step list: a slim box that fits the dense table row. -->
        <Style
            x:Key="SecondsCell"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:CommitTextBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Seconds, e.g. 0.5 · Enter or Tab applies, Esc undoes · invalid text reverts" />
        </Style>

        <!-- Seconds box in a toolbar row / form (timing for selected or all steps). -->
        <Style
            x:Key="SecondsBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:CommitTextBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InlineLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Light-colour swatch (real light colour, display only): framed so black shows on a dark theme. -->
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style
            x:Key="LevelBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:DmxValueBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Margin" Value="6,1,0,1" />
            <Setter Property="Padding" Value="{StaticResource Dmx.TextControlPadding}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Type 0–255 and press Enter · ↑/↓ ±1 · PageUp/PageDown ±10" />
        </Style>

        <Style x:Key="LevelSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>

        <Style x:Key="SmallLabelButton" BasedOn="{StaticResource ToolbarLabelButton}" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style x:Key="PlaybackRadio" BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═════════════ Tabs ═════════════ -->
        <TabControl
            AutomationProperties.Name="Sequence editor tabs"
            DockPanel.Dock="Top"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
            Style="{StaticResource SequenceTabStrip}">
            <TabItem AutomationProperties.Name="Lights" ToolTip="The lights every step uses">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Kind="Fixtures"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                        <TextBlock VerticalAlignment="Center" Text="Lights" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem AutomationProperties.Name="Steps" ToolTip="The steps and their colours">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Kind="Sequence"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                        <TextBlock VerticalAlignment="Center" Text="Steps" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem AutomationProperties.Name="Playback" ToolTip="How the steps play: loop, once or back and forth; timing for all steps">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Kind="Play"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                        <TextBlock VerticalAlignment="Center" Text="Playback" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>

        <Grid>
            <!-- ═════════════════════════ Lights tab ═════════════════════════ -->
            <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
                    <DockPanel>
                        <Button
                            AutomationProperties.Name="Go to the steps"
                            Command="{Binding GoToStepsCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ToolbarLabelButton}"
                            ToolTip="Next: build the steps and set their colours"
                            Visibility="{Binding HasLights, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Next: Steps" />
                                <c:DmxIcon
                                    Margin="4,0,0,0"
                                    Kind="ChevronRight"
                                    Size="{StaticResource Dmx.ButtonIconSize}" />
                            </StackPanel>
                        </Button>
                        <c:DmxIcon
                            Margin="2,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Kind="Info"
                            Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Every step uses these lights. Choose them here, then set each step's colours on the Steps tab."
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <edv:FixtureListPanel DataContext="{Binding Fixtures}" />
            </DockPanel>

            <!-- ═════════════════════════ Steps tab ═════════════════════════ -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <!-- No lights yet: say what to do first. -->
                <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoLights, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Kind="Fixtures"
                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                        Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="Choose lights first" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="A sequence plays its steps on a fixed set of lights. Choose them, then add steps and give each step its colours." />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Choose lights"
                        Command="{Binding Fixtures.ChooseLightsCommand}"
                        Style="{StaticResource ToolbarPrimaryButton}"
                        ToolTip="Pick single lights or whole groups (Ctrl+L on the Lights tab)">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Choose lights…" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Visibility="{Binding HasLights, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="460"
                            MinWidth="340"
                            MaxWidth="900" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ═════════════ Step list ═════════════ -->
                    <Border Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
                                <DockPanel>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Orientation="Horizontal">
                                        <Button
                                            AutomationProperties.Name="Add step"
                                            Command="{Binding AddStepCommand}"
                                            Style="{StaticResource ToolbarLabelButton}"
                                            ToolTip="Add step (Insert): a copy of the selected step, right after it. Change one thing and you have the next step of your pattern.">
                                            <StackPanel Orientation="Horizontal">
                                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Add step" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Add blank step"
                                            Command="{Binding AddBlankStepCommand}"
                                            Style="{StaticResource ToolbarLabelButton}"
                                            ToolTip="Add a blank step after the selected one: every channel at its default (usually dark)">
                                            <StackPanel Orientation="Horizontal">
                                                <c:DmxIcon Kind="New" Size="{StaticResource Dmx.ButtonIconSize}" />
                                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Add blank" />
                                            </StackPanel>
                                        </Button>
                                        <Rectangle Style="{StaticResource ToolbarSeparator}" />
                                        <Button
                                            AutomationProperties.Name="Duplicate selected steps"
                                            Command="{Binding DuplicateStepsCommand}"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Duplicate the selected steps, colours and timing (Ctrl+D)">
                                            <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Remove selected steps"
                                            Command="{Binding RemoveStepsCommand}"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Remove the selected steps (Del). You can undo it right away.">
                                            <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Move selected steps up"
                                            Command="{Binding MoveStepsUpCommand}"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Move the selected steps up: earlier (Ctrl+Up)">
                                            <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Move selected steps down"
                                            Command="{Binding MoveStepsDownCommand}"
                                            Style="{StaticResource ToolbarButton}"
                                            ToolTip="Move the selected steps down: later (Ctrl+Down)">
                                            <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel
                                        Margin="8,0,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        ToolTip="How long one run of all steps takes: each step lasts fade in + hold; its fade out overlaps the next step">
                                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StepCountText}" />
                                        <TextBlock Style="{StaticResource StatusText}" Text=" · " />
                                        <TextBlock
                                            AutomationProperties.Name="Cycle length"
                                            Style="{StaticResource StatusText}"
                                            Text="{Binding CycleText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Undo after removing steps (text + icon + button, not colour alone). -->
                            <Border
                                Padding="6,2"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="3,0,0,1"
                                DockPanel.Dock="Top"
                                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button
                                        AutomationProperties.Name="Undo remove steps"
                                        Command="{Binding UndoRemoveCommand}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SmallLabelButton}"
                                        ToolTip="Put the removed steps back where they were">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="Undo" Size="{StaticResource Dmx.DenseIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Undo" />
                                        </StackPanel>
                                    </Button>
                                    <c:DmxIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Kind="Info"
                                        Size="{StaticResource Dmx.DenseIconSize}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.LiveSetting="Polite"
                                        Text="{Binding UndoText}" />
                                </DockPanel>
                            </Border>

                            <!-- Timing for the selected steps. -->
                            <Border
                                Padding="{StaticResource Dmx.ToolbarStripPadding}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                DockPanel.Dock="Bottom">
                                <WrapPanel VerticalAlignment="Center">
                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource InlineLabel}" Text="Fade in" />
                                        <c:CommitTextBox
                                            AutomationProperties.Name="Fade in for the selected steps, seconds"
                                            Style="{StaticResource SecondsBox}"
                                            Text="{Binding TimingFadeInText}"
                                            ToolTip="How long a step takes to appear, seconds · then click Apply to selected" />
                                        <TextBlock Style="{StaticResource UnitLabel}" Text="s" />
                                    </StackPanel>
                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource InlineLabel}" Text="Hold" />
                                        <c:CommitTextBox
                                            AutomationProperties.Name="Hold for the selected steps, seconds"
                                            Style="{StaticResource SecondsBox}"
                                            Text="{Binding TimingHoldText}"
                                            ToolTip="How long a step stays, seconds · then click Apply to selected" />
                                        <TextBlock Style="{StaticResource UnitLabel}" Text="s" />
                                    </StackPanel>
                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource InlineLabel}" Text="Fade out" />
                                        <c:CommitTextBox
                                            AutomationProperties.Name="Fade out for the selected steps, seconds"
                                            Style="{StaticResource SecondsBox}"
                                            Text="{Binding TimingFadeOutText}"
                                            ToolTip="How long a step takes to disappear (overlaps the next step), seconds · then click Apply to selected" />
                                        <TextBlock Style="{StaticResource UnitLabel}" Text="s" />
                                    </StackPanel>
                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                        <Button
                                            AutomationProperties.Name="Apply timing to the selected steps"
                                            Command="{Binding ApplyTimingToSelectedCommand}"
                                            Style="{StaticResource ToolbarLabelButton}"
                                            ToolTip="Give every selected step these times (select several with Ctrl or Shift). Same time for all steps: Playback tab.">
                                            <StackPanel Orientation="Horizontal">
                                                <c:DmxIcon Kind="Check" Size="{StaticResource Dmx.ButtonIconSize}" />
                                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Apply to selected" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Style="{StaticResource StatusText}"
                                            Text="{Binding SelectedStepsText}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <Grid>
                                <DataGrid
                                    x:Name="StepsGrid"
                                    AutomationProperties.Name="Sequence steps"
                                    ItemsSource="{Binding Steps}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    SelectedItem="{Binding SelectedStep}"
                                    SelectionMode="Extended"
                                    Style="{StaticResource DataTable}">
                                    <DataGrid.InputBindings>
                                        <KeyBinding Command="{Binding AddStepCommand}" Gesture="Insert" />
                                        <KeyBinding Command="{Binding RemoveStepsCommand}" Gesture="Delete" />
                                        <KeyBinding Command="{Binding DuplicateStepsCommand}" Gesture="Ctrl+D" />
                                        <KeyBinding Command="{Binding MoveStepsUpCommand}" Gesture="Ctrl+Up" />
                                        <KeyBinding Command="{Binding MoveStepsDownCommand}" Gesture="Ctrl+Down" />
                                        <KeyBinding Command="{Binding MoveStepsUpCommand}" Gesture="Alt+Up" />
                                        <KeyBinding Command="{Binding MoveStepsDownCommand}" Gesture="Alt+Down" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.RowStyle>
                                        <Style BasedOn="{StaticResource DataTableRow}" TargetType="DataGridRow">
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                            <EventSetter Event="GotKeyboardFocus" Handler="OnRowGotKeyboardFocus" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="28"
                                            Binding="{Binding Number}"
                                            Header="#"
                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn Width="Auto" MinWidth="64">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Colours" ToolTip="The colour of each light in this step (on screen only)" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                        <ItemsControl
                                                            Focusable="False"
                                                            IsTabStop="False"
                                                            ItemsSource="{Binding Swatches}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type ed:SequenceSwatch}">
                                                                    <Border
                                                                        Width="10"
                                                                        Height="14"
                                                                        Margin="0,0,1,0"
                                                                        Background="{Binding Hex}"
                                                                        Style="{StaticResource Swatch}"
                                                                        ToolTip="{Binding ToolTip}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock
                                                            Margin="2,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding MoreSwatchesText}"
                                                            ToolTip="More lights in this step (see the Colours view)" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*" MinWidth="72">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Name" ToolTip="Optional step name" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                                    <c:CommitTextBox
                                                        MinHeight="0"
                                                        Padding="4,1"
                                                        VerticalAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        AutomationProperties.Name="Step name"
                                                        Text="{Binding Name}"
                                                        ToolTip="Optional step name; leave empty for &quot;Step N&quot;" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="56">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Fade in" ToolTip="Seconds the step takes to appear" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                                    <c:CommitTextBox
                                                        AutomationProperties.Name="Fade in, seconds"
                                                        Style="{StaticResource SecondsCell}"
                                                        Text="{Binding FadeInText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="56">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Hold" ToolTip="Seconds the step stays" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                                    <c:CommitTextBox
                                                        AutomationProperties.Name="Hold, seconds"
                                                        Style="{StaticResource SecondsCell}"
                                                        Text="{Binding HoldText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="60">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Fade out" ToolTip="Seconds the step takes to disappear; overlaps the next step" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                                    <c:CommitTextBox
                                                        AutomationProperties.Name="Fade out, seconds"
                                                        Style="{StaticResource SecondsCell}"
                                                        Text="{Binding FadeOutText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding ShowNoStepsHint, Converter={StaticResource BoolToVisibility}}">
                                    <c:DmxIcon
                                        Kind="Sequence"
                                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                                        Style="{StaticResource EmptyStateIcon}" />
                                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No steps yet" />
                                    <TextBlock Style="{StaticResource EmptyStateText}" Text="Add a step, then set its colours on the right. Each new step starts as a copy of the one before." />
                                    <Button
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="Add the first step"
                                        Command="{Binding AddStepCommand}"
                                        Style="{StaticResource ToolbarPrimaryButton}"
                                        ToolTip="Add the first step (Insert)">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Add step" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter
                        Grid.Column="1"
                        AutomationProperties.Name="Resize steps and step values"
                        Style="{StaticResource VerticalSplitter}" />

                    <!-- ═════════════ Values of the selected step ═════════════ -->
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                <DockPanel>
                                    <!-- What the lights show while editing (live edit preview). -->
                                    <StackPanel
                                        Margin="8,0,4,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        ToolTip="What the lights show while this editor is open (only while DMX output is on and not in live mode)">
                                        <TextBlock Style="{StaticResource InlineLabel}" Text="Lights show" />
                                        <RadioButton
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Lights show the selected step"
                                            Content="This step"
                                            GroupName="SequencePreview"
                                            IsChecked="{Binding PreviewSelectedStep}"
                                            ToolTip="The lights show the selected step and stay on it while you edit" />
                                        <RadioButton
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Lights play the whole sequence"
                                            Content="Whole sequence"
                                            GroupName="SequencePreview"
                                            IsChecked="{Binding PreviewWholeSequence}"
                                            ToolTip="The lights play all steps with their timing, as the sequence will run" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            MaxWidth="200"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PanelTitle}"
                                            Text="{Binding SelectedStepTitle}"
                                            ToolTip="{Binding SelectedStepTitle}" />
                                        <TabControl
                                            AutomationProperties.Name="Step value views"
                                            BorderThickness="0"
                                            IsEnabled="{Binding HasSelectedStepValues}"
                                            Padding="0"
                                            SelectedIndex="{Binding ValuesViewIndex, Mode=TwoWay}"
                                            Style="{StaticResource SequenceTabStrip}">
                                            <TabItem AutomationProperties.Name="Colours" ToolTip="Simple: colour and intensity of the selected lights">
                                                <TabItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:DmxIcon
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            Kind="Color"
                                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                                        <TextBlock VerticalAlignment="Center" Text="Colours" />
                                                    </StackPanel>
                                                </TabItem.Header>
                                            </TabItem>
                                            <TabItem AutomationProperties.Name="All channels" ToolTip="Advanced: every channel of every light, 0–255 (strobe, macros, …)">
                                                <TabItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:DmxIcon
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            Kind="Channel"
                                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                                        <TextBlock VerticalAlignment="Center" Text="All channels" />
                                                    </StackPanel>
                                                </TabItem.Header>
                                            </TabItem>
                                        </TabControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid>
                                <Grid Visibility="{Binding HasSelectedStepValues, Converter={StaticResource BoolToVisibility}}">
                                    <!-- ═════ Colours (simple) ═════ -->
                                    <Grid Visibility="{Binding ValuesViewIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="200"
                                                MinWidth="150"
                                                MaxWidth="420" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="220" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lights of the step: pick which ones the colour goes to. -->
                                        <DockPanel>
                                            <DockPanel Margin="4,2" DockPanel.Dock="Top">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource StatusText}"
                                                    Text="{Binding SelectedLightsText}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,2,0"
                                                        AutomationProperties.Name="Select all lights"
                                                        Command="{Binding SelectAllLightsCommand}"
                                                        Style="{StaticResource SmallLabelButton}"
                                                        ToolTip="Select every light: the colour goes to all of them (Ctrl+A)">
                                                        <StackPanel Orientation="Horizontal">
                                                            <c:DmxIcon Kind="SelectAll" Size="{StaticResource Dmx.DenseIconSize}" />
                                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="All" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        AutomationProperties.Name="Select no lights"
                                                        Command="{Binding SelectNoLightsCommand}"
                                                        Style="{StaticResource SmallLabelButton}"
                                                        ToolTip="Clear the light selection (Esc)">
                                                        <StackPanel Orientation="Horizontal">
                                                            <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.DenseIconSize}" />
                                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="None" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>
                                            <ListBox
                                                AutomationProperties.Name="Lights in this step"
                                                BorderThickness="0"
                                                ItemsSource="{Binding Lights}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                SelectionMode="Extended"
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.ScrollUnit="Pixel"
                                                VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.InputBindings>
                                                    <KeyBinding
                                                        Command="{Binding SelectAllLightsCommand}"
                                                        Key="A"
                                                        Modifiers="Control" />
                                                    <KeyBinding Command="{Binding SelectNoLightsCommand}" Key="Escape" />
                                                </ListBox.InputBindings>
                                                <ListBox.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                        <Setter Property="Padding" Value="6,1" />
                                                        <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type ed:SequenceLightRowViewModel}">
                                                        <DockPanel ToolTip="{Binding Detail}">
                                                            <Border
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding SwatchHex}"
                                                                DockPanel.Dock="Left"
                                                                Style="{StaticResource Swatch}"
                                                                ToolTip="{Binding SwatchToolTip}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap">
                                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                                <Run
                                                                    FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding Detail, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>

                                        <GridSplitter
                                            Grid.Column="1"
                                            AutomationProperties.Name="Resize lights and colours"
                                            Style="{StaticResource VerticalSplitter}" />

                                        <!-- Colour presets and level sliders for the selected lights. -->
                                        <ScrollViewer
                                            Grid.Column="2"
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="8,2,8,8">
                                                <TextBlock Style="{StaticResource FormSection}" Text="Colour" />
                                                <WrapPanel>
                                                    <ItemsControl
                                                        AutomationProperties.Name="Colour presets"
                                                        IsTabStop="False"
                                                        ItemsSource="{Binding Presets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:SceneEditorColorPreset}">
                                                                <Button
                                                                    Width="{StaticResource Dmx.ToolbarButtonSize}"
                                                                    Height="{StaticResource Dmx.ToolbarButtonSize}"
                                                                    Margin="0,0,2,2"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Colour {0} for the selected lights}"
                                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ToolbarButton}"
                                                                    ToolTip="{Binding Name, StringFormat={}{0}: set the selected lights to this colour (intensity goes to full if it was off)}">
                                                                    <Ellipse
                                                                        Width="16"
                                                                        Height="16"
                                                                        Fill="{Binding Swatch}"
                                                                        Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button
                                                        Margin="4,0,0,2"
                                                        VerticalAlignment="Top"
                                                        AutomationProperties.Name="Turn the selected lights off in this step"
                                                        Command="{Binding LightsOffCommand}"
                                                        Style="{StaticResource ToolbarLabelButton}"
                                                        ToolTip="Off: the selected lights are dark in this step (colours and intensity at 0)">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse
                                                                Width="14"
                                                                Height="14"
                                                                Fill="#000000"
                                                                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Off" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>

                                                <TextBlock
                                                    Style="{StaticResource FormSection}"
                                                    Text="Levels"
                                                    Visibility="{Binding HasLevels, Converter={StaticResource BoolToVisibility}}" />
                                                <ItemsControl
                                                    AutomationProperties.Name="Intensity and colour levels"
                                                    IsTabStop="False"
                                                    ItemsSource="{Binding Levels}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type ed:SequenceLevelRowViewModel}">
                                                            <Grid Margin="0,0,0,2" ToolTip="{Binding ToolTip}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18" />
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding DotHex}"
                                                                    Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                    Visibility="{Binding DotHex, Converter={StaticResource NullToVisibility}}" />
                                                                <c:DmxIcon
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                    Kind="Dimmer"
                                                                    Size="{StaticResource Dmx.DenseIconSize}"
                                                                    Visibility="{Binding IsIntensity, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding Label}" />
                                                                <Slider
                                                                    Grid.Column="2"
                                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                                    Style="{StaticResource LevelSlider}"
                                                                    Value="{Binding Value}" />
                                                                <c:DmxValueBox
                                                                    Grid.Column="3"
                                                                    AutomationProperties.Name="{Binding Label, StringFormat={}{0} value}"
                                                                    Style="{StaticResource LevelBox}"
                                                                    Value="{Binding Value}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock
                                                    Margin="0,8,0,0"
                                                    Style="{StaticResource HintText}"
                                                    Text="Select lights on the left (Ctrl or Shift for several, or All), then pick a colour."
                                                    Visibility="{Binding HasNoSelectedLights, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    Margin="0,8,0,0"
                                                    Style="{StaticResource HintText}"
                                                    Text="Strobe, colour macros or other channels: use All channels above." />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- ═════ All channels (the scene editor's Channels view, reused) ═════ -->
                                    <views:SceneChannelsTab DataContext="{Binding Channels}" Visibility="{Binding DataContext.ValuesViewIndex, ElementName=Root, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
                                </Grid>

                                <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoSelectedStep, Converter={StaticResource BoolToVisibility}}">
                                    <c:DmxIcon
                                        Kind="Color"
                                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                                        Style="{StaticResource EmptyStateIcon}" />
                                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No step selected" />
                                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding NoStepHint}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═════════════════════════ Playback tab ═════════════════════════ -->
            <ScrollViewer
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                <StackPanel
                    MaxWidth="620"
                    Margin="10,4,10,10"
                    HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource FormSection}" Text="After the last step" />
                    <RadioButton
                        AutomationProperties.Name="Loop"
                        GroupName="SequenceRunOrder"
                        IsChecked="{Binding IsLoop}"
                        Style="{StaticResource PlaybackRadio}"
                        ToolTip="Runs until it is stopped">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="Loop" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="– start again at the first step" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        AutomationProperties.Name="Play once"
                        GroupName="SequenceRunOrder"
                        IsChecked="{Binding IsPlayOnce}"
                        Style="{StaticResource PlaybackRadio}"
                        ToolTip="Plays every step once, then stops">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="Play once" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="– stop" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        AutomationProperties.Name="Back and forth"
                        GroupName="SequenceRunOrder"
                        IsChecked="{Binding IsBackAndForth}"
                        Style="{StaticResource PlaybackRadio}"
                        ToolTip="First to last, then back to the first, and again; runs until it is stopped">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="Back and forth" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="– play back to the first step, then forward again" />
                        </TextBlock>
                    </RadioButton>

                    <TextBlock Style="{StaticResource FormSection}" Text="Direction" />
                    <RadioButton
                        AutomationProperties.Name="Forward"
                        GroupName="SequenceDirection"
                        IsChecked="{Binding IsForward}"
                        Style="{StaticResource PlaybackRadio}"
                        ToolTip="Starts at step 1">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="Forward" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="– first step to last" />
                        </TextBlock>
                    </RadioButton>
                    <RadioButton
                        AutomationProperties.Name="Backward"
                        GroupName="SequenceDirection"
                        IsChecked="{Binding IsBackward}"
                        Style="{StaticResource PlaybackRadio}"
                        ToolTip="Starts at the last step">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="Backward" />
                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="– last step to first" />
                        </TextBlock>
                    </RadioButton>

                    <TextBlock Style="{StaticResource FormSection}" Text="Same time for all steps" />
                    <WrapPanel>
                        <StackPanel Margin="0,1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource InlineLabel}" Text="Fade in" />
                            <c:CommitTextBox
                                AutomationProperties.Name="Fade in for all steps, seconds"
                                Style="{StaticResource SecondsBox}"
                                Text="{Binding TimingFadeInText}"
                                ToolTip="How long each step takes to appear, seconds" />
                            <TextBlock Style="{StaticResource UnitLabel}" Text="s" />
                        </StackPanel>
                        <StackPanel Margin="0,1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource InlineLabel}" Text="Hold" />
                            <c:CommitTextBox
                                AutomationProperties.Name="Hold for all steps, seconds"
                                Style="{StaticResource SecondsBox}"
                                Text="{Binding TimingHoldText}"
                                ToolTip="How long each step stays, seconds" />
                            <TextBlock Style="{StaticResource UnitLabel}" Text="s" />
                        </StackPanel>
                        <StackPanel Margin="0,1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource InlineLabel}" Text="Fade out" />
                            <c:CommitTextBox
                                AutomationProperties.Name="Fade out for all steps, seconds"
                                Style="{StaticResource SecondsBox}"
                                Text="{Binding TimingFadeOutText}"
                                ToolTip="How long each step takes to disappear (overlaps the next step), seconds" />
                            <TextBlock Style="{StaticResource UnitLabel}" Text="s" />
                        </StackPanel>
                        <Button
                            Margin="0,1"
                            AutomationProperties.Name="Apply this timing to all steps"
                            Command="{Binding ApplyTimingToAllCommand}"
                            Style="{StaticResource ToolbarLabelButton}"
                            ToolTip="Give every step these times">
                            <StackPanel Orientation="Horizontal">
                                <c:DmxIcon Kind="Check" Size="{StaticResource Dmx.ButtonIconSize}" />
                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Apply to all steps" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource HintText}"
                        Text="Fade in: how long a step takes to appear. Hold: how long it stays. Fade out: how long it takes to disappear; it overlaps the next step. Different times per step: Steps tab." />

                    <TextBlock Style="{StaticResource FormSection}" Text="Length" />
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Kind="Recent"
                            Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Cycle length"
                            Text="{Binding CycleText}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource StatusText}"
                            Text="{Binding StepCountText}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
