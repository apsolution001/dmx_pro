<UserControl
    x:Class="DmxPro.App.Views.Editors.SequenceEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    d:DataContext="{d:DesignInstance Type=ed:SequenceEditorViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <!--
        Sequence editor (DataContext: SequenceEditorViewModel). Left: the fixtures (top) and the step grid (bottom);
        right: the selected step's values in the SAME fader banks as the scene editor's Channels tab (every channel of
        every fixture, 0-255, from the profile). Step grid keys: Del remove, Ctrl+D duplicate, Alt+Up / Alt+Down move.

        ┌ Fixtures [Add▾][-][↑][↓] ┐║┌ Values of step 2 · Step 2 ────────────────────────────┐
        │ 1 PAR 1                  │║│ (lights list) ║ (fader banks, Set on selected lights) │
        ├──────────────────────────┤║│                                                       │
        │ Steps [+][⧉][-][↑][↓]    │║│                                                       │
        │ [Loop ▾] [Forward ▾]     │║│                                                       │
        │ # Name  In  Hold  Out    │║│                                                       │
        └──────────────────────────┘║└───────────────────────────────────────────────────────┘
    -->
    <UserControl.Resources>
        <!-- Seconds cell of the step grid: a slim box that fits the dense table row. -->
        <Style
            x:Key="SecondsCell"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:CommitTextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Seconds, e.g. 0.5 · Enter or Tab applies, Esc undoes · invalid text reverts" />
        </Style>

        <!-- Combo in the one-line run strip: no form bottom margin. -->
        <Style
            x:Key="StripComboBox"
            BasedOn="{StaticResource FormComboBox}"
            TargetType="ComboBox">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="380"
                MinWidth="280"
                MaxWidth="720" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35*" MinHeight="96" />
                <RowDefinition Height="4" />
                <RowDefinition Height="65*" MinHeight="140" />
            </Grid.RowDefinitions>

            <edv:FixtureListPanel DataContext="{Binding Fixtures}" />

            <GridSplitter
                Grid.Row="1"
                AutomationProperties.Name="Resize fixtures and steps"
                Style="{StaticResource HorizontalSplitter}" />

            <!-- ═════════════ Steps ═════════════ -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button
                                    AutomationProperties.Name="Add step"
                                    Command="{Binding AddStepCommand}"
                                    Style="{StaticResource PanelHeaderButton}"
                                    ToolTip="Add a step at the end (every channel at its profile default)">
                                    <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Duplicate step"
                                    Command="{Binding DuplicateStepCommand}"
                                    Style="{StaticResource PanelHeaderButton}"
                                    ToolTip="Duplicate the selected step, values and timing (Ctrl+D)">
                                    <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.DenseIconSize}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Remove step"
                                    Command="{Binding RemoveStepCommand}"
                                    Style="{StaticResource PanelHeaderButton}"
                                    ToolTip="Remove the selected step (Del)">
                                    <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.DenseIconSize}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Move step up"
                                    Command="{Binding MoveStepUpCommand}"
                                    Style="{StaticResource PanelHeaderButton}"
                                    ToolTip="Move the selected step up (Alt+Up)">
                                    <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.DenseIconSize}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Move step down"
                                    Command="{Binding MoveStepDownCommand}"
                                    Style="{StaticResource PanelHeaderButton}"
                                    ToolTip="Move the selected step down (Alt+Down)">
                                    <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.DenseIconSize}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Steps" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StatusText}"
                                    Text="{Binding StepCountText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- One line: run order, direction, cycle time (labels live in tooltips / automation names). -->
                    <Border
                        Padding="4,2"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <WrapPanel>
                            <ComboBox
                                AutomationProperties.Name="Run order"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding RunOrders}"
                                SelectedValue="{Binding RunOrder}"
                                SelectedValuePath="Value"
                                Style="{StaticResource StripComboBox}"
                                ToolTip="Run order: loop, play once, or ping-pong (first to last and back)" />
                            <ComboBox
                                AutomationProperties.Name="Direction"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding Directions}"
                                SelectedValue="{Binding Direction}"
                                SelectedValuePath="Value"
                                Style="{StaticResource StripComboBox}"
                                ToolTip="Direction: start at the first or the last step" />
                            <StackPanel
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                ToolTip="Each step lasts fade in + hold; its fade out overlaps the next step">
                                <c:DmxIcon
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Kind="Recent"
                                    Size="{StaticResource Dmx.DenseIconSize}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Cycle time"
                                    Style="{StaticResource StatusText}"
                                    Text="{Binding CycleText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <DataGrid
                            AutomationProperties.Name="Sequence steps"
                            ItemsSource="{Binding Steps}"
                            KeyboardNavigation.TabNavigation="Continue"
                            SelectedItem="{Binding SelectedStep}"
                            SelectionMode="Single"
                            Style="{StaticResource DataTable}">
                            <DataGrid.InputBindings>
                                <KeyBinding Command="{Binding RemoveStepCommand}" Gesture="Delete" />
                                <KeyBinding Command="{Binding DuplicateStepCommand}" Gesture="Ctrl+D" />
                                <KeyBinding Command="{Binding MoveStepUpCommand}" Gesture="Alt+Up" />
                                <KeyBinding Command="{Binding MoveStepDownCommand}" Gesture="Alt+Down" />
                            </DataGrid.InputBindings>
                            <DataGrid.RowStyle>
                                <Style BasedOn="{StaticResource DataTableRow}" TargetType="DataGridRow">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <EventSetter Event="GotKeyboardFocus" Handler="OnRowGotKeyboardFocus" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="32"
                                    Binding="{Binding Number}"
                                    Header="#"
                                    IsReadOnly="True" />
                                <DataGridTemplateColumn
                                    Width="*"
                                    MinWidth="80"
                                    Header="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                            <c:CommitTextBox
                                                MinHeight="0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.Name="Step name"
                                                Text="{Binding Name}"
                                                ToolTip="Optional step name; leave empty for &quot;Step N&quot;" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="64" Header="In (s)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                            <c:CommitTextBox
                                                AutomationProperties.Name="Fade in, seconds"
                                                Style="{StaticResource SecondsCell}"
                                                Text="{Binding FadeInText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="64" Header="Hold (s)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                            <c:CommitTextBox
                                                AutomationProperties.Name="Hold, seconds"
                                                Style="{StaticResource SecondsCell}"
                                                Text="{Binding HoldText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="64" Header="Out (s)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ed:SequenceStepRowViewModel}">
                                            <c:CommitTextBox
                                                AutomationProperties.Name="Fade out, seconds"
                                                Style="{StaticResource SecondsCell}"
                                                Text="{Binding FadeOutText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoSteps, Converter={StaticResource BoolToVisibility}}">
                            <c:DmxIcon
                                Kind="Sequence"
                                Size="{StaticResource Dmx.EmptyStateIconSize}"
                                Style="{StaticResource EmptyStateIcon}" />
                            <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No steps" />
                            <TextBlock Style="{StaticResource EmptyStateText}" Text="Click + to add a step (a small scene with its own timing)." />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter
            Grid.Column="1"
            AutomationProperties.Name="Resize steps and values"
            Style="{StaticResource VerticalSplitter}" />

        <!-- ═════════════ Values of the selected step ═════════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <TextBlock
                        Style="{StaticResource PanelTitle}"
                        Text="{Binding SelectedStepTitle}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
                <Grid>
                    <views:SceneChannelsTab DataContext="{Binding Channels}" Visibility="{Binding DataContext.HasSelectedStepValues, RelativeSource={RelativeSource AncestorType=edv:SequenceEditorView}, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoSelectedStep, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            Kind="Channel"
                            Size="{StaticResource Dmx.EmptyStateIconSize}"
                            Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No step selected" />
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding NoStepHint}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
