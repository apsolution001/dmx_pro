<UserControl
    x:Class="DmxPro.App.Views.Editors.ColorEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=ed:ColorEditorViewModel}"
    d:DesignHeight="140"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <!--
        An effect colour (DataContext: ColorEditorViewModel), dense: the scene editor's colour presets with the
        swatch and #RRGGBB box on the same line, then one compact R / G / B slider row each with a 0-255 box. The engine
        sends the colour through each fixture's profile (white / amber / UV handled there).

        ■■■■■■■■■              [██] [#FF5000]
        ● R ───────●─── [255]
        ● G ──●──────── [ 80]
        ● B ●────────── [  0]
    -->
    <UserControl.Resources>
        <Style
            x:Key="LevelBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:DmxValueBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="{StaticResource Dmx.TextControlPadding}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Type 0–255 and press Enter · ↑/↓ ±1 · PageUp/PageDown ±10" />
        </Style>
        <Style x:Key="LevelSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style x:Key="ChannelLetter" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ChannelDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <!-- Swatch and hex box on the preset line. -->
            <StackPanel
                Margin="8,0,0,0"
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Border
                    Width="{StaticResource Dmx.ControlHeight}"
                    Height="{StaticResource Dmx.ControlHeight}"
                    Background="{Binding SwatchHex}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Dmx.CornerRadius}"
                    ToolTip="The colour (on screen only)" />
                <c:CommitTextBox
                    Width="76"
                    MinHeight="{StaticResource Dmx.ControlHeight}"
                    Height="{StaticResource Dmx.ControlHeight}"
                    Margin="4,0,0,0"
                    Padding="{StaticResource Dmx.TextControlPadding}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Colour as hex"
                    MaxLength="7"
                    Text="{Binding Hex}"
                    ToolTip="Colour as #RRGGBB; press Enter to apply" />
            </StackPanel>

            <ItemsControl
                AutomationProperties.Name="Colour presets"
                IsTabStop="False"
                ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SceneEditorColorPreset}">
                        <Button
                            Width="{StaticResource Dmx.ListRowMinHeight}"
                            Height="{StaticResource Dmx.ListRowMinHeight}"
                            Margin="0,0,2,2"
                            AutomationProperties.Name="{Binding Name, StringFormat=Colour preset {0}}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="{Binding ToolTip}">
                            <Ellipse
                                Width="{StaticResource Dmx.DenseIconSize}"
                                Height="{StaticResource Dmx.DenseIconSize}"
                                Fill="{Binding Swatch}"
                                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Real light colours: hex allowed for the R/G/B markers. -->
            <Ellipse Fill="#FF0000" Style="{StaticResource ChannelDot}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource ChannelLetter}"
                Text="R" />
            <Slider
                Grid.Column="2"
                AutomationProperties.Name="Red, 0 to 255"
                Style="{StaticResource LevelSlider}"
                Value="{Binding Red}" />
            <c:DmxValueBox
                Grid.Column="3"
                Margin="4,1,0,1"
                AutomationProperties.Name="Red value"
                Style="{StaticResource LevelBox}"
                Value="{Binding Red}" />

            <Ellipse
                Grid.Row="1"
                Fill="#00FF00"
                Style="{StaticResource ChannelDot}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource ChannelLetter}"
                Text="G" />
            <Slider
                Grid.Row="1"
                Grid.Column="2"
                AutomationProperties.Name="Green, 0 to 255"
                Style="{StaticResource LevelSlider}"
                Value="{Binding Green}" />
            <c:DmxValueBox
                Grid.Row="1"
                Grid.Column="3"
                Margin="4,1,0,1"
                AutomationProperties.Name="Green value"
                Style="{StaticResource LevelBox}"
                Value="{Binding Green}" />

            <Ellipse
                Grid.Row="2"
                Fill="#0000FF"
                Style="{StaticResource ChannelDot}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Style="{StaticResource ChannelLetter}"
                Text="B" />
            <Slider
                Grid.Row="2"
                Grid.Column="2"
                AutomationProperties.Name="Blue, 0 to 255"
                Style="{StaticResource LevelSlider}"
                Value="{Binding Blue}" />
            <c:DmxValueBox
                Grid.Row="2"
                Grid.Column="3"
                Margin="4,1,0,1"
                AutomationProperties.Name="Blue value"
                Style="{StaticResource LevelBox}"
                Value="{Binding Blue}" />
        </Grid>
    </StackPanel>
</UserControl>
