<UserControl
    x:Class="DmxPro.App.Views.Editors.FadeEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=ed:FadeEditorViewModel}"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <!--
        Fade editor (DataContext: FadeEditorViewModel). A one-line explanation strip; two square docked panels side by
        side, each the chosen scene (big swatch, name, its lights as colour dots) over a searchable scene list; a Swap
        button between them; then a panel with the duration and its quick presets (a radio group), an on-screen colour
        strip, one plain sentence and inline notes.

        ▌ Moves the lights smoothly from one scene to another.
        ┌ From  where the lights start ──┐   >    ┌ To  where the lights end up ───┐
        │ [██] Warm red                  │ [Swap] │ [██] Deep blue                 │
        │      4 lights  ● ● ● ●         │        │      4 lights  ● ● ● ●         │
        │ [⌕ Find scene             ]    │        │ [⌕ Find scene             ]    │
        │  ◌ Current look   lights now   │        │  ■ Deep blue        4 lights   │
        │  ■ Warm red       4 lights  ◀  │        │  ■ Green            2 lights   │
        └────────────────────────────────┘        └────────────────────────────────┘
        ┌──────────────────────────────────────────────────────────────────────────┐
        │ Duration [3.00] s   (1 s)(●3 s)(5 s)(10 s)                               │
        │ [████████████████ red → blue ████████████████]                           │
        │ Warm red                3 s              Deep blue                       │
        │ The lights start on "Warm red" and move smoothly to "Deep blue" over 3 s …│
        │ (i) 1 light is only in To (PAR 5): it fades in from what it shows now.   │
        └──────────────────────────────────────────────────────────────────────────┘

        No scenes in the project: an empty state (icon, title, sentence, New scene button on the Functions page)
        replaces everything.
        Keyboard: Tab From search → From list → Swap → To search → To list → duration → presets (one tab stop; arrow
        keys move between presets, Space picks); Down in a search box moves into its list.
    -->
    <UserControl.Resources>
        <!-- Search box in a panel: the form text box without its bottom margin, room on the left for the icon. -->
        <Style
            x:Key="FadeSearchBox"
            BasedOn="{StaticResource FormTextBox}"
            TargetType="ui:TextBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="26,4,8,0" />
        </Style>

        <!--
            Quick duration button: a segmented pick-one radio button (same look as EffectChoiceButton in
            EffectEditorStyles.xaml): outlined, accent fill + semibold when checked (not colour alone). Being a radio
            button, screen readers announce which preset is active.
        -->
        <Style
            x:Key="FadeChoiceButton"
            BasedOn="{StaticResource ToolbarToggleButton}"
            TargetType="RadioButton">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One-line "what this does" strip at the top (same look as EffectExplanation in EffectEditorStyles.xaml). -->
        <Style x:Key="FadeExplanation" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!-- One light of the chosen scene: a small colour dot (name in the tooltip). -->
        <DataTemplate x:Key="FadeLightDot" DataType="{x:Type vm:PreviewLight}">
            <Ellipse
                Width="12"
                Height="12"
                Margin="0,0,3,3"
                AutomationProperties.Name="{Binding ToolTip}"
                Fill="{Binding Color}"
                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                StrokeThickness="1"
                ToolTip="{Binding ToolTip}" />
        </DataTemplate>

        <!-- One row of a scene list: swatch (or icon), name, detail on the right. -->
        <DataTemplate x:Key="FadeSceneRow" DataType="{x:Type ed:FadeSceneOption}">
            <DockPanel ToolTip="{Binding AutomationName}">
                <Grid
                    Width="14"
                    Height="14"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left">
                    <Border
                        x:Name="Swatch"
                        Background="{Binding Swatch}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="2" />
                    <c:DmxIcon
                        x:Name="Icon"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Kind="Live"
                        Size="{StaticResource Dmx.DenseIconSize}"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontSize="{StaticResource Dmx.FontSize.Small}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Detail}" />
                <TextBlock
                    x:Name="Name"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrentLook}" Value="True">
                    <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Name" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Kind" Value="Warning" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One side (From or To): header, the chosen scene, search, scene list. -->
        <DataTemplate x:Key="FadeSidePanel" DataType="{x:Type ed:FadeSideViewModel}">
            <Border x:Name="Frame" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run
                                FontSize="{StaticResource Dmx.FontSize.Body}"
                                FontWeight="SemiBold"
                                Text="{Binding Title, Mode=OneWay}" />
                            <Run
                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding Subtitle, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <!-- The chosen scene: big swatch (or icon), name, meaning, its lights as dots. -->
                    <Grid Margin="6,6,6,4" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top">
                            <Border
                                x:Name="BigSwatch"
                                Background="{Binding DisplaySwatch}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Dmx.CornerRadius}" />
                            <c:DmxIcon
                                x:Name="BigIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Kind="Live"
                                Size="{StaticResource Dmx.ButtonIconSize}"
                                Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                x:Name="BigName"
                                AutomationProperties.Name="{Binding DisplayName}"
                                FontSize="{StaticResource Dmx.FontSize.Title}"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayName}" />
                            <TextBlock
                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DisplayDetail}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayDetail}" />
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasLights, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Margin="4,0,0,3"
                                    VerticalAlignment="Bottom"
                                    DockPanel.Dock="Right"
                                    FontSize="{StaticResource Dmx.FontSize.Caption}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding MoreLightsText}"
                                    Visibility="{Binding MoreLightsText, Converter={StaticResource NullToVisibility}}" />
                                <ItemsControl
                                    MaxHeight="30"
                                    AutomationProperties.Name="Lights of this scene and their colours"
                                    ClipToBounds="True"
                                    Focusable="False"
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource FadeLightDot}"
                                    ItemsSource="{Binding Lights}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Search -->
                    <Grid Margin="6,0,6,4" DockPanel.Dock="Top">
                        <ui:TextBox
                            AutomationProperties.Name="{Binding SearchAutomationName}"
                            PlaceholderText="Find scene"
                            PreviewKeyDown="OnSearchPreviewKeyDown"
                            Style="{StaticResource FadeSearchBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Type part of a scene name · Down arrow moves into the list" />
                        <c:DmxIcon
                            Margin="7,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            IsHitTestVisible="False"
                            Kind="Search"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                    </Grid>

                    <!-- Scene list: clicking (or arrow keys) picks the scene. -->
                    <Grid>
                        <ListBox
                            MinHeight="66"
                            Margin="2,0,2,2"
                            AutomationProperties.Name="{Binding ListAutomationName}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemTemplate="{StaticResource FadeSceneRow}"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding SelectedOption}"
                            SelectionMode="Single">
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock
                            Margin="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintText}"
                            Text="{Binding NoMatchText}"
                            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrentLook}" Value="True">
                    <Setter TargetName="BigSwatch" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                    <Setter TargetName="BigIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter TargetName="BigIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BigIcon" Property="Kind" Value="Warning" />
                    <Setter TargetName="BigIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="BigSwatch" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="BigName" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ═════════════ Empty state: no scenes in the project ═════════════ -->
        <Border Style="{StaticResource PanelBorder}" Visibility="{Binding HasNoScenes, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Style="{StaticResource EmptyStatePanel}">
                <c:DmxIcon
                    Kind="Fade"
                    Size="{StaticResource Dmx.EmptyStateIconSize}"
                    Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No scenes to fade between" />
                <TextBlock Style="{StaticResource EmptyStateText}" Text="A fade moves the lights from one scene to another. Create scenes first (New ▸ Scene), then pick them here." />
                <!--
                    The New scene command lives on the Functions page; when the editor is hosted elsewhere (Shows page)
                    the binding finds no FunctionsView and the button hides (the sentence above still says what to do).
                -->
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="New scene"
                    Command="{Binding DataContext.NewSceneCommand, RelativeSource={RelativeSource AncestorType=views:FunctionsView}, FallbackValue={x:Null}}"
                    Style="{StaticResource ToolbarPrimaryButton}"
                    ToolTip="Create a new scene (closes this editor; you are asked first if it has unsaved changes)"
                    Visibility="{Binding DataContext.NewSceneCommand, RelativeSource={RelativeSource AncestorType=views:FunctionsView}, FallbackValue={x:Null}, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon Kind="Scenes" Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="New scene" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═════════════ Editor ═════════════ -->
        <Grid Visibility="{Binding HasScenes, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="170" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- What this does, in one line. -->
            <Border Margin="0,0,0,4" Style="{StaticResource FadeExplanation}">
                <DockPanel>
                    <c:DmxIcon
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Kind="Fade"
                        Size="{StaticResource Dmx.SmallIconSize}" />
                    <TextBlock Text="Moves the lights smoothly from one scene to another." TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- From → [Swap] → To: two square docked panels side by side. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <ContentControl
                    AutomationProperties.Name="From: where the lights start"
                    Content="{Binding From}"
                    ContentTemplate="{StaticResource FadeSidePanel}"
                    Focusable="False"
                    IsTabStop="False" />

                <StackPanel
                    Grid.Column="1"
                    Margin="4,0"
                    VerticalAlignment="Center">
                    <c:DmxIcon
                        Margin="0,0,0,4"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="moves to"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Kind="ChevronRight"
                        Size="{StaticResource Dmx.ButtonIconSize}" />
                    <Button
                        AutomationProperties.Name="Swap From and To"
                        Command="{Binding SwapCommand}"
                        Style="{StaticResource ToolbarLabelButton}"
                        ToolTip="Swap From and To (fade the other way round). Needs a scene on both sides.">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Refresh" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Swap" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ContentControl
                    Grid.Column="2"
                    AutomationProperties.Name="To: where the lights end up"
                    Content="{Binding To}"
                    ContentTemplate="{StaticResource FadeSidePanel}"
                    Focusable="False"
                    IsTabStop="False" />
            </Grid>

            <!-- Duration, colour strip, explanation, notes -->
            <Border
                Grid.Row="2"
                Margin="0,4,0,0"
                Style="{StaticResource PanelBorder}">
                <StackPanel Margin="6">
                    <DockPanel>
                        <TextBlock
                            Margin="0,0,6,0"
                            DockPanel.Dock="Left"
                            Style="{StaticResource FormLabel}"
                            Text="Duration" />
                        <ui:NumberBox
                            Width="104"
                            Margin="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Duration in seconds"
                            DockPanel.Dock="Left"
                            LargeChange="1"
                            MaxDecimalPlaces="2"
                            Maximum="3600"
                            Minimum="0"
                            SmallChange="0.5"
                            Style="{StaticResource FormNumberBox}"
                            ToolTip="How long the lights take to get from From to To, in seconds (0 = jump straight to To)"
                            Value="{Binding DurationSeconds, Mode=TwoWay}" />
                        <TextBlock
                            Margin="4,0,12,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="s" />
                        <!-- Quick durations: one radio group (Tab enters once, arrow keys move, Space picks). -->
                        <ItemsControl
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Quick durations"
                            Focusable="False"
                            IsTabStop="False"
                            ItemsSource="{Binding DurationPresets}"
                            KeyboardNavigation.DirectionalNavigation="Cycle"
                            KeyboardNavigation.TabNavigation="Once">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ed:FadeDurationPreset}">
                                    <RadioButton
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Content="{Binding Label}"
                                        GroupName="{Binding DataContext.PresetGroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        Style="{StaticResource FadeChoiceButton}"
                                        ToolTip="{Binding AutomationName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- On-screen colour strip From → To (display only; the real lights follow the editor preview). -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding HasGradient, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.ColumnSpan="3"
                            Height="18"
                            AutomationProperties.Name="{Binding GradientAutomationName}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Dmx.CornerRadius}"
                            ToolTip="On-screen colour hint only: roughly how the colour changes over the fade">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="{Binding GradientStart}" />
                                    <GradientStop Offset="1" Color="{Binding GradientEnd}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,2,8,0"
                            HorizontalAlignment="Left"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding GradientStartLabel}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,2,0,0"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding DurationLabel, StringFormat='— {0} —'}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="8,2,0,0"
                            HorizontalAlignment="Right"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding GradientEndLabel}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- What will happen, in one sentence. -->
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{Binding SummaryText}"
                        TextWrapping="Wrap" />

                    <!-- Notes and warnings (icon + text, never colour alone). -->
                    <ItemsControl
                        Margin="0,4,0,0"
                        Focusable="False"
                        IsTabStop="False"
                        ItemsSource="{Binding Notices}"
                        Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ed:FadeNotice}">
                                <Border
                                    x:Name="Bar"
                                    Margin="0,0,0,2"
                                    Padding="6,2"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="3,0,0,0">
                                    <DockPanel>
                                        <c:DmxIcon
                                            x:Name="NoticeIcon"
                                            Margin="0,1,6,0"
                                            VerticalAlignment="Top"
                                            DockPanel.Dock="Left"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Kind="{Binding IconKind}"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter TargetName="NoticeIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
