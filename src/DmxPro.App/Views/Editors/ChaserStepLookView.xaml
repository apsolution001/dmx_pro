<UserControl
    x:Class="DmxPro.App.Views.Editors.ChaserStepLookView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:conv="clr-namespace:DmxPro.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=ed:ChaserStepLookViewModel}"
    d:DesignHeight="420"
    d:DesignWidth="640"
    mc:Ignorable="d">
    <!--
        Step-look panel of the chaser editor (DataContext: ChaserStepLookViewModel): the look of ONE own-look step
        (an owned scene). Ported from the Sequence editor's step panel; the host puts it in its right-hand panel and
        may add its own controls (e.g. the "Lights show: This step / Whole chaser" switch) through HeaderContent.

        ┌ Step 2 · Intro  [Colours] [All channels]                              {HeaderContent} ┐
        │ Lights · 4 lights [Choose lights…]  ║ Colour  ● ● ● ● ● ● ● ● ●  [Off]                  │
        │ [All][None]        2 of 4 selected  ║ Levels                                            │
        │ ■ PAR 1  U1 · 1–6 · 6ch             ║ ☼ Intensity ─────────● [255]                      │
        │ ■ PAR 2  U1 · 7–12 · 6ch            ║ ● Red       ─────●──── [200]                      │
        │                                     ║ ● Green / Blue / White …                          │
        │ (All channels: the scene editor's fader banks for this step)                            │
        │ ⚠ Strobe is off in Settings …  (only when a light has a strobe channel)                 │
        └─────────────────────────────────────────────────────────────────────────────────────────┘

        Keys: Ctrl+L Choose lights · in the light list Ctrl+A selects all, Esc selects none.
    -->
    <UserControl.Resources>
        <conv:EqualsToVisibilityConverter x:Key="IndexToVisibility" />

        <!-- Tab header like the scene editor's tabs (flat, accent underline on the selected tab). -->
        <Style x:Key="StepLookTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Body}" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.TabHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4,4,0,0"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter
                                    Margin="0,0,0,2"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                                <Border
                                    x:Name="Underline"
                                    Height="2"
                                    Margin="-4,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1"
                                    Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header-only tab strip: the views below are separate panels shown by the selected index. -->
        <Style x:Key="StepLookTabStrip" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource StepLookTabItem}" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light-colour swatch (real light colour, display only): framed so black shows on a dark theme. -->
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style
            x:Key="LevelBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:DmxValueBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Margin" Value="6,1,0,1" />
            <Setter Property="Padding" Value="{StaticResource Dmx.TextControlPadding}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Type 0–255 and press Enter · ↑/↓ ±1 · PageUp/PageDown ±10" />
        </Style>

        <Style x:Key="LevelSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>

        <Style
            x:Key="SmallLabelButton"
            BasedOn="{StaticResource ToolbarLabelButton}"
            TargetType="Button">
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding ChooseLightsCommand}" Gesture="Ctrl+L" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <!-- ═════════════ Header: title, view switch, host content ═════════════ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <DockPanel>
                    <ContentPresenter
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Content="{Binding HeaderContent, ElementName=Root}"
                        DockPanel.Dock="Right"
                        Focusable="False" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            MaxWidth="200"
                            Margin="0,0,8,0"
                            Style="{StaticResource PanelTitle}"
                            Text="{Binding Title}"
                            ToolTip="{Binding Title}" />
                        <TabControl
                            AutomationProperties.Name="Step look views"
                            SelectedIndex="{Binding ValuesViewIndex, Mode=TwoWay}"
                            Style="{StaticResource StepLookTabStrip}">
                            <TabItem AutomationProperties.Name="Colours" ToolTip="Simple: colour and intensity of the selected lights">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="Color"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock VerticalAlignment="Center" Text="Colours" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem AutomationProperties.Name="All channels" ToolTip="Advanced: every channel of every light, 0–255 (strobe, macros, …)">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="Channel"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock VerticalAlignment="Center" Text="All channels" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Strobe held safe by Settings (icon + text, not colour alone). -->
            <DockPanel
                Margin="8,4"
                DockPanel.Dock="Bottom"
                Visibility="{Binding ShowStrobeBlockedHint, Converter={StaticResource BoolToVisibility}}">
                <c:DmxIcon
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Strobe is off"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Kind="Warning"
                    Size="{StaticResource Dmx.DenseIconSize}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource HintText}"
                    Text="Strobe is off in Settings: strobe channels of these lights stay at their safe value when the step plays." />
            </DockPanel>

            <Grid>
                <Grid Visibility="{Binding HasLights, Converter={StaticResource BoolToVisibility}}">
                    <!-- ═════ Colours (simple) ═════ -->
                    <Grid Visibility="{Binding ValuesViewIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="220"
                                MinWidth="160"
                                MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                        </Grid.ColumnDefinitions>

                        <!-- Lights of the step: choose them, and pick which ones the colour goes to. -->
                        <DockPanel>
                            <DockPanel Margin="4,2,4,0" DockPanel.Dock="Top">
                                <Button
                                    AutomationProperties.Name="Choose lights for this step"
                                    Command="{Binding ChooseLightsCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource SmallLabelButton}"
                                    ToolTip="Choose the lights this step uses: single lights (click, Shift+click, Ctrl+click) or whole groups (Ctrl+L)">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="Fixtures" Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Choose lights…" />
                                    </StackPanel>
                                </Button>
                                <TextBlock VerticalAlignment="Center">
                                    <Run FontWeight="SemiBold" Text="Lights" />
                                    <Run
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding LightCountText, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Margin="4,2" DockPanel.Dock="Top">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource StatusText}"
                                    Text="{Binding SelectedLightsText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,2,0"
                                        AutomationProperties.Name="Select all lights"
                                        Command="{Binding SelectAllLightsCommand}"
                                        Style="{StaticResource SmallLabelButton}"
                                        ToolTip="Select every light: the colour goes to all of them (Ctrl+A)">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="SelectAll" Size="{StaticResource Dmx.DenseIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="All" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Select no lights"
                                        Command="{Binding SelectNoLightsCommand}"
                                        Style="{StaticResource SmallLabelButton}"
                                        ToolTip="Clear the light selection (Esc)">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.DenseIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="None" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <ListBox
                                AutomationProperties.Name="Lights in this step"
                                BorderThickness="0"
                                ItemsSource="{Binding Lights}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionMode="Extended"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.InputBindings>
                                    <KeyBinding
                                        Key="A"
                                        Command="{Binding SelectAllLightsCommand}"
                                        Modifiers="Control" />
                                    <KeyBinding Key="Escape" Command="{Binding SelectNoLightsCommand}" />
                                </ListBox.InputBindings>
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        <Setter Property="Padding" Value="6,1" />
                                        <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ed:ChaserStepLookLightRowViewModel}">
                                        <DockPanel ToolTip="{Binding Detail}">
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding SwatchHex}"
                                                DockPanel.Dock="Left"
                                                Style="{StaticResource Swatch}"
                                                ToolTip="{Binding SwatchToolTip}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run
                                                    FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Detail, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter
                            Grid.Column="1"
                            AutomationProperties.Name="Resize lights and colours"
                            Style="{StaticResource VerticalSplitter}" />

                        <!-- Colour presets and level sliders for the selected lights. -->
                        <ScrollViewer
                            Grid.Column="2"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,2,8,8">
                                <TextBlock Style="{StaticResource FormSection}" Text="Colour" />
                                <WrapPanel>
                                    <ItemsControl
                                        AutomationProperties.Name="Colour presets"
                                        IsTabStop="False"
                                        ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SceneEditorColorPreset}">
                                                <Button
                                                    Width="{StaticResource Dmx.ToolbarButtonSize}"
                                                    Height="{StaticResource Dmx.ToolbarButtonSize}"
                                                    Margin="0,0,2,2"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Colour {0} for the selected lights}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ToolbarButton}"
                                                    ToolTip="{Binding Name, StringFormat={}{0}: set the selected lights to this colour (intensity goes to full if it was off)}">
                                                    <Ellipse
                                                        Width="16"
                                                        Height="16"
                                                        Fill="{Binding Swatch}"
                                                        Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        Margin="4,0,0,2"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="Turn the selected lights off in this step"
                                        Command="{Binding LightsOffCommand}"
                                        Style="{StaticResource ToolbarLabelButton}"
                                        ToolTip="Off: the selected lights are dark in this step (colours and intensity at 0)">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="14"
                                                Height="14"
                                                Fill="#000000"
                                                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Off" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <TextBlock
                                    Style="{StaticResource FormSection}"
                                    Text="Levels"
                                    Visibility="{Binding HasLevels, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl
                                    AutomationProperties.Name="Intensity and colour levels"
                                    IsTabStop="False"
                                    ItemsSource="{Binding Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ed:ChaserStepLookLevelRowViewModel}">
                                            <Grid Margin="0,0,0,2" ToolTip="{Binding ToolTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding DotHex}"
                                                    Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    Visibility="{Binding DotHex, Converter={StaticResource NullToVisibility}}" />
                                                <c:DmxIcon
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Kind="Dimmer"
                                                    Size="{StaticResource Dmx.DenseIconSize}"
                                                    Visibility="{Binding IsIntensity, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Label}" />
                                                <Slider
                                                    Grid.Column="2"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Style="{StaticResource LevelSlider}"
                                                    Value="{Binding Value}" />
                                                <c:DmxValueBox
                                                    Grid.Column="3"
                                                    AutomationProperties.Name="{Binding Label, StringFormat={}{0} value}"
                                                    Style="{StaticResource LevelBox}"
                                                    Value="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource HintText}"
                                    Text="Select lights on the left (Ctrl or Shift for several, or All), then pick a colour."
                                    Visibility="{Binding HasNoSelectedLights, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource HintText}"
                                    Text="Strobe, colour macros or other channels: use All channels above." />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ═════ All channels (the scene editor's Channels view, reused) ═════ -->
                    <views:SceneChannelsTab DataContext="{Binding Channels}" Visibility="{Binding DataContext.ValuesViewIndex, ElementName=Root, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}" />
                </Grid>

                <!-- No lights in this step yet: say what to do, with the action right here. -->
                <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoLights, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Kind="Fixtures"
                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                        Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No lights in this step" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="Choose the lights this step uses, then give them a colour." />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Choose lights for this step"
                        Command="{Binding ChooseLightsCommand}"
                        Style="{StaticResource ToolbarLabelButton}"
                        ToolTip="Choose the lights this step uses (Ctrl+L)">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Fixtures" Size="{StaticResource Dmx.DenseIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Choose lights…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
