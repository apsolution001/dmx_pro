<UserControl
    x:Class="DmxPro.App.Views.Editors.ColorCycleEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=ed:ColorCycleEditorViewModel}"
    d:DesignHeight="380"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <!--
        Colour cycle editor (DataContext: ColorCycleEditorViewModel). Kept simple for non-experts: the lights as a docked
        side panel at the left (their order is the direction of the rainbow wave); at the right a one-line explanation,
        then the colours in play order (quick fills, one-click preset colours) and a settings panel (change the selected
        colour, timing, "Spread across lights", white channel) with the on-screen preview docked at its bottom. The real
        lights follow every change while the editor is open.

        ┌ Lights ────────────┐║┃ The lights step through these colours, one after another.                         │
        │ 1 PAR 1  U1 · 1–4  │║┌ Colours · 3 colours [+][⧉][−][↑][↓] ┐║┌───────────────────────────────────────────┐
        │ 2 PAR 2  U1 · 5–8  │║│ Fill with: [Rainbow][Warm][Cool]     │║│ Change colour 2 · Green                   │
        │                    │║│ Removed 1 colour (Green).     [Undo] │║│ (colour editor: presets, R/G/B, #hex)     │
        │                    │║│ 1 ▬ Red                  #FF0000     │║│ Timing                                    │
        │                    │║│ 2 ▬ Green                #00FF00     │║│ Hold          [   1 ] s                   │
        │                    │║│ 3 ▬ Blue                 #0000FF     │║│ Fade          [   1 ] s                   │
        │                    │║│                                      │║│ Cycle length  6 s (3 colours × 2 s)       │
        │                    │║│ Add a colour (after the selected):   │║│ Spread across lights            40 %      │
        │                    │║│ (● Red)(● Green)(● Blue)(● White)…   │║│ Same colour ───●────── Rainbow wave       │
        │                    │║│ [+ Custom colour…]                   │║│ [ ] Use white channel                     │
        │                    │║│                                      │║├ Preview (on screen) ──────────────────────┤
        │                    │║│                                      │║│ [███▒▒███▒▒███▒▒]   ● 1 ● 2 ● 3           │
        └────────────────────┘║└──────────────────────────────────────┘║└───────────────────────────────────────────┘

        Keys: Ctrl+L chooses lights anywhere in the editor. In the colour list: Insert adds a custom colour, Ctrl+D
        duplicates, Delete removes (with Undo in the strip above the list), Ctrl+Up / Ctrl+Down (or Alt+Up / Alt+Down)
        move. Swatches are real light colours (hex allowed); every swatch also has its name.
    -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding Fixtures.ChooseLightsCommand}" Gesture="Ctrl+L" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style
            x:Key="SecondsBox"
            BasedOn="{StaticResource FormNumberBox}"
            TargetType="ui:NumberBox">
            <Setter Property="Width" Value="104" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="MaxDecimalPlaces" Value="2" />
            <Setter Property="Maximum" Value="3600" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="SmallChange" Value="0.1" />
        </Style>

        <!-- Labelled button in a panel header or strip: as high as PanelHeaderButton. -->
        <Style
            x:Key="StripLabelButton"
            BasedOn="{StaticResource ToolbarLabelButton}"
            TargetType="Button">
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <!-- Section heading inside the right-hand panel. -->
        <Style
            x:Key="SectionTitle"
            BasedOn="{StaticResource FormSection}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <!-- One-line "what this does" strip (same look as EffectExplanation in EffectEditorStyles.xaml). -->
        <Style x:Key="Explanation" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!-- A colour swatch: real light colour, thin theme border so black/white stay visible in both themes. -->
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="260"
                MinWidth="180"
                MaxWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="560" />
        </Grid.ColumnDefinitions>

        <!-- ═════════════ Lights ═════════════ -->
        <edv:FixtureListPanel DataContext="{Binding Fixtures}" />

        <GridSplitter
            Grid.Column="1"
            AutomationProperties.Name="Resize the light list"
            Style="{StaticResource VerticalSplitter}" />

        <DockPanel Grid.Column="2">
            <!-- What this function does, in one line. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Explanation}">
                <DockPanel>
                    <c:DmxIcon
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Kind="ColorCycle"
                        Size="{StaticResource Dmx.SmallIconSize}" />
                    <TextBlock Text="The lights step through these colours, one after another." TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="280"
                        MinWidth="220"
                        MaxWidth="520" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- ═════════════ Colours, in play order ═════════════ -->
                <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button
                                        AutomationProperties.Name="Add a custom colour"
                                        Command="{Binding AddColorCommand}"
                                        Style="{StaticResource PanelHeaderButton}"
                                        ToolTip="Add a custom colour after the selected one, then change it on the right (Insert)">
                                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Duplicate colour"
                                        Command="{Binding DuplicateColorCommand}"
                                        Style="{StaticResource PanelHeaderButton}"
                                        ToolTip="Duplicate the selected colour (Ctrl+D)">
                                        <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Remove colour"
                                        Command="{Binding RemoveColorCommand}"
                                        Style="{StaticResource PanelHeaderButton}"
                                        ToolTip="Remove the selected colour (Delete)">
                                        <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Move colour up"
                                        Command="{Binding MoveColorUpCommand}"
                                        Style="{StaticResource PanelHeaderButton}"
                                        ToolTip="Play earlier (Ctrl+Up)">
                                        <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Move colour down"
                                        Command="{Binding MoveColorDownCommand}"
                                        Style="{StaticResource PanelHeaderButton}"
                                        ToolTip="Play later (Ctrl+Down)">
                                        <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Style="{StaticResource PanelTitle}"
                                        Text="Colours"
                                        ToolTip="The colours, in the order they play" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource StatusText}"
                                        Text="{Binding ColorCountText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Quick fills: replace the whole list (with an Undo right after). -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="2,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Fill with:" />
                                    <ItemsControl
                                        AutomationProperties.Name="Quick colour fills"
                                        Focusable="False"
                                        IsTabStop="False"
                                        ItemsSource="{Binding Palettes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ed:ColorCyclePalette}">
                                                <Button
                                                    Margin="0,1,2,1"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Command="{Binding DataContext.ApplyPaletteCommand, RelativeSource={RelativeSource AncestorType=edv:ColorCycleEditorView}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StripLabelButton}"
                                                    ToolTip="{Binding ToolTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Mini strip of the fill's colours (real light colours). -->
                                                        <ItemsControl
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            Focusable="False"
                                                            IsTabStop="False"
                                                            ItemsSource="{Binding SwatchHexes}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Rectangle
                                                                        Width="3"
                                                                        Height="10"
                                                                        Fill="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                                            Text="{Binding Name}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                        </Border>

                        <!-- After a quick fill or a removal: say what happened and offer Undo. -->
                        <Border
                            DockPanel.Dock="Top"
                            Style="{StaticResource ToolbarStrip}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button
                                    AutomationProperties.Name="Undo"
                                    Command="{Binding UndoCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource StripLabelButton}"
                                    ToolTip="Bring back the colours you had before">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="Undo" Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            Text="Undo" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource StatusText}"
                                    Text="{Binding UndoMessage}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <!-- Add a colour: the scene editor's presets (one click) and a custom colour. -->
                        <Border
                            Padding="6,4,6,6"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            DockPanel.Dock="Bottom">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,3"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Add a colour (after the selected one):" />
                                <ItemsControl
                                    AutomationProperties.Name="Colours to add"
                                    Focusable="False"
                                    IsTabStop="False"
                                    ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneEditorColorPreset}">
                                            <Button
                                                Margin="0,0,2,2"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Add {0}}"
                                                Command="{Binding DataContext.AddPresetCommand, RelativeSource={RelativeSource AncestorType=edv:ColorCycleEditorView}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StripLabelButton}"
                                                ToolTip="{Binding Name, StringFormat=Add {0} after the selected colour}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border
                                                        Width="12"
                                                        Height="12"
                                                        Background="{Binding Swatch}"
                                                        Style="{StaticResource Swatch}" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Add a custom colour"
                                    Command="{Binding AddColorCommand}"
                                    Style="{StaticResource StripLabelButton}"
                                    ToolTip="Add a colour, then mix it on the right with Red / Green / Blue or a #RRGGBB code (Insert)">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            Text="Custom colour…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- The colour list. -->
                        <Grid>
                            <ListBox
                                AutomationProperties.Name="Colours, in play order"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Colors}"
                                SelectedItem="{Binding SelectedColor}">
                                <ListBox.InputBindings>
                                    <KeyBinding Command="{Binding AddColorCommand}" Gesture="Insert" />
                                    <KeyBinding Command="{Binding DuplicateColorCommand}" Gesture="Ctrl+D" />
                                    <KeyBinding Command="{Binding RemoveColorCommand}" Gesture="Delete" />
                                    <KeyBinding Command="{Binding MoveColorUpCommand}" Gesture="Ctrl+Up" />
                                    <KeyBinding Command="{Binding MoveColorDownCommand}" Gesture="Ctrl+Down" />
                                    <KeyBinding Command="{Binding MoveColorUpCommand}" Gesture="Alt+Up" />
                                    <KeyBinding Command="{Binding MoveColorDownCommand}" Gesture="Alt+Down" />
                                </ListBox.InputBindings>
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,1" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ed:ColorCycleEntryViewModel}">
                                        <DockPanel>
                                            <TextBlock
                                                MinWidth="18"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Number}" />
                                            <Border
                                                Width="20"
                                                Height="12"
                                                Margin="2,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding Hex}"
                                                DockPanel.Dock="Left"
                                                Style="{StaticResource Swatch}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Hex}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoColors, Converter={StaticResource BoolToVisibility}}">
                                <c:DmxIcon
                                    Kind="ColorCycle"
                                    Size="{StaticResource Dmx.EmptyStateIconSize}"
                                    Style="{StaticResource EmptyStateIcon}" />
                                <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No colours yet" />
                                <TextBlock Style="{StaticResource EmptyStateText}" Text="Start with a rainbow, or add colours one by one below." />
                                <Button
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Fill with Rainbow"
                                    Command="{Binding ApplyPaletteCommand}"
                                    CommandParameter="{Binding RainbowPalette}"
                                    Style="{StaticResource ToolbarPrimaryButton}"
                                    ToolTip="Add the seven rainbow colours: red, orange, yellow, green, cyan, blue, magenta">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Fill with Rainbow" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter
                    Grid.Column="1"
                    AutomationProperties.Name="Resize the colour list"
                    Style="{StaticResource VerticalSplitter}" />

                <!-- ═════════════ Selected colour, timing, spread; preview docked at the bottom ═════════════ -->
                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                MaxWidth="560"
                                Margin="8,0,8,8"
                                HorizontalAlignment="Left">

                                <!-- Change the selected colour. -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedColorTitle}" />
                                <Grid>
                                    <edv:ColorEditorView DataContext="{Binding ColorEditor}" Visibility="{Binding DataContext.HasSelectedColor, RelativeSource={RelativeSource AncestorType=edv:ColorCycleEditorView}, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Style="{StaticResource HintText}"
                                        Text="Select a colour in the list to change it."
                                        Visibility="{Binding HasNoSelectedColor, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <!-- Timing: one hold and one fade for every colour (the model has no per-colour times). -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Timing" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Dmx.FormLabelColumnWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource FormLabel}" Text="Hold" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="{StaticResource Dmx.FormRowMargin}"
                                        Orientation="Horizontal">
                                        <ui:NumberBox
                                            AutomationProperties.Name="Hold, seconds"
                                            Style="{StaticResource SecondsBox}"
                                            ToolTip="How long each colour stays before blending into the next, in seconds"
                                            Value="{Binding HoldSeconds, Mode=TwoWay}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="s" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource FormLabel}"
                                        Text="Fade" />
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Dmx.FormRowMargin}"
                                        Orientation="Horizontal">
                                        <ui:NumberBox
                                            AutomationProperties.Name="Fade, seconds"
                                            Style="{StaticResource SecondsBox}"
                                            ToolTip="How long the smooth blend into the next colour takes, in seconds (0 = jump straight to it)"
                                            Value="{Binding FadeSeconds, Mode=TwoWay}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="s" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource FormLabel}"
                                        Text="Cycle length" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="{StaticResource Dmx.FormRowMargin}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding CycleLengthText, StringFormat=Cycle length {0}}"
                                        Text="{Binding CycleLengthText}"
                                        ToolTip="One round through all colours (Hold + Fade for each colour), then it starts again" />
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Text="Each colour stays for the Hold time, then blends into the next over the Fade time (0 = jump straight to it). After the last colour it starts again." />

                                <!-- Spread across lights (the per-light offset, as a percentage). -->
                                <DockPanel Margin="0,8,0,3">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontWeight="SemiBold"
                                        Text="{Binding SpreadText}" />
                                    <TextBlock
                                        Margin="0"
                                        Style="{StaticResource FormSection}"
                                        Text="Spread across lights" />
                                </DockPanel>
                                <Grid IsEnabled="{Binding CanSpread}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Same colour" />
                                    <Slider
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="0 percent: all lights show the same colour. 100 percent: the colours are spread evenly across the lights, a rainbow wave."
                                        AutomationProperties.Name="Spread across lights, percent"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="25"
                                        Maximum="100"
                                        Minimum="0"
                                        SmallChange="5"
                                        TickFrequency="5"
                                        ToolTip="0 % = all lights show the same colour · more = a rainbow wave across the lights (light 1 first, in the order of the light list) · ←/→ ±5 %, PageUp/PageDown ±25 %"
                                        Value="{Binding SpreadPercent}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Rainbow wave" />
                                </Grid>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource StatusText}"
                                    Text="{Binding SpreadDetail}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource HintText}"
                                    Text="0 % = all lights the same colour. More = the colours travel across the lights like a wave. The order of the light list is the direction." />

                                <!-- Option. -->
                                <CheckBox
                                    Margin="0,8,0,0"
                                    AutomationProperties.Name="Use white channel"
                                    Content="Use white channel"
                                    IsChecked="{Binding UseWhiteChannel}"
                                    ToolTip="On: the white part of each colour goes to the light's White channel (brighter, cleaner whites). Off: white is mixed from red, green and blue." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════ On-screen preview: one round, then each light at the start ═════ -->
                        <DockPanel Grid.Row="1">
                            <Border
                                BorderThickness="0,1,0,1"
                                DockPanel.Dock="Top"
                                Style="{StaticResource PanelHeader}">
                                <TextBlock
                                    Style="{StaticResource PanelTitle}"
                                    Text="Preview (on screen)"
                                    ToolTip="A picture of the colour cycle on screen. The real lights show your changes too while this editor is open (see the editor toolbar)." />
                            </Border>
                            <StackPanel MaxWidth="560" Margin="8,6" HorizontalAlignment="Left">
                                <Grid Visibility="{Binding HasColors, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Height="18"
                                        AutomationProperties.Name="One round of colours, left to right"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True">
                                        <ItemsControl
                                            Focusable="False"
                                            IsTabStop="False"
                                            ItemsSource="{Binding PreviewSlots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ed:ColorCyclePreviewSlot}">
                                                    <!-- Real light colours: the colour holds, then blends into the next. -->
                                                    <Rectangle ToolTip="{Binding ToolTip}">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Offset="0" Color="{Binding Hex}" />
                                                                <GradientStop Offset="{Binding HoldShare}" Color="{Binding Hex}" />
                                                                <GradientStop Offset="1" Color="{Binding NextHex}" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,1,0,0"
                                        Style="{StaticResource HintText}"
                                        Text="One round, left to right. Hover a part to see its colour." />
                                </Grid>

                                <TextBlock
                                    Margin="0,6,0,2"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Each light when the cycle starts:"
                                    Visibility="{Binding HasPreviewLights, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl
                                    AutomationProperties.Name="Each light when the cycle starts"
                                    Focusable="False"
                                    IsTabStop="False"
                                    ItemsSource="{Binding PreviewLights}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ed:ColorCyclePreviewLight}">
                                            <StackPanel
                                                Width="28"
                                                Margin="0,0,2,2"
                                                AutomationProperties.Name="{Binding Description}"
                                                Background="Transparent"
                                                ToolTip="{Binding Description}">
                                                <Ellipse
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Fill="{Binding Hex}"
                                                    Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Number}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Style="{StaticResource HintText}"
                                    Text="{Binding MorePreviewLightsText}"
                                    Visibility="{Binding MorePreviewLightsText, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock
                                    Style="{StaticResource HintText}"
                                    Text="{Binding PreviewLightsHint}"
                                    Visibility="{Binding PreviewLightsHint, Converter={StaticResource NullToVisibility}}" />

                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
