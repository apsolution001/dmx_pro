<UserControl
    x:Class="DmxPro.App.Views.Editors.ColorCycleEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=ed:ColorCycleEditorViewModel}"
    d:DesignHeight="380"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <!--
        Colour cycle editor (DataContext: ColorCycleEditorViewModel). Kept simple for non-experts: three docked panels.
        Left: the lights, in order (the order is the direction of the rainbow wave). Middle: the colours in play order,
        with quick fills and one-click preset colours. Right: change the selected colour, the timing, "Spread across
        lights" and an on-screen preview. The real lights follow every change while the editor is open.

        ┌ Fixtures ──────────┐║┌ Colours · 3 colours [+][⧉][−][↑][↓] ┐║┌───────────────────────────────────────────┐
        │ 1 PAR 1  U1 · 1–4  │║│ Fill with: [Rainbow][Warm][Cool]     │║│ Change colour 2 · Green                   │
        │ 2 PAR 2  U1 · 5–8  │║│ 1 [██] Red          #FF0000          │║│ ■■■■■■■■■              [██] [#00FF00]     │
        │                    │║│ 2 [██] Green        #00FF00          │║│ ● R ●──────────── [  0]  (G, B …)         │
        │                    │║│ 3 [██] Blue         #0000FF          │║│ Timing                                    │
        │                    │║│                                      │║│ Hold [1] s   Fade [1] s                   │
        │                    │║│ Add a colour:                        │║│ One round: 6 s (3 colours × 2 s) …        │
        │                    │║│ (● Red)(● Green)(● Blue)(● White)…   │║│ Spread across lights            40 %      │
        │                    │║│ [+ Custom colour]                    │║│ Same colour ───●────── Rainbow wave       │
        │                    │║│                                      │║│ Preview: [███▒▒███▒▒███▒▒]  ● 1 ● 2 ● 3  │
        │                    │║│                                      │║│ [ ] Use white channel                     │
        └────────────────────┘║└──────────────────────────────────────┘║└───────────────────────────────────────────┘

        Keys in the colour list: Insert adds a custom colour, Ctrl+D duplicates, Delete removes, Ctrl+Up / Ctrl+Down
        (or Alt+Up / Alt+Down) move. Swatches are real light colours (hex allowed); every swatch also has its name.
    -->
    <UserControl.Resources>
        <Style
            x:Key="SecondsBox"
            BasedOn="{StaticResource FormNumberBox}"
            TargetType="ui:NumberBox">
            <Setter Property="Width" Value="96" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="MaxDecimalPlaces" Value="2" />
            <Setter Property="Maximum" Value="3600" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="SmallChange" Value="0.1" />
        </Style>

        <!-- Labelled button in a panel header or strip: as high as PanelHeaderButton. -->
        <Style
            x:Key="StripLabelButton"
            BasedOn="{StaticResource ToolbarLabelButton}"
            TargetType="Button">
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <!-- Section heading inside the right-hand panel. -->
        <Style
            x:Key="SectionTitle"
            BasedOn="{StaticResource FormSection}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <!-- A colour swatch: real light colour, thin theme border so black/white stay visible in both themes. -->
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="260"
                MinWidth="180"
                MaxWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                Width="280"
                MinWidth="220"
                MaxWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ═════════════ Lights ═════════════ -->
        <edv:FixtureListPanel DataContext="{Binding Fixtures}" />

        <GridSplitter
            Grid.Column="1"
            AutomationProperties.Name="Resize the light list"
            Style="{StaticResource VerticalSplitter}" />

        <!-- ═════════════ Colours, in play order ═════════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Add a custom colour"
                                Command="{Binding AddColorCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Add a custom colour after the selected one, then change it on the right (Insert)">
                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Duplicate colour"
                                Command="{Binding DuplicateColorCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Duplicate the selected colour (Ctrl+D)">
                                <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.DenseIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Remove colour"
                                Command="{Binding RemoveColorCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Remove the selected colour (Delete)">
                                <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.DenseIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Move colour up"
                                Command="{Binding MoveColorUpCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Play earlier (Ctrl+Up)">
                                <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.DenseIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Move colour down"
                                Command="{Binding MoveColorDownCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Play later (Ctrl+Down)">
                                <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.DenseIconSize}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource PanelTitle}"
                                Text="Colours"
                                ToolTip="The colours, in the order they play" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource StatusText}"
                                Text="{Binding ColorCountText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Quick fills: replace the whole list (with an Undo right after). -->
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Fill with:" />
                            <ItemsControl
                                AutomationProperties.Name="Quick colour fills"
                                Focusable="False"
                                IsTabStop="False"
                                ItemsSource="{Binding Palettes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ed:ColorCyclePalette}">
                                        <Button
                                            Margin="0,1,2,1"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Command="{Binding DataContext.ApplyPaletteCommand, RelativeSource={RelativeSource AncestorType=edv:ColorCycleEditorView}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource StripLabelButton}"
                                            ToolTip="{Binding ToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Mini strip of the fill's colours (real light colours). -->
                                                <ItemsControl
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Focusable="False"
                                                    IsTabStop="False"
                                                    ItemsSource="{Binding SwatchHexes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle
                                                                Width="3"
                                                                Height="10"
                                                                Fill="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                                    Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <!-- After a fill replaced existing colours: say so and offer Undo. -->
                        <DockPanel Margin="2,1,0,1" Visibility="{Binding CanUndoFill, Converter={StaticResource BoolToVisibility}}">
                            <Button
                                AutomationProperties.Name="Undo the fill"
                                Command="{Binding UndoFillCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource StripLabelButton}"
                                ToolTip="Bring back the colours you had before the fill">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Undo" Size="{StaticResource Dmx.DenseIconSize}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Text="Undo" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource StatusText}"
                                Text="{Binding FillMessage}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Add a colour: the scene editor's presets (one click) and a custom colour. -->
                <Border
                    Padding="6,4,6,6"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,3"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Add a colour (after the selected one):" />
                        <ItemsControl
                            AutomationProperties.Name="Colours to add"
                            Focusable="False"
                            IsTabStop="False"
                            ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SceneEditorColorPreset}">
                                    <Button
                                        Margin="0,0,2,2"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Add {0}}"
                                        Command="{Binding DataContext.AddPresetCommand, RelativeSource={RelativeSource AncestorType=edv:ColorCycleEditorView}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource StripLabelButton}"
                                        ToolTip="{Binding Name, StringFormat=Add {0} after the selected colour}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="12"
                                                Height="12"
                                                Background="{Binding Swatch}"
                                                Style="{StaticResource Swatch}" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                                Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            Margin="0,2,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Add a custom colour"
                            Command="{Binding AddColorCommand}"
                            Style="{StaticResource StripLabelButton}"
                            ToolTip="Add a colour, then mix it on the right with Red / Green / Blue or a #RRGGBB code (Insert)">
                            <StackPanel Orientation="Horizontal">
                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Text="Custom colour…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- The colour list. -->
                <Grid>
                    <ListBox
                        AutomationProperties.Name="Colours, in play order"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Colors}"
                        SelectedItem="{Binding SelectedColor}">
                        <ListBox.InputBindings>
                            <KeyBinding Command="{Binding AddColorCommand}" Gesture="Insert" />
                            <KeyBinding Command="{Binding DuplicateColorCommand}" Gesture="Ctrl+D" />
                            <KeyBinding Command="{Binding RemoveColorCommand}" Gesture="Delete" />
                            <KeyBinding Command="{Binding MoveColorUpCommand}" Gesture="Ctrl+Up" />
                            <KeyBinding Command="{Binding MoveColorDownCommand}" Gesture="Ctrl+Down" />
                            <KeyBinding Command="{Binding MoveColorUpCommand}" Gesture="Alt+Up" />
                            <KeyBinding Command="{Binding MoveColorDownCommand}" Gesture="Alt+Down" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="{StaticResource Dmx.ControlHeight}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ed:ColorCycleEntryViewModel}">
                                <DockPanel>
                                    <TextBlock
                                        MinWidth="18"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Number}" />
                                    <Border
                                        Width="32"
                                        Height="18"
                                        Margin="2,0,8,0"
                                        Background="{Binding Hex}"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource Swatch}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Hex}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoColors, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            Kind="ColorCycle"
                            Size="{StaticResource Dmx.EmptyStateIconSize}"
                            Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No colours yet" />
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="Click Rainbow above, or add colours below." />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter
            Grid.Column="3"
            AutomationProperties.Name="Resize the colour list"
            Style="{StaticResource VerticalSplitter}" />

        <!-- ═════════════ Selected colour, timing, spread, preview ═════════════ -->
        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="560"
                    Margin="8,0,8,8"
                    HorizontalAlignment="Left">

                    <!-- Change the selected colour. -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedColorTitle}" />
                    <Grid>
                        <edv:ColorEditorView DataContext="{Binding ColorEditor}" Visibility="{Binding DataContext.HasSelectedColor, RelativeSource={RelativeSource AncestorType=edv:ColorCycleEditorView}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Style="{StaticResource HintText}"
                            Text="Select a colour in the list to change it."
                            Visibility="{Binding HasNoSelectedColor, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Timing: one hold and one fade for every colour (the model has no per-colour times). -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Timing" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,4" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Each colour stays" />
                            <ui:NumberBox
                                AutomationProperties.Name="Hold time of each colour, seconds"
                                Style="{StaticResource SecondsBox}"
                                ToolTip="How long each colour stays before blending into the next, in seconds"
                                Value="{Binding HoldSeconds, Mode=TwoWay}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="s" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="then blends over" />
                            <ui:NumberBox
                                AutomationProperties.Name="Fade time to the next colour, seconds"
                                Style="{StaticResource SecondsBox}"
                                ToolTip="How long the smooth blend into the next colour takes, in seconds (0 = jump straight to it)"
                                Value="{Binding FadeSeconds, Mode=TwoWay}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="s" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock
                        Style="{StaticResource StatusText}"
                        Text="{Binding RoundText}"
                        TextWrapping="Wrap" />

                    <!-- Spread across lights (the per-light offset, as a percentage). -->
                    <DockPanel Margin="0,8,0,3">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            FontWeight="SemiBold"
                            Text="{Binding SpreadText}" />
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource FormSection}"
                            Text="Spread across lights" />
                    </DockPanel>
                    <Grid IsEnabled="{Binding CanSpread}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Same colour" />
                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="0 percent: all lights show the same colour. 100 percent: the colours are spread evenly across the lights, a rainbow wave."
                            AutomationProperties.Name="Spread across lights, percent"
                            IsSnapToTickEnabled="True"
                            LargeChange="25"
                            Maximum="100"
                            Minimum="0"
                            SmallChange="5"
                            TickFrequency="5"
                            ToolTip="0 % = all lights show the same colour · more = a rainbow wave across the lights (light 1 first, in the order of the light list) · ←/→ ±5 %, PageUp/PageDown ±25 %"
                            Value="{Binding SpreadPercent}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Rainbow wave" />
                    </Grid>
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource StatusText}"
                        Text="{Binding SpreadDetail}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource HintText}"
                        Text="0 % = all lights the same colour. More = the colours travel across the lights like a wave. The order of the light list is the direction." />

                    <!-- On-screen preview: one round, then each light at the start. -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Preview (on screen)" />
                    <Grid Visibility="{Binding HasColors, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Height="18"
                            AutomationProperties.Name="One round of colours, left to right"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                            <ItemsControl
                                Focusable="False"
                                IsTabStop="False"
                                ItemsSource="{Binding PreviewSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ed:ColorCyclePreviewSlot}">
                                        <!-- Real light colours: the colour holds, then blends into the next. -->
                                        <Rectangle ToolTip="{Binding ToolTip}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0" Color="{Binding Hex}" />
                                                    <GradientStop Offset="{Binding HoldShare}" Color="{Binding Hex}" />
                                                    <GradientStop Offset="1" Color="{Binding NextHex}" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,1,0,0"
                            Style="{StaticResource HintText}"
                            Text="One round, left to right. Hover a part to see its colour." />
                    </Grid>

                    <TextBlock
                        Margin="0,6,0,2"
                        FontSize="{StaticResource Dmx.FontSize.Small}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Each light when the cycle starts:"
                        Visibility="{Binding HasPreviewLights, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl
                        AutomationProperties.Name="Each light when the cycle starts"
                        Focusable="False"
                        IsTabStop="False"
                        ItemsSource="{Binding PreviewLights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ed:ColorCyclePreviewLight}">
                                <StackPanel
                                    Width="28"
                                    Margin="0,0,2,2"
                                    AutomationProperties.Name="{Binding Description}"
                                    Background="Transparent"
                                    ToolTip="{Binding Description}">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        Fill="{Binding Hex}"
                                        Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Caption}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Number}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Style="{StaticResource HintText}"
                        Text="{Binding MorePreviewLightsText}"
                        Visibility="{Binding MorePreviewLightsText, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock
                        Style="{StaticResource HintText}"
                        Text="{Binding PreviewLightsHint}"
                        Visibility="{Binding PreviewLightsHint, Converter={StaticResource NullToVisibility}}" />

                    <!-- Option. -->
                    <CheckBox
                        Margin="0,8,0,0"
                        AutomationProperties.Name="Use the white channel"
                        Content="Use the lights' white channel"
                        IsChecked="{Binding UseWhiteChannel}"
                        ToolTip="On: the white part of each colour goes to the light's White channel (brighter, cleaner whites). Off: white is mixed from red, green and blue." />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
