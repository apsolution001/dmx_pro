<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Shared styles of the pulse, flash and strobe editors (merged by PulseEditorView, FlashEditorView and
        StrobeEditorView). Built on the app styles (ToolbarToggleButton, FormNumberBox, FormSection …).

        Pick-one choices: segmented buttons (EffectChoiceButton inside an EffectChoicePanel / EffectChoiceRow) for every
        plain pick-one-of-N. Round radio buttons only where one choice carries its own inline field (Flash "For a set
        time: [1.00] s", Strobe "Exact value: ──●── [0]"). Every group has its own GroupName, so the buttons of one row
        are one group for screen readers; Tab enters a row once, the arrow keys move inside it, Space picks.

        EffectChoiceButton     RadioButton  Segmented pick-one button (Slow / Medium / Fast …): outlined, accent fill when chosen.
        EffectChoicePanel      StackPanel   Row of hand-written EffectChoiceButtons (one Tab stop, arrow keys inside).
        EffectChoiceRow        ItemsControl Row of EffectChoiceButtons for an EffectChoiceGroup's Choices (GroupName from the group).
        EffectExplanation      Border       One-line "what this effect does" strip at the top of the settings panel.
        EffectSection          TextBlock    Small heading above a group of fields (Colour, Speed, Brightness …).
        EffectNumberBox        ui:NumberBox Number box of the effect editors (width 104).
        EffectSecondsBox       ui:NumberBox Exact seconds / rate next to the presets (2 decimals).
        EffectPercentBox       ui:NumberBox Whole percent (0 decimals).
        EffectPercentSlider    Slider       0–100 % slider.
        EffectUnitText         TextBlock    "s per breath", "%" after a box.
        CautionBar / CautionIcon            Safety notes ONLY (strobe): caution stroke at the left + warning icon + text.
        EffectNoLightsBar / EffectNoLightsIcon  Neutral info strip "No lights chosen yet" + Choose lights button.
    -->

    <Style
        x:Key="EffectChoiceButton"
        BasedOn="{StaticResource ToolbarToggleButton}"
        TargetType="RadioButton">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="EffectChoicePanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    </Style>

    <Style x:Key="EffectChoiceRow" TargetType="ItemsControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RadioButton
                        AutomationProperties.HelpText="{Binding ToolTip}"
                        AutomationProperties.Name="{Binding Label}"
                        Content="{Binding Label}"
                        GroupName="{Binding GroupName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Style="{StaticResource EffectChoiceButton}"
                        ToolTip="{Binding ToolTip}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EffectExplanation" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style
        x:Key="EffectSection"
        BasedOn="{StaticResource FormSection}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,3" />
    </Style>

    <Style
        x:Key="EffectNumberBox"
        BasedOn="{StaticResource FormNumberBox}"
        TargetType="ui:NumberBox">
        <Setter Property="Width" Value="104" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="EffectSecondsBox"
        BasedOn="{StaticResource EffectNumberBox}"
        TargetType="ui:NumberBox">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="LargeChange" Value="1" />
        <Setter Property="MaxDecimalPlaces" Value="2" />
        <Setter Property="SmallChange" Value="0.1" />
    </Style>

    <Style
        x:Key="EffectPercentBox"
        BasedOn="{StaticResource EffectNumberBox}"
        TargetType="ui:NumberBox">
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="MaxDecimalPlaces" Value="0" />
        <Setter Property="SmallChange" Value="1" />
    </Style>

    <Style x:Key="EffectPercentSlider" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Margin" Value="0,0,6,3" />
    </Style>

    <Style x:Key="EffectUnitText" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Caution colour: safety notes only (photosensitivity, strobe off in Settings, speed limit). -->
    <Style x:Key="CautionBar" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style x:Key="CautionIcon" TargetType="c:DmxIcon">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="Size" Value="{StaticResource Dmx.SmallIconSize}" />
    </Style>

    <!-- Neutral "what to do next" strip: an empty state, not a warning, so no caution colour. -->
    <Style x:Key="EffectNoLightsBar" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="EffectNoLightsIcon" TargetType="c:DmxIcon">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Size" Value="{StaticResource Dmx.SmallIconSize}" />
    </Style>
</ResourceDictionary>
