<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Shared styles of the pulse, flash and strobe editors (merged by PulseEditorView, FlashEditorView and
        StrobeEditorView). Built on the app styles (ToolbarToggleButton, FormNumberBox, FormSection …).

        EffectChoiceButton     RadioButton  Segmented pick-one button (Slow / Medium / Fast …): outlined, accent fill when chosen.
        EffectChoiceRow        ItemsControl Row of EffectChoiceButtons for an EffectChoiceGroup's Choices.
        EffectExplanation      Border       One-line "what this effect does" strip at the top of the settings tab.
        EffectSection          TextBlock    Small heading above a group of fields (Colour, Speed, Brightness …).
        EffectSecondsBox       ui:NumberBox Exact number next to the presets (2 decimals).
        EffectPercentSlider    Slider       0–100 % slider.
        EffectUnitText         TextBlock    "s per breath", "%" after a box.
        CautionBar / CautionIcon            Safety notes (strobe): caution stroke at the left + warning icon + text.
        EffectNoLightsBar      Border       "No lights chosen yet" strip with a Choose lights button.
        EffectPreviewPanel     Border       The on-screen preview panel at the right.
    -->

    <Style
        x:Key="EffectChoiceButton"
        BasedOn="{StaticResource ToolbarToggleButton}"
        TargetType="RadioButton">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="EffectChoiceRow" TargetType="ItemsControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <RadioButton
                        AutomationProperties.HelpText="{Binding ToolTip}"
                        AutomationProperties.Name="{Binding Label}"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Style="{StaticResource EffectChoiceButton}"
                        ToolTip="{Binding ToolTip}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EffectExplanation" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style
        x:Key="EffectSection"
        BasedOn="{StaticResource FormSection}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,3" />
    </Style>

    <Style
        x:Key="EffectSecondsBox"
        BasedOn="{StaticResource FormNumberBox}"
        TargetType="ui:NumberBox">
        <Setter Property="Width" Value="104" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="LargeChange" Value="1" />
        <Setter Property="MaxDecimalPlaces" Value="2" />
        <Setter Property="SmallChange" Value="0.1" />
    </Style>

    <Style x:Key="EffectPercentSlider" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Margin" Value="0,0,6,3" />
    </Style>

    <Style x:Key="EffectUnitText" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CautionBar" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style x:Key="CautionIcon" TargetType="c:DmxIcon">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="Size" Value="{StaticResource Dmx.SmallIconSize}" />
    </Style>

    <Style
        x:Key="EffectNoLightsBar"
        BasedOn="{StaticResource CautionBar}"
        TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="EffectPreviewPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
