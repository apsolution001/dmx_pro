<UserControl
    x:Class="DmxPro.App.Views.Editors.ChaserEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=ed:ChaserEditorViewModel}"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <!--
        Chaser editor (DataContext: ChaserEditorViewModel), QLC+-style and dense: one step grid. Add opens a
        searchable function picker (the chaser itself and functions that would make it play itself are not listed).
        Timing cells are text boxes: type seconds and press Enter or Tab; invalid text reverts.
        Keys in the grid: Del remove, Ctrl+D duplicate, Alt+Up / Alt+Down move.

        ┌ Steps · 4 steps                          [Add ▾][⧉][-][↑][↓] ┐
        │ [Loop ▾] [Forward ▾]  ◷ Cycle: 6 s                            │
        │ #  Function           In (s)  Hold (s)  Out (s)               │
        │ 1  ◐ Red              [0.5]   [1]       [0.5]                 │
        │ 2  ◐ Blue             [0.5]   [1]       [0.5]                 │
        └───────────────────────────────────────────────────────────────┘
    -->
    <UserControl.Resources>
        <Style
            x:Key="HeaderToggle"
            BasedOn="{StaticResource ToolbarToggleButton}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <!-- Seconds cell of the step grid: a slim box that fits the dense table row. -->
        <Style
            x:Key="SecondsCell"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:CommitTextBox">
            <Setter Property="Width" Value="60" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Seconds, e.g. 0.5 · Enter or Tab applies, Esc undoes · invalid text reverts" />
        </Style>

        <!-- Combo in the one-line run strip: no form bottom margin. -->
        <Style
            x:Key="StripComboBox"
            BasedOn="{StaticResource FormComboBox}"
            TargetType="ComboBox">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton
                            x:Name="AddToggle"
                            AutomationProperties.Name="Add steps"
                            IsHitTestVisible="{Binding IsOpen, ElementName=AddPopup, Converter={StaticResource InvertBool}}"
                            Style="{StaticResource HeaderToggle}"
                            ToolTip="Add steps: pick functions (usually scenes) to play">
                            <StackPanel Orientation="Horizontal">
                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Text="Add" />
                                <c:DmxIcon Kind="ChevronDown" Size="{StaticResource Dmx.DenseIconSize}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button
                            AutomationProperties.Name="Duplicate step"
                            Command="{Binding DuplicateStepCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Duplicate the selected step (Ctrl+D)">
                            <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Remove step"
                            Command="{Binding RemoveStepCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Remove the selected step (Del)">
                            <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Move step up"
                            Command="{Binding MoveStepUpCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Move the selected step up (Alt+Up)">
                            <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Move step down"
                            Command="{Binding MoveStepDownCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Move the selected step down (Alt+Down)">
                            <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Steps" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource StatusText}"
                            Text="{Binding StepCountText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Function picker flyout. -->
            <Popup
                x:Name="AddPopup"
                AllowsTransparency="True"
                DockPanel.Dock="Top"
                IsOpen="{Binding IsChecked, ElementName=AddToggle, Mode=TwoWay}"
                KeyDown="OnAddPopupKeyDown"
                Opened="OnAddPopupOpened"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=AddToggle}"
                StaysOpen="False">
                <Border
                    Width="340"
                    Margin="8,0,8,6"
                    Padding="4"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Dmx.CornerRadius}"
                    KeyboardNavigation.TabNavigation="Cycle">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="16"
                            Direction="270"
                            Opacity="0.28"
                            ShadowDepth="4" />
                    </Border.Effect>
                    <StackPanel>
                        <ui:TextBox
                            x:Name="PickerSearchBox"
                            AutomationProperties.Name="Search functions"
                            PlaceholderText="Search functions"
                            PreviewKeyDown="OnPickerSearchPreviewKeyDown"
                            Style="{StaticResource FormTextBox}"
                            Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                        <ListBox
                            x:Name="PickerList"
                            MaxHeight="360"
                            AutomationProperties.Name="Functions to add"
                            BorderThickness="0"
                            ItemsSource="{Binding PickerItems}"
                            SelectionMode="Extended"
                            ToolTip="Double-click or Enter adds · Ctrl / Shift picks several · Esc closes">
                            <ListBox.InputBindings>
                                <KeyBinding
                                    Command="{Binding AddStepsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=PickerList}"
                                    Gesture="Enter" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnPickerItemDoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ed:FunctionPickerItem}">
                                    <DockPanel>
                                        <c:DmxIcon
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Kind="{Binding IconKind}"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Right"
                                            FontSize="{StaticResource Dmx.FontSize.Caption}"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding TypeName}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            Margin="0,2"
                            Style="{StaticResource HintText}"
                            Text="Nothing to add: create scenes first (functions that would play this chaser are hidden)."
                            Visibility="{Binding HasNoPickerItems, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Add selected functions as steps"
                            Command="{Binding AddStepsCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=PickerList}"
                            Style="{StaticResource ToolbarPrimaryButton}"
                            ToolTip="Add the selected functions after the selected step">
                            <StackPanel Orientation="Horizontal">
                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Add" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- One line: run order, direction, cycle time (labels live in tooltips / automation names). -->
            <Border
                Padding="4,2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <WrapPanel>
                    <ComboBox
                        AutomationProperties.Name="Run order"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding RunOrders}"
                        SelectedValue="{Binding RunOrder}"
                        SelectedValuePath="Value"
                        Style="{StaticResource StripComboBox}"
                        ToolTip="Run order: loop, play once, or ping-pong (first to last and back)" />
                    <ComboBox
                        AutomationProperties.Name="Direction"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Directions}"
                        SelectedValue="{Binding Direction}"
                        SelectedValuePath="Value"
                        Style="{StaticResource StripComboBox}"
                        ToolTip="Direction: start at the first or the last step" />
                    <StackPanel
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="Each step lasts fade in + hold; its fade out overlaps the next step">
                        <c:DmxIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Kind="Recent"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Cycle time"
                            Style="{StaticResource StatusText}"
                            Text="{Binding CycleText}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Grid>
                <DataGrid
                    x:Name="StepGrid"
                    AutomationProperties.Name="Chaser steps"
                    ItemsSource="{Binding Steps}"
                    KeyboardNavigation.TabNavigation="Continue"
                    SelectedItem="{Binding SelectedStep}"
                    SelectionMode="Single"
                    Style="{StaticResource DataTable}">
                    <DataGrid.InputBindings>
                        <KeyBinding Command="{Binding RemoveStepCommand}" Gesture="Delete" />
                        <KeyBinding Command="{Binding DuplicateStepCommand}" Gesture="Ctrl+D" />
                        <KeyBinding Command="{Binding MoveStepUpCommand}" Gesture="Alt+Up" />
                        <KeyBinding Command="{Binding MoveStepDownCommand}" Gesture="Alt+Down" />
                    </DataGrid.InputBindings>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource DataTableRow}" TargetType="DataGridRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            <EventSetter Event="GotKeyboardFocus" Handler="OnRowGotKeyboardFocus" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="36"
                            Binding="{Binding Number}"
                            Header="#"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="160"
                            Header="Function"
                            IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type ed:ChaserStepRowViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding TypeName}">
                                        <c:DmxIcon
                                            x:Name="TypeIcon"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Kind="{Binding IconKind}"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding FunctionName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="76" Header="In (s)">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type ed:ChaserStepRowViewModel}">
                                    <c:CommitTextBox
                                        AutomationProperties.Name="Fade in, seconds"
                                        Style="{StaticResource SecondsCell}"
                                        Text="{Binding FadeInText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="76" Header="Hold (s)">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type ed:ChaserStepRowViewModel}">
                                    <c:CommitTextBox
                                        AutomationProperties.Name="Hold, seconds"
                                        Style="{StaticResource SecondsCell}"
                                        Text="{Binding HoldText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="76" Header="Out (s)">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type ed:ChaserStepRowViewModel}">
                                    <c:CommitTextBox
                                        AutomationProperties.Name="Fade out, seconds"
                                        Style="{StaticResource SecondsCell}"
                                        Text="{Binding FadeOutText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoSteps, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Kind="Chaser"
                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                        Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No steps" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="Click Add and pick the scenes to chase." />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
