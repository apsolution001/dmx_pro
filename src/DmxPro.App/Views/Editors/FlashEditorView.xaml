<UserControl
    x:Class="DmxPro.App.Views.Editors.FlashEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=ed:FlashEditorViewModel}"
    d:DesignHeight="320"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <!--
        Flash editor (DataContext: FlashEditorViewModel). Left: fixtures; right: a dense form, no headings.

        ┌ Fixtures ┐║┌──────────────────────────────────────────────┐
        │          │║│ Colour    (presets, swatch, R / G / B)       │
        │          │║│ Time (s)  [0]  0 = on while held             │
        │          │║│           [x] Use white channel              │
        └──────────┘║└──────────────────────────────────────────────┘
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="300"
                MinWidth="200"
                MaxWidth="560" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <edv:FixtureListPanel DataContext="{Binding Fixtures}" />

        <GridSplitter
            Grid.Column="1"
            AutomationProperties.Name="Resize fixture list"
            Style="{StaticResource VerticalSplitter}" />

        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid
                    MaxWidth="560"
                    Margin="8,4"
                    HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Dmx.FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,4,8,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource FormLabel}"
                        Text="Colour"
                        ToolTip="Flash colour, at full brightness" />
                    <edv:ColorEditorView
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        DataContext="{Binding ColorEditor}" />

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource FormLabel}"
                        Text="Time (s)" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <ui:NumberBox
                            Width="112"
                            AutomationProperties.Name="Duration, seconds; 0 means while held"
                            LargeChange="1"
                            MaxDecimalPlaces="2"
                            Maximum="3600"
                            Minimum="0"
                            SmallChange="0.1"
                            Style="{StaticResource FormNumberBox}"
                            ToolTip="0 = while the button is held; more = goes off by itself after that time"
                            Value="{Binding DurationSeconds, Mode=TwoWay}" />
                        <TextBlock
                            Margin="8,0,0,4"
                            VerticalAlignment="Center"
                            Style="{StaticResource StatusText}"
                            Text="{Binding DurationHint}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        AutomationProperties.Name="Use the white channel"
                        Content="Use white channel"
                        IsChecked="{Binding UseWhiteChannel}"
                        ToolTip="On: the white part of the colour goes to the fixture's White channel. Off: white is mixed from red, green and blue." />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
