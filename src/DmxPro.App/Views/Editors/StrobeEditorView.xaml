<UserControl
    x:Class="DmxPro.App.Views.Editors.StrobeEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:edv="clr-namespace:DmxPro.App.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=ed:StrobeEditorViewModel}"
    d:DesignHeight="480"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <!--
        Strobe editor (DataContext: StrobeEditorViewModel), laid out like the scene editor: two tabs in the editor's tab
        strip (EditorTabControl from FunctionEditorPanel). Opens on "Strobe" when the strobe has lights, else on
        "Lights". Ctrl+L = Choose lights anywhere in the editor; Ctrl+Tab switches tabs.

        Safety rule 8, all visible on the Strobe tab (icon + text, not colour alone), live with Settings changes:
        the photosensitivity note (always), a caution bar while Settings > "Allow strobe" is off (the lights then stay
        steady), the Settings speed limit next to the speed, a "slowed down" note when the speed is above it, and — for
        the light's own strobe — that the limit cannot be checked there. The engine enforces the limits. The on-screen
        preview is a still picture on purpose: nothing flashes on screen.

        [Lights 3] [Strobe]
        ┌───────────────────────────────────────────────────────────────┬ Preview (on screen) ────┐
        │ ⚠ Photosensitivity warning: strobes can trigger seizures …    │ (●) ▐▌ ▐▌ ▐▌ ▐▌ ▐▌      │
        │ ⚠ Strobe is turned off in Settings: lights stay steady …      │ One second: 5 flashes … │
        │ ▌The lights flash on and off very fast.                       │                         │
        │ Colour       (●)(●)(●)… [██] White [Custom ▾]                 │                         │
        │ How it flashes  [DMX Pro flashes the lights] [Light's own strobe]                      │
        │ Speed        [Slow][Medium][Fast] [5.00] per second  Settings limit: 10 per second     │
        │              ⚠ Slowed down: …                                 │                         │
        │ Flash length [Short][Normal][Long] [50] %                     │                         │
        │ (own strobe) Strobe channel value  (•) From the light's profile  ( ) Exact ──●── [0]   │
        │ [x] Use white channel                                         │                         │
        └───────────────────────────────────────────────────────────────┴─────────────────────────┘
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EffectEditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding Fixtures.ChooseLightsCommand}" Gesture="Ctrl+L" />
    </UserControl.InputBindings>

    <TabControl
        AutomationProperties.Name="Strobe editor tabs"
        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
        Style="{DynamicResource EditorTabControl}">

        <!-- ═════════════ Lights ═════════════ -->
        <TabItem AutomationProperties.Name="Lights">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Kind="Fixtures"
                        Size="{StaticResource Dmx.DenseIconSize}" />
                    <TextBlock VerticalAlignment="Center" Text="Lights" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource Dmx.FontSize.Small}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Fixtures.Items.Count}" />
                </StackPanel>
            </TabItem.Header>
            <edv:FixtureListPanel DataContext="{Binding Fixtures}" />
        </TabItem>

        <!-- ═════════════ Strobe settings ═════════════ -->
        <TabItem AutomationProperties.Name="Strobe settings">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Kind="Strobe"
                        Size="{StaticResource Dmx.DenseIconSize}" />
                    <TextBlock VerticalAlignment="Center" Text="Strobe" />
                    <!-- Strobe off in Settings: say so on the tab too (icon, not colour alone). -->
                    <c:DmxIcon
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Strobe is turned off in Settings"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Kind="Warning"
                        Size="{StaticResource Dmx.DenseIconSize}"
                        ToolTip="Strobe is turned off in Settings: these lights stay steady"
                        Visibility="{Binding IsStrobeDisabled, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </TabItem.Header>

            <Border Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="400" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            MaxWidth="660"
                            Margin="8,6"
                            HorizontalAlignment="Left">

                            <!-- Always visible: photosensitivity note. -->
                            <Border
                                AutomationProperties.Name="Photosensitivity warning: flashing light can trigger seizures in people with photosensitive epilepsy"
                                Style="{StaticResource CautionBar}"
                                ToolTip="Flashing light can trigger seizures in people with photosensitive epilepsy. Warn your audience and keep strobes short and slow.">
                                <DockPanel>
                                    <c:DmxIcon Kind="Warning" Style="{StaticResource CautionIcon}" />
                                    <TextBlock Text="Photosensitivity warning: strobes can trigger seizures. Warn your audience and keep strobes short and slow." TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- Settings > Allow strobe is off. -->
                            <Border
                                AutomationProperties.Name="Strobe is turned off in Settings; these lights stay on steady instead of flashing"
                                Style="{StaticResource CautionBar}"
                                ToolTip="Settings, Safety: turn on &quot;Allow strobe&quot; to let it flash."
                                Visibility="{Binding IsStrobeDisabled, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <c:DmxIcon Kind="Strobe" Style="{StaticResource CautionIcon}" />
                                    <TextBlock TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="Strobe is turned off in Settings." />
                                        <Run Text="These lights stay on steady instead of flashing. Turn on &quot;Allow strobe&quot; in Settings (Safety) to let them flash." />
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource EffectExplanation}">
                                <DockPanel>
                                    <c:DmxIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Kind="Strobe"
                                        Size="{StaticResource Dmx.SmallIconSize}" />
                                    <TextBlock Text="The lights flash on and off very fast, like a camera flash going off again and again." TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- Empty state: no lights yet. -->
                            <Border Style="{StaticResource EffectNoLightsBar}" Visibility="{Binding HasNoFixtures, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="Choose lights"
                                        Command="{Binding Fixtures.ChooseLightsCommand}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ToolbarLabelButton}"
                                        ToolTip="Pick single lights or whole groups (Ctrl+L)">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Choose lights…" />
                                        </StackPanel>
                                    </Button>
                                    <c:DmxIcon
                                        VerticalAlignment="Center"
                                        Kind="Info"
                                        Style="{StaticResource CautionIcon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="No lights chosen yet: this strobe does nothing until you pick some."
                                        TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- ═════ Colour ═════ -->
                            <TextBlock Style="{StaticResource EffectSection}" Text="Colour" />
                            <edv:ColorEditorView DataContext="{Binding ColorEditor}" />

                            <!-- ═════ How it flashes ═════ -->
                            <TextBlock Style="{StaticResource EffectSection}" Text="How it flashes" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    AutomationProperties.Name="DMX Pro flashes the lights"
                                    Content="DMX Pro flashes the lights"
                                    GroupName="StrobeMode"
                                    IsChecked="{Binding IsSoftwareMode, Mode=TwoWay}"
                                    Style="{StaticResource EffectChoiceButton}"
                                    ToolTip="Works on every light; the speed is exact and the Settings limit applies" />
                                <RadioButton
                                    AutomationProperties.Name="The light's own strobe"
                                    Content="The light's own strobe"
                                    GroupName="StrobeMode"
                                    IsChecked="{Binding IsHardwareMode, Mode=TwoWay}"
                                    Style="{StaticResource EffectChoiceButton}"
                                    ToolTip="Uses each light's own Strobe channel; lights without one are flashed by DMX Pro" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,3,0,0"
                                Style="{StaticResource HintText}"
                                Text="{Binding ModeHint}" />

                            <!-- ═════ Speed ═════ -->
                            <TextBlock Style="{StaticResource EffectSection}" Text="Speed" />
                            <WrapPanel>
                                <ItemsControl
                                    AutomationProperties.Name="Speed presets"
                                    ItemsSource="{Binding SpeedPresets.Choices}"
                                    Style="{StaticResource EffectChoiceRow}" />
                                <ui:NumberBox
                                    AutomationProperties.Name="Flashes per second"
                                    Maximum="{x:Static ed:StrobeEditorViewModel.MaxRateHz}"
                                    Minimum="{x:Static ed:StrobeEditorViewModel.MinRateHz}"
                                    SmallChange="0.5"
                                    Style="{StaticResource EffectSecondsBox}"
                                    ToolTip="Exact number of flashes per second"
                                    Value="{Binding RateHz, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource EffectUnitText}" Text="per second" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding MaxRateText}"
                                    Style="{StaticResource StatusText}"
                                    Text="{Binding MaxRateText}"
                                    ToolTip="The highest strobe speed is set in Settings (Safety); faster strobes are slowed down to it" />
                            </WrapPanel>
                            <Border
                                Margin="0,4,0,0"
                                AutomationProperties.Name="{Binding RateCapText}"
                                Style="{StaticResource CautionBar}"
                                Visibility="{Binding ShowRateCap, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <c:DmxIcon Kind="Warning" Style="{StaticResource CautionIcon}" />
                                    <TextBlock Text="{Binding RateCapText}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- ═════ Flash length (duty cycle) ═════ -->
                            <TextBlock Style="{StaticResource EffectSection}" Text="Flash length" />
                            <WrapPanel>
                                <ItemsControl
                                    AutomationProperties.Name="Flash length presets"
                                    ItemsSource="{Binding LengthPresets.Choices}"
                                    Style="{StaticResource EffectChoiceRow}" />
                                <ui:NumberBox
                                    Width="96"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Flash length, percent of the time on"
                                    Maximum="{Binding MaxDutyPercent}"
                                    Minimum="{Binding MinDutyPercent}"
                                    Style="{StaticResource FormNumberBox}"
                                    ToolTip="Part of each flash the light is on, 5–95 %"
                                    Value="{Binding DutyPercent, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource EffectUnitText}" Text="% on" />
                            </WrapPanel>

                            <!-- ═════ The light's own strobe only: the raw Strobe channel value ═════ -->
                            <StackPanel Visibility="{Binding IsHardwareMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource EffectSection}" Text="Strobe channel value" />
                                <RadioButton
                                    Margin="0,0,0,3"
                                    AutomationProperties.Name="Strobe value from the light's profile"
                                    Content="From the light's profile (usually its slowest strobe)"
                                    GroupName="StrobeHardwareValue"
                                    IsChecked="{Binding UseProfileHardwareValue, Mode=TwoWay}"
                                    ToolTip="The first strobe value in the light's profile, usually the slowest" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Exact strobe value"
                                        Content="Exact value:"
                                        GroupName="StrobeHardwareValue"
                                        IsChecked="{Binding UsesCustomHardwareValue, Mode=TwoWay}"
                                        ToolTip="Type the value from the light's manual (DMX chart)" />
                                    <Slider
                                        Grid.Column="1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Strobe channel value, 0 to 255"
                                        IsEnabled="{Binding UsesCustomHardwareValue}"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="255"
                                        Minimum="0"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        Value="{Binding HardwareValue}" />
                                    <c:DmxValueBox
                                        Grid.Column="2"
                                        Width="48"
                                        MinHeight="{StaticResource Dmx.ControlHeight}"
                                        Height="{StaticResource Dmx.ControlHeight}"
                                        Padding="{StaticResource Dmx.TextControlPadding}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Strobe channel value"
                                        IsEnabled="{Binding UsesCustomHardwareValue}"
                                        ToolTip="Raw 0–255 value from the light's manual · Enter applies · ↑/↓ ±1 · PageUp/PageDown ±10"
                                        Value="{Binding HardwareValue}" />
                                </Grid>
                                <Border
                                    Margin="0,6,0,0"
                                    AutomationProperties.Name="{Binding HardwareLimitText}"
                                    Style="{StaticResource CautionBar}">
                                    <DockPanel>
                                        <c:DmxIcon Kind="Warning" Style="{StaticResource CautionIcon}" />
                                        <TextBlock Text="{Binding HardwareLimitText}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <CheckBox
                                Margin="0,8,0,0"
                                AutomationProperties.Name="Use the white channel"
                                Content="Use white channel"
                                IsChecked="{Binding UseWhiteChannel}"
                                ToolTip="On: the white part of the colour goes to the light's White channel. Off: white is mixed from red, green and blue." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═════ On-screen preview: a still picture, never flashing ═════ -->
                    <Border Grid.Column="1" Style="{StaticResource EffectPreviewPanel}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                <TextBlock
                                    Style="{StaticResource PanelTitle}"
                                    Text="Preview (on screen)"
                                    ToolTip="One second of the strobe as the lights will really do it (Settings limits included). The real lights show your changes too while this editor is open." />
                            </Border>
                            <StackPanel Margin="8,6">
                                <edv:EffectPreviewGraph
                                    Height="56"
                                    AutomationProperties.Name="{Binding PreviewCaption}"
                                    GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    IsAnimated="False"
                                    LightColor="{Binding PreviewColorHex}"
                                    LineBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                    MarkerBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    Points="{Binding PreviewPoints}"
                                    WindowSeconds="1" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource HintText}"
                                    Text="{Binding PreviewCaption}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource HintText}"
                                    Text="Shown as a still picture on purpose: flashing on screen can be unsafe too." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
