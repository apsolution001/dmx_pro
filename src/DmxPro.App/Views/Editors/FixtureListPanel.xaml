<UserControl
    x:Class="DmxPro.App.Views.Editors.FixtureListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="clr-namespace:DmxPro.App.ViewModels.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=ed:FixtureListEditorViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="320"
    mc:Ignorable="d">
    <!--
        "Lights" panel of the sequence and effect editors (DataContext: FixtureListEditorViewModel). The lights the
        function drives, in order, one dense line each (QLC+-style). "Choose lights…" opens the modal Choose lights
        dialog (FixturePickerWindow: single lights with Shift/Ctrl multi-select, or whole groups).
        Del removes the selected light, Ctrl+Up / Ctrl+Down move it (Alt+Up / Alt+Down too), Ctrl+L opens the dialog.
        A deleted light stays listed as "(deleted light)" with a warning icon so it can be removed.
        Empty: icon, "No lights yet", a sentence and a Choose lights… button.

        ┌ Lights · 3 lights       [+ Choose lights…][-][↑][↓] ┐
        │ 1  PAR 1   U1 · 1–8 · Generic RGBW                        │
        │ 2  PAR 2   U1 · 9–16 · Generic RGBW                       │
        └───────────────────────────────────────────────────────────┘
    -->
    <UserControl.Resources>
        <!-- Labelled button in a panel header: as high as PanelHeaderButton. -->
        <Style
            x:Key="HeaderLabelButton"
            BasedOn="{StaticResource ToolbarLabelButton}"
            TargetType="Button">
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding ChooseLightsCommand}" Gesture="Ctrl+L" />
    </UserControl.InputBindings>

    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="Choose lights"
                            Command="{Binding ChooseLightsCommand}"
                            Style="{StaticResource HeaderLabelButton}"
                            ToolTip="Choose the lights this function uses: single lights (click, Shift+click, Ctrl+click) or whole groups (Ctrl+L)">
                            <StackPanel Orientation="Horizontal">
                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Text="Choose lights…" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="Remove selected light"
                            Command="{Binding RemoveSelectedCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Remove the selected light from this function (Del)">
                            <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Move light up"
                            Command="{Binding MoveUpCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Move up: earlier in the order (Ctrl+Up)">
                            <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Move light down"
                            Command="{Binding MoveDownCommand}"
                            Style="{StaticResource PanelHeaderButton}"
                            ToolTip="Move down: later in the order (Ctrl+Down)">
                            <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.DenseIconSize}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Lights" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource StatusText}"
                            Text="{Binding CountText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <ListBox
                    AutomationProperties.Name="Lights used, in order"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.InputBindings>
                        <KeyBinding Command="{Binding RemoveSelectedCommand}" Gesture="Delete" />
                        <KeyBinding Command="{Binding MoveUpCommand}" Gesture="Ctrl+Up" />
                        <KeyBinding Command="{Binding MoveDownCommand}" Gesture="Ctrl+Down" />
                        <KeyBinding Command="{Binding MoveUpCommand}" Gesture="Alt+Up" />
                        <KeyBinding Command="{Binding MoveDownCommand}" Gesture="Alt+Down" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            <Setter Property="ToolTip" Value="{Binding Detail}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type ed:FixtureListItem}">
                            <DockPanel>
                                <TextBlock
                                    MinWidth="20"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding Number}" />
                                <c:DmxIcon
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Deleted light"
                                    DockPanel.Dock="Right"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Kind="Warning"
                                    Size="{StaticResource Dmx.DenseIconSize}"
                                    ToolTip="This light was deleted from the patch; it is skipped. Remove it here (Del)."
                                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Kind="Fixtures"
                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                        Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No lights yet" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="Pick the lights this function uses: single lights or whole groups." />
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Choose lights"
                        Command="{Binding ChooseLightsCommand}"
                        Style="{StaticResource ToolbarPrimaryButton}"
                        ToolTip="Choose the lights this function uses (Ctrl+L)">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Choose lights…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
