<UserControl
    x:Class="DmxPro.App.Views.ShowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ShowsViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <!--
        Shows page (ui-plan §3.6): page toolbar (with the show transport), timeline (fixed track headers + scrolling
        lanes; ruler, beat row and the audio lane synced to the lanes' scroll position), and Properties + Function
        library docked BELOW the timeline. Ruler, beat grid and waveform are drawn controls that render only around the
        visible part; the playhead moves by a transform, so playback never re-lays out the timeline.
        Audio lane: 40 px (both row definitions and the playhead line, which starts below ruler 18 + beats 12 = 30).
        Mouse handling (drag to move/resize, range selection, library drag-and-drop, Ctrl+wheel zoom) lives in the
        code-behind and only converts pixels to seconds before calling ShowsViewModel.
        Edit (button, Enter or double-click on a block) opens the shared function editor of the block's type over the
        timeline area, for the show's own copy. Close (Esc) returns to the timeline.
    -->
    <UserControl.Resources>
        <!-- Labelled field in the compact two-column property forms below the timeline. -->
        <Style x:Key="ShowsFieldLabel" BasedOn="{StaticResource FormLabel}" TargetType="TextBlock" />

        <Style x:Key="ShowsSecondsBox" BasedOn="{StaticResource FormNumberBox}" TargetType="ui:NumberBox">
            <Setter Property="MaxDecimalPlaces" Value="3" />
            <Setter Property="SmallChange" Value="0.1" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="Minimum" Value="0" />
        </Style>

        <!-- Toolbar text (Snap / Zoom captions, time display). -->
        <Style x:Key="ShowsToolbarCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Small icon button inside a track header (fits the compact track height). -->
        <Style x:Key="ShowsTrackButton" BasedOn="{StaticResource PanelHeaderButton}" TargetType="Button">
            <Setter Property="Width" Value="{x:Static vm:ShowsViewModel.ItemHeight}" />
            <Setter Property="Height" Value="{x:Static vm:ShowsViewModel.ItemHeight}" />
        </Style>

        <Style x:Key="ShowsCompactListItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
        </Style>

        <!-- Fast rewind / forward: press = one seek step, hold = repeated jumps every 150 ms (accelerating, code-behind). -->
        <Style x:Key="ShowsRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template" Value="{StaticResource Dmx.SubtleButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="{StaticResource Dmx.ToolbarButtonSize}" />
            <Setter Property="Height" Value="{StaticResource Dmx.ToolbarButtonSize}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="c:DmxIcon.MaxSize" Value="{StaticResource Dmx.ToolbarIconSize}" />
            <Setter Property="Delay" Value="300" />
            <Setter Property="Interval" Value="150" />
        </Style>

        <!-- Transport glyphs not in the icon set (24x24 box, like Themes/Icons.xaml). -->
        <Geometry x:Key="ShowsRewindGeometry">M11,6 L11,18 L3,12 Z M20,6 L20,18 L12,12 Z</Geometry>
        <Geometry x:Key="ShowsForwardGeometry">M4,6 L4,18 L12,12 Z M13,6 L13,18 L21,12 Z</Geometry>
        <Geometry x:Key="ShowsFollowGeometry">M6,3 L8,3 L8,21 L6,21 Z M11,7 L19,12 L11,17 Z</Geometry>

        <!-- Overlay message on the audio lane (status, progress): opaque so it reads over the waveform. -->
        <Style x:Key="ShowsLaneBadge" TargetType="Border">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Dmx.CornerRadius}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═════════════ Page toolbar (disabled while the scene editor is open) ═════════════ -->
        <Border
            DockPanel.Dock="Top"
            IsEnabled="{Binding IsNotEditing}"
            Style="{StaticResource PageToolbar}">
            <DockPanel LastChildFill="False">
                <Button
                    AutomationProperties.Name="New function for selection"
                    Command="{Binding CreateFunctionForRangeCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarPrimaryButton}"
                    ToolTip="Create a new function for the selected time range (drag across an empty part of a track first); pick its type in Properties">
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="New function for selection" />
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <!-- Show picker, swapped for a text box while renaming. -->
                    <Grid Width="160" VerticalAlignment="Center">
                        <!-- Entries show a warning mark when a show's music is missing or broken (safety rule 10). -->
                        <ComboBox
                            Margin="0"
                            AutomationProperties.Name="Show"
                            IsEnabled="{Binding HasShows}"
                            ItemsSource="{Binding ShowChoices}"
                            SelectedItem="{Binding SelectedShowChoice}"
                            Style="{StaticResource FormComboBox}"
                            ToolTip="Show being edited"
                            Visibility="{Binding IsNotRenamingShow, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShowAudioPickerItem}">
                                    <DockPanel ToolTip="{Binding ToolTip}">
                                        <c:DmxIcon
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Music problem"
                                            DockPanel.Dock="Right"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Kind="Warning"
                                            Size="{StaticResource Dmx.DenseIconSize}"
                                            Visibility="{Binding HasMusicProblem, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox
                            Height="{StaticResource Dmx.ControlHeight}"
                            Padding="{StaticResource Dmx.TextControlPadding}"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Show name"
                            IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                            LostKeyboardFocus="OnShowRenameBoxLostKeyboardFocus"
                            Text="{Binding ShowEditName, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsRenamingShow, Converter={StaticResource BoolToVisibility}}">
                            <TextBox.InputBindings>
                                <KeyBinding Command="{Binding CommitRenameShowCommand}" Gesture="Enter" />
                                <KeyBinding Command="{Binding CancelRenameShowCommand}" Gesture="Escape" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                    <Button
                        Margin="4,0,1,0"
                        AutomationProperties.Name="New show"
                        Command="{Binding NewShowCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="New show">
                        <c:DmxIcon Kind="New" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Rename show"
                        Command="{Binding BeginRenameShowCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Rename show">
                        <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Delete show"
                        Command="{Binding DeleteShowCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Delete show">
                        <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <!--
                        Transport: plays the show through the same player as the Virtual Console (one player show at a
                        time; starting this one stops another); lights and music follow play / pause / seek.
                    -->
                    <Button
                        AutomationProperties.Name="Play or pause"
                        Command="{Binding PlayPauseCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="{Binding PlayPauseToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <c:DmxIcon Kind="{Binding PlayPauseIcon}" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Stop"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Stop: the lights release and the playhead returns to where Play started (press again for 0:00)">
                        <c:DmxIcon Kind="Stop" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <RepeatButton
                        AutomationProperties.Name="Rewind"
                        Click="OnRewindClick"
                        IsEnabled="{Binding CanControlTransport}"
                        Style="{StaticResource ShowsRepeatButton}"
                        ToolTip="Rewind by the seek step (Settings); hold to keep going faster">
                        <c:DmxIcon Data="{StaticResource ShowsRewindGeometry}" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </RepeatButton>
                    <RepeatButton
                        AutomationProperties.Name="Fast forward"
                        Click="OnForwardClick"
                        IsEnabled="{Binding CanControlTransport}"
                        Style="{StaticResource ShowsRepeatButton}"
                        ToolTip="Fast forward by the seek step (Settings); hold to keep going faster">
                        <c:DmxIcon Data="{StaticResource ShowsForwardGeometry}" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </RepeatButton>
                    <!-- Fixed width: the time changes ~30 times a second while playing and must not re-layout the toolbar. -->
                    <TextBlock
                        Width="56"
                        Margin="6,0,4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Playhead time"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="{StaticResource Dmx.FontSize.Body}"
                        Text="{Binding PlayheadText}"
                        TextAlignment="Right"
                        ToolTip="{Binding TransportStateText}" />
                    <TextBlock
                        Style="{StaticResource ShowsToolbarCaption}"
                        Text="{Binding LengthText}"
                        ToolTip="Show length (change it in Properties when nothing is selected)" />
                    <ToggleButton
                        AutomationProperties.Name="Follow playhead"
                        IsChecked="{Binding FollowPlayhead}"
                        Style="{StaticResource ToolbarToggleButton}"
                        ToolTip="Follow the playhead: scroll the timeline while the show plays">
                        <c:DmxIcon Data="{StaticResource ShowsFollowGeometry}" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <TextBlock Style="{StaticResource ShowsToolbarCaption}" Text="Snap" />
                    <ComboBox
                        MinWidth="96"
                        Margin="0"
                        AutomationProperties.Name="Snap"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding SnapOptions}"
                        SelectedItem="{Binding SelectedSnap}"
                        Style="{StaticResource FormComboBox}"
                        ToolTip="Snap item edges, selections and the song (Beat and Bar use the show's BPM, counted from its first beat)" />
                    <TextBlock
                        Margin="8,0,6,0"
                        Style="{StaticResource ShowsToolbarCaption}"
                        Text="Zoom" />
                    <Slider
                        Width="96"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Zoom"
                        LargeChange="20"
                        Maximum="{x:Static vm:ShowsViewModel.MaxZoom}"
                        Minimum="{x:Static vm:ShowsViewModel.MinZoom}"
                        SmallChange="5"
                        ToolTip="Zoom (Ctrl + mouse wheel on the timeline)"
                        Value="{Binding PixelsPerSecond}" />

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button
                        AutomationProperties.Name="Add track"
                        Command="{Binding AddTrackCommand}"
                        Style="{StaticResource ToolbarLabelButton}"
                        ToolTip="Add a track to this show">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Track" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Add or replace music"
                        Command="{Binding Music.AddMusicCommand}"
                        Style="{StaticResource ToolbarLabelButton}"
                        ToolTip="Add music to this show, or replace its song (MP3, WAV, M4A / AAC, FLAC). You can also drop a music file on the audio lane.">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Music" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Music" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            Live mode (Ctrl+F5): the whole transport (play, pause, stop, seek) is disabled here and the playhead only
            follows the Virtual Console. Own thin strip so the toolbar never shifts; neutral info style like the Test
            page banner, not a warning.
        -->
        <Border
            Padding="6,3"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            ToolTip="Live mode is on: only the Virtual Console drives the lights. Play, pause, stop and seeking are off here and the playhead only follows the console; editing the timeline still works. Leave live mode (Ctrl+F5) to play shows from here."
            Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <c:DmxIcon
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Kind="Info"
                    Size="{StaticResource Dmx.DenseIconSize}" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static vm:ShowsViewModel.LiveModeHint}"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Result of "Save as function…" (closable). -->
        <ui:InfoBar
            Margin="2,2,2,0"
            DockPanel.Dock="Top"
            IsClosable="True"
            IsOpen="{Binding IsNoticeOpen, Mode=TwoWay}"
            Message="{Binding NoticeMessage}"
            Severity="Success"
            Visibility="{Binding IsNoticeOpen, Converter={StaticResource BoolToVisibility}}" />

        <Grid>
            <!-- ═════════════ Empty state: no shows ═════════════ -->
            <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoShows, Converter={StaticResource BoolToVisibility}}">
                <c:DmxIcon
                    Kind="Timeline"
                    Size="{StaticResource Dmx.EmptyStateIconSize}"
                    Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No shows yet" />
                <TextBlock Style="{StaticResource EmptyStateText}" Text="A show places functions on a timeline. Create one, then drag functions onto its tracks." />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="New show"
                    Command="{Binding NewShowCommand}"
                    Style="{StaticResource ToolbarPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="New show" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ═════════════ Function editor for a show's own copy (covers the timeline while open) ═════════════ -->
            <Border
                Margin="{StaticResource Dmx.PageBodyMargin}"
                Style="{StaticResource PanelBorder}"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <views:FunctionEditorPanel DataContext="{Binding Editor}" />
            </Border>

            <Grid Margin="{StaticResource Dmx.PageBodyMargin}" Visibility="{Binding IsTimelineVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="196" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- ═════════════ Timeline ═════════════ -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid x:Name="TimelineRoot">
                        <Grid.InputBindings>
                            <KeyBinding Command="{Binding DeleteSelectedItemCommand}" Gesture="Delete" />
                            <KeyBinding Command="{Binding DuplicateSelectedItemCommand}" Gesture="Ctrl+D" />
                            <KeyBinding Command="{Binding EditSelectedItemCommand}" Gesture="Enter" />
                            <KeyBinding Command="{Binding ClearSelectionCommand}" Gesture="Escape" />
                            <KeyBinding Command="{Binding PlayPauseCommand}" Gesture="Space" />
                            <KeyBinding Command="{Binding GoToStartCommand}" Gesture="Home" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header column: ruler and beat captions. -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="8,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Dmx.FontSize.Caption}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Time" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="8,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,1">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Dmx.FontSize.Caption}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding BpmText}"
                                ToolTip="Beat grid tempo (Properties when nothing is selected)" />
                        </Border>

                        <!-- Audio lane header: song name, status, music actions. -->
                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Padding="6,0,1,0"
                            AllowDrop="True"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,1"
                            DragLeave="OnAudioLaneDragLeave"
                            DragOver="OnAudioLaneDragOver"
                            Drop="OnAudioLaneDrop"
                            ToolTip="{Binding Music.FilePathText}">
                            <DockPanel>
                                <Button
                                    x:Name="MusicMenuButton"
                                    AutomationProperties.Name="Music actions"
                                    Click="OnMusicMenuButtonClick"
                                    DockPanel.Dock="Right"
                                    IsEnabled="{Binding HasShow}"
                                    Style="{StaticResource ShowsTrackButton}"
                                    ToolTip="Music: add, replace, relink, remove, collect into the project folder">
                                    <c:DmxIcon Kind="More" Size="{StaticResource Dmx.DenseIconSize}" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding Music.AddMusicCommand}" Header="{Binding Music.AddMusicHeader}">
                                                <MenuItem.Icon>
                                                    <c:DmxIcon Kind="Music" Size="{StaticResource Dmx.SmallIconSize}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Command="{Binding Music.RelinkMusicCommand}" Header="Relink music…">
                                                <MenuItem.Icon>
                                                    <c:DmxIcon Kind="Open" Size="{StaticResource Dmx.SmallIconSize}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Command="{Binding Music.RemoveMusicCommand}" Header="Remove music…">
                                                <MenuItem.Icon>
                                                    <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.SmallIconSize}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Command="{Binding Music.CollectMusicCommand}" Header="Collect music into project folder…">
                                                <MenuItem.Icon>
                                                    <c:DmxIcon Kind="Folder" Size="{StaticResource Dmx.SmallIconSize}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Grid
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left">
                                    <c:DmxIcon
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Kind="Music"
                                        Size="{StaticResource Dmx.DenseIconSize}">
                                        <c:DmxIcon.Style>
                                            <Style TargetType="c:DmxIcon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Music.HasProblem}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:DmxIcon.Style>
                                    </c:DmxIcon>
                                    <c:DmxIcon
                                        AutomationProperties.Name="Music problem"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Kind="Warning"
                                        Size="{StaticResource Dmx.DenseIconSize}"
                                        ToolTip="{Binding Music.StatusText}"
                                        Visibility="{Binding Music.HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    FontWeight="SemiBold"
                                    Text="{Binding Music.LaneTitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <!-- Ruler, beat row and audio lane: scroll horizontally with the lanes (offset synced in code-behind). -->
                        <ScrollViewer
                            x:Name="RulerScroll"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            PreviewMouseWheel="OnLanePreviewMouseWheel"
                            VerticalScrollBarVisibility="Disabled">
                            <Grid
                                x:Name="RulerHost"
                                Width="{Binding TimelineWidth}"
                                HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <!-- Ruler: click or drag to move the playhead (seeks when playing). -->
                                <Grid
                                    x:Name="RulerArea"
                                    Grid.RowSpan="2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    LostMouseCapture="OnRulerLostMouseCapture"
                                    MouseLeftButtonDown="OnRulerMouseLeftButtonDown"
                                    MouseLeftButtonUp="OnRulerMouseLeftButtonUp"
                                    MouseMove="OnRulerMouseMove">
                                    <!-- Live mode: the ruler does not seek (only the Virtual Console controls playback). -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="Click to move the playhead: when playing, the show jumps there; when stopped, Play starts there" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Setter Property="ToolTip" Value="{x:Static vm:ShowsViewModel.LiveModeHint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="12" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.RowSpan="2"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" />
                                    <c:TimelineRuler
                                        Grid.Row="0"
                                        FontSize="{StaticResource Dmx.FontSize.Caption}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        PixelsPerSecond="{Binding PixelsPerSecond}"
                                        TickBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                        ViewportStart="{Binding HorizontalOffset, ElementName=LaneScroll}"
                                        ViewportWidth="{Binding ViewportWidth, ElementName=LaneScroll}" />
                                    <!-- Beat / bar marks from the show's tempo and first beat, drawn in one pass. -->
                                    <c:TimelineBeatMarks
                                        Grid.Row="1"
                                        BarBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        BarHeight="10"
                                        BarTop="1"
                                        BarWidth="2"
                                        BeatBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                        BeatHeight="6"
                                        BeatOffsetSeconds="{Binding GridOffsetSeconds}"
                                        BeatTop="3"
                                        BeatWidth="1"
                                        Bpm="{Binding GridBpm}"
                                        PixelsPerSecond="{Binding PixelsPerSecond}"
                                        ViewportStart="{Binding HorizontalOffset, ElementName=LaneScroll}"
                                        ViewportWidth="{Binding ViewportWidth, ElementName=LaneScroll}" />
                                </Grid>

                                <!-- Audio lane: the song block (drag to move the song in time), waveform, shaded silence. Drop a music file here. -->
                                <Grid
                                    x:Name="AudioLane"
                                    Grid.Row="2"
                                    AllowDrop="True"
                                    AutomationProperties.Name="Audio lane"
                                    Background="Transparent"
                                    DragLeave="OnAudioLaneDragLeave"
                                    DragOver="OnAudioLaneDragOver"
                                    Drop="OnAudioLaneDrop"
                                    LostMouseCapture="OnAudioLaneLostMouseCapture"
                                    MouseLeftButtonDown="OnAudioLaneMouseLeftButtonDown"
                                    MouseLeftButtonUp="OnAudioLaneMouseLeftButtonUp"
                                    MouseMove="OnAudioLaneMouseMove">
                                    <c:TimelineBeatMarks
                                        BarBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BeatOffsetSeconds="{Binding GridOffsetSeconds}"
                                        Bpm="{Binding GridBpm}"
                                        PixelsPerSecond="{Binding PixelsPerSecond}"
                                        ViewportStart="{Binding HorizontalOffset, ElementName=LaneScroll}"
                                        ViewportWidth="{Binding ViewportWidth, ElementName=LaneScroll}" />
                                    <c:WaveformView
                                        x:Name="Waveform"
                                        BlockBorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                        BlockBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        DurationSeconds="{Binding Music.LaneDurationSeconds}"
                                        OffsetSeconds="{Binding Music.LaneOffsetSeconds}"
                                        Peaks="{Binding Music.Peaks}"
                                        PeaksPerSecond="{Binding Music.PeaksPerSecond}"
                                        PixelsPerSecond="{Binding PixelsPerSecond}"
                                        ShadeBrush="{DynamicResource SmokeFillColorDefaultBrush}"
                                        ViewportStart="{Binding HorizontalOffset, ElementName=LaneScroll}"
                                        ViewportWidth="{Binding ViewportWidth, ElementName=LaneScroll}"
                                        Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}">
                                        <c:WaveformView.Style>
                                            <Style TargetType="c:WaveformView">
                                                <Setter Property="WaveBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Music.IsMuted}" Value="True">
                                                        <Setter Property="WaveBrush" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:WaveformView.Style>
                                    </c:WaveformView>
                                    <Border
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        IsHitTestVisible="False" />
                                </Grid>

                                <!-- Playhead marker + line over ruler and audio lane: moved by a transform only (no layout per frame). -->
                                <Canvas
                                    Grid.RowSpan="3"
                                    HorizontalAlignment="Left"
                                    IsHitTestVisible="False">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="{Binding PlayheadX}" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M -5,0 L 5,0 L 0,7 Z" Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Rectangle
                                        Canvas.Top="30"
                                        Width="1"
                                        Height="40"
                                        Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- Audio lane overlays (not scrolled): empty state, music problem, analysis / collect progress. -->
                        <Grid Grid.Row="2" Grid.Column="1">
                            <StackPanel
                                Margin="8,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AllowDrop="True"
                                Background="Transparent"
                                DragLeave="OnAudioLaneDragLeave"
                                DragOver="OnAudioLaneDragOver"
                                Drop="OnAudioLaneDrop"
                                Orientation="Horizontal"
                                Visibility="{Binding Music.HasNoMusic, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HintText}"
                                    Text="No music. Drop a music file here, or" />
                                <Button
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Add music"
                                    Command="{Binding Music.AddMusicCommand}"
                                    Style="{StaticResource ToolbarLabelButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="Music" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Add music…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border
                                HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                Style="{StaticResource ShowsLaneBadge}"
                                Visibility="{Binding Music.HasProblem, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Kind="Warning"
                                        Size="{StaticResource Dmx.DenseIconSize}" />
                                    <TextBlock
                                        MaxWidth="520"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Text="{Binding Music.StatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Music.StatusText}" />
                                    <Button
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="Relink music"
                                        Command="{Binding Music.RelinkMusicCommand}"
                                        Style="{StaticResource ToolbarLabelButton}"
                                        ToolTip="Pick the music file at its new location (offset, volume and fade stay)">
                                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Relink…" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border
                                HorizontalAlignment="Right"
                                Style="{StaticResource ShowsLaneBadge}"
                                Visibility="{Binding Music.IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Text="Analysing music…" />
                                    <ProgressBar
                                        Width="80"
                                        Height="4"
                                        MinHeight="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Music analysis progress"
                                        Maximum="100"
                                        Value="{Binding Music.AnalysisProgress, Mode=OneWay}" />
                                    <Button
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Cancel music analysis"
                                        Command="{Binding Music.CancelAnalysisCommand}"
                                        Style="{StaticResource ShowsTrackButton}"
                                        ToolTip="Cancel the analysis (the song still plays; the waveform and tempo stay unknown)">
                                        <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border
                                HorizontalAlignment="Right"
                                Style="{StaticResource ShowsLaneBadge}"
                                Visibility="{Binding Music.IsCollecting, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="360"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Text="{Binding Music.CollectText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Cancel collecting music"
                                        Command="{Binding Music.CancelCollectCommand}"
                                        Style="{StaticResource ShowsTrackButton}"
                                        ToolTip="Stop copying (files already copied are linked)">
                                        <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.DenseIconSize}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Track headers: vertical offset synced with the lanes. -->
                        <!--
                            Right-click (or Shift+F10 / the menu key on a focused header): track menu like a video
                            editor timeline. Below the last header only "Add track".
                        -->
                        <ScrollViewer
                            x:Name="HeaderScroll"
                            Grid.Row="3"
                            Grid.Column="0"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="OnHeaderPreviewMouseWheel"
                            VerticalScrollBarVisibility="Hidden">
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding AddTrackCommand}" Header="Add track">
                                        <MenuItem.Icon>
                                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>
                            <Border
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0">
                                <!-- Bottom margin: room for the lanes' horizontal scroll bar, so both can reach the same offset. -->
                                <ItemsControl
                                    Margin="0,0,0,12"
                                    Focusable="False"
                                    ItemsSource="{Binding Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShowTrackViewModel}">
                                            <Border
                                                x:Name="Header"
                                                Height="{x:Static vm:ShowsViewModel.TrackHeight}"
                                                Padding="6,0,1,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Track {0}}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                                                Focusable="True"
                                                GotKeyboardFocus="OnTrackHeaderGotKeyboardFocus"
                                                PreviewMouseDown="OnTrackHeaderPreviewMouseDown"
                                                ToolTip="Right-click (or Shift+F10) for track actions · double-click or F2 to rename">
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding ActivateCommand}" Gesture="LeftClick" />
                                                    <MouseBinding Command="{Binding BeginRenameCommand}" Gesture="LeftDoubleClick" />
                                                    <KeyBinding Command="{Binding BeginRenameCommand}" Gesture="F2" />
                                                </Border.InputBindings>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Command="{Binding AddTrackAtEndCommand}" Header="Add track">
                                                            <MenuItem.Icon>
                                                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.SmallIconSize}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Command="{Binding InsertAboveCommand}" Header="Insert track above">
                                                            <MenuItem.Icon>
                                                                <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.SmallIconSize}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Command="{Binding InsertBelowCommand}" Header="Insert track below">
                                                            <MenuItem.Icon>
                                                                <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.SmallIconSize}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem
                                                            Command="{Binding BeginRenameCommand}"
                                                            Header="Rename"
                                                            InputGestureText="F2">
                                                            <MenuItem.Icon>
                                                                <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.SmallIconSize}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Command="{Binding DeleteCommand}" Header="Delete track">
                                                            <MenuItem.Icon>
                                                                <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <DockPanel>
                                                    <Button
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Delete track {0}}"
                                                        Command="{Binding DeleteCommand}"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource ShowsTrackButton}"
                                                        ToolTip="Delete track">
                                                        <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.DenseIconSize}" />
                                                    </Button>
                                                    <Button
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Rename track {0}}"
                                                        Command="{Binding BeginRenameCommand}"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource ShowsTrackButton}"
                                                        ToolTip="Rename track (double-click the name)">
                                                        <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.DenseIconSize}" />
                                                    </Button>
                                                    <c:DmxIcon
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Kind="Functions"
                                                        Size="{StaticResource Dmx.DenseIconSize}" />
                                                    <Grid VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding Name}"
                                                            Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBox
                                                            Height="{x:Static vm:ShowsViewModel.ItemHeight}"
                                                            MinHeight="0"
                                                            Padding="4,0"
                                                            VerticalContentAlignment="Center"
                                                            AutomationProperties.Name="Track name"
                                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                                            IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                                                            LostKeyboardFocus="OnTrackRenameBoxLostKeyboardFocus"
                                                            Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Command="{Binding CommitRenameCommand}" Gesture="Enter" />
                                                                <KeyBinding Command="{Binding CancelRenameCommand}" Gesture="Escape" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Header" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>

                        <!-- Lanes. Focusable so Del / Ctrl+D / Esc / Space reach the timeline after a click. -->
                        <ScrollViewer
                            x:Name="LaneScroll"
                            Grid.Row="3"
                            Grid.Column="1"
                            AutomationProperties.Name="Show timeline"
                            FocusVisualStyle="{x:Null}"
                            Focusable="True"
                            ContextMenuOpening="OnLaneContextMenuOpening"
                            HorizontalScrollBarVisibility="Auto"
                            PreviewMouseWheel="OnLanePreviewMouseWheel"
                            ScrollChanged="OnLaneScrollChanged"
                            VerticalScrollBarVisibility="Auto">
                            <!-- Block menu: only over a block (right-click selects it first), or Shift+F10 / menu key for the selected block. -->
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding EditSelectedItemCommand}"
                                        Header="Edit"
                                        InputGestureText="Enter">
                                        <MenuItem.Icon>
                                            <c:DmxIcon Kind="Edit" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding SaveSelectedItemAsFunctionCommand}" Header="Save as function…">
                                        <MenuItem.Icon>
                                            <c:DmxIcon Kind="SaveAs" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding DuplicateSelectedItemCommand}"
                                        Header="Duplicate"
                                        InputGestureText="Ctrl+D">
                                        <MenuItem.Icon>
                                            <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding DeleteSelectedItemCommand}"
                                        Header="Delete…"
                                        InputGestureText="Del">
                                        <MenuItem.Icon>
                                            <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>
                            <Grid
                                x:Name="LaneHost"
                                Width="{Binding TimelineWidth}"
                                MinHeight="{Binding ViewportHeight, ElementName=LaneScroll}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                AllowDrop="True"
                                Background="Transparent"
                                DragLeave="OnLaneDragLeave"
                                DragOver="OnLaneDragOver"
                                Drop="OnLaneDrop"
                                LostMouseCapture="OnLaneLostMouseCapture"
                                MouseLeftButtonDown="OnLaneMouseLeftButtonDown"
                                MouseLeftButtonUp="OnLaneMouseLeftButtonUp"
                                MouseMove="OnLaneMouseMove"
                                MouseRightButtonDown="OnLaneMouseRightButtonDown">
                                <!-- Beat / bar grid behind the lanes, drawn in one pass and only around the visible part. -->
                                <c:TimelineBeatMarks
                                    BarBrush="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                    BeatBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BeatOffsetSeconds="{Binding GridOffsetSeconds}"
                                    Bpm="{Binding GridBpm}"
                                    PixelsPerSecond="{Binding PixelsPerSecond}"
                                    ViewportStart="{Binding HorizontalOffset, ElementName=LaneScroll}"
                                    ViewportWidth="{Binding ViewportWidth, ElementName=LaneScroll}" />

                                <ItemsControl
                                    x:Name="LaneItems"
                                    VerticalAlignment="Top"
                                    Focusable="False"
                                    ItemsSource="{Binding Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShowTrackViewModel}">
                                            <Border
                                                x:Name="Lane"
                                                Height="{x:Static vm:ShowsViewModel.TrackHeight}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                                <Canvas ClipToBounds="True">
                                                    <!-- Time-range selection. -->
                                                    <Border
                                                        Canvas.Left="{Binding RangeLeft}"
                                                        Width="{Binding RangeWidth}"
                                                        Height="{x:Static vm:ShowsViewModel.TrackHeight}"
                                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding HasRange, Converter={StaticResource BoolToVisibility}}">
                                                        <Border.Background>
                                                            <SolidColorBrush Opacity="0.25" Color="{DynamicResource SystemAccentColor}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                <Setter Property="Canvas.Top" Value="{x:Static vm:ShowsViewModel.ItemTop}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ShowItemViewModel}">
                                                                <Border
                                                                    x:Name="Block"
                                                                    Width="{Binding Width}"
                                                                    Height="{x:Static vm:ShowsViewModel.ItemHeight}"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    ClipToBounds="True"
                                                                    CornerRadius="3"
                                                                    Cursor="SizeAll"
                                                                    ToolTip="{Binding ToolTip}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{Binding ColorHex}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasColor}" Value="False">
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <!-- Fade wedges: darkened area above the ramp. -->
                                                                        <Polygon
                                                                            Width="{Binding FadeInWidth}"
                                                                            HorizontalAlignment="Left"
                                                                            Fill="{DynamicResource SmokeFillColorDefaultBrush}"
                                                                            IsHitTestVisible="False"
                                                                            Points="0,0 1,0 0,1"
                                                                            Stretch="Fill" />
                                                                        <Polygon
                                                                            Width="{Binding FadeOutWidth}"
                                                                            HorizontalAlignment="Right"
                                                                            Fill="{DynamicResource SmokeFillColorDefaultBrush}"
                                                                            IsHitTestVisible="False"
                                                                            Points="0,0 1,0 1,1"
                                                                            Stretch="Fill" />
                                                                        <TextBlock
                                                                            x:Name="Label"
                                                                            Margin="6,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="White"
                                                                            IsHitTestVisible="False"
                                                                            Text="{Binding Name}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <!-- Resize handles (hit-tested by position in code-behind). -->
                                                                        <Rectangle
                                                                            Width="6"
                                                                            HorizontalAlignment="Left"
                                                                            Cursor="SizeWE"
                                                                            Fill="Transparent" />
                                                                        <Rectangle
                                                                            Width="6"
                                                                            HorizontalAlignment="Right"
                                                                            Cursor="SizeWE"
                                                                            Fill="Transparent" />
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLightColor}" Value="True">
                                                                        <Setter TargetName="Label" Property="Foreground" Value="Black" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasColor}" Value="False">
                                                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="Block" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                        <Setter TargetName="Block" Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter TargetName="Lane" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Playhead line: moved by a transform only (no layout per frame). -->
                                <Canvas
                                    HorizontalAlignment="Left"
                                    IsHitTestVisible="False">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="{Binding PlayheadX}" />
                                    </Canvas.RenderTransform>
                                    <Rectangle
                                        Width="1"
                                        Height="{Binding ActualHeight, ElementName=LaneHost}"
                                        Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Canvas>

                                <!-- No tracks. -->
                                <StackPanel
                                    Margin="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasNoTracks, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HintText}"
                                        Text="This show has no tracks." />
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{Binding AddTrackCommand}"
                                        Style="{StaticResource ToolbarLabelButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Add track" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Footer hint. -->
                        <Border
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Padding="8,2"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <TextBlock
                                Style="{StaticResource HintText}"
                                Text="Drag on an empty part of a track to select a time range · right-click a block or a track name for more · drag items to move (also to another track) · drag their edges to resize · drag the song to move it in time · Space plays / pauses · Del deletes · Ctrl+D duplicates · Ctrl+wheel zooms"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}" />

                <!-- ═════════════ Bottom panel: Properties | Function library ═════════════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="340" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <!-- Properties -->
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                <DockPanel>
                                    <!-- Item actions (only while an item is selected). -->
                                    <StackPanel
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsItemPanelVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource HintText}"
                                            Text="{Binding SelectedItem.TimingText}" />
                                        <Button
                                            Margin="0,0,4,0"
                                            AutomationProperties.Name="Edit function"
                                            Command="{Binding EditSelectedItemCommand}"
                                            Style="{StaticResource ToolbarEditButton}"
                                            ToolTip="Edit this show's own copy of the function (Enter or double-click the block). The library original never changes."
                                            ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <c:DmxIcon Kind="Edit" Size="16" />
                                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Edit" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Save as function"
                                            Command="{Binding SaveSelectedItemAsFunctionCommand}"
                                            Style="{StaticResource PanelHeaderButton}"
                                            ToolTip="Save as function…: save this show's copy, with its changes, as a new function in the Functions list. The block keeps its own copy."
                                            ToolTipService.ShowOnDisabled="True">
                                            <c:DmxIcon Kind="SaveAs" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Duplicate item"
                                            Command="{Binding DuplicateSelectedItemCommand}"
                                            Style="{StaticResource PanelHeaderButton}"
                                            ToolTip="Duplicate right after this item, with its own copy of the function (Ctrl+D)">
                                            <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Delete item"
                                            Command="{Binding DeleteSelectedItemCommand}"
                                            Style="{StaticResource PanelHeaderButton}"
                                            ToolTip="Delete this block from the show… (Del)">
                                            <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="Properties" />
                                </DockPanel>
                            </Border>

                            <Grid>
                                <!-- Selected item -->
                                <ScrollViewer
                                    DataContext="{Binding SelectedItem}"
                                    VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding DataContext.IsItemPanelVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="8,4,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MaxWidth="260" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" MaxWidth="220" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Style="{StaticResource ShowsFieldLabel}" Text="Function" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            AutomationProperties.Name="Function name"
                                            IsEnabled="{Binding HasFunction}"
                                            Style="{StaticResource FormTextBox}"
                                            Text="{Binding FunctionName, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Type" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            VerticalAlignment="Center"
                                            Text="{Binding TypeName}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Start (s)" />
                                        <ui:NumberBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Start in seconds"
                                            Style="{StaticResource ShowsSecondsBox}"
                                            Value="{Binding StartSeconds, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Fade in (s)" />
                                        <ui:NumberBox
                                            Grid.Row="1"
                                            Grid.Column="4"
                                            AutomationProperties.Name="Fade in seconds"
                                            Style="{StaticResource ShowsSecondsBox}"
                                            Value="{Binding FadeInSeconds, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Length (s)" />
                                        <ui:NumberBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Length in seconds"
                                            Minimum="{x:Static vm:ShowsViewModel.MinItemSeconds}"
                                            Style="{StaticResource ShowsSecondsBox}"
                                            Value="{Binding LengthSeconds, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Fade out (s)" />
                                        <ui:NumberBox
                                            Grid.Row="2"
                                            Grid.Column="4"
                                            AutomationProperties.Name="Fade out seconds"
                                            Style="{StaticResource ShowsSecondsBox}"
                                            Value="{Binding FadeOutSeconds, UpdateSourceTrigger=LostFocus}" />

                                        <CheckBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            VerticalAlignment="Top"
                                            Content="Show in function list"
                                            IsChecked="{Binding ShowInFunctionList}"
                                            IsEnabled="{Binding HasFunction}"
                                            ToolTip="Also list this show's copy on the Functions page (and keep it if the show is deleted)" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="3"
                                            Grid.ColumnSpan="2"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            Style="{StaticResource HintText}"
                                            Text="{Binding CopyHint}" />
                                    </Grid>
                                </ScrollViewer>

                                <!-- Selected time range: create a function for it -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRangePanelVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="8,4,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MaxWidth="320" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.ColumnSpan="3"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            FontWeight="SemiBold"
                                            Text="New function for this range" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Range" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            VerticalAlignment="Center"
                                            Text="{Binding RangeText}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Name" />
                                        <ui:TextBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            AutomationProperties.Name="New function name"
                                            Style="{StaticResource FormTextBox}"
                                            Text="{Binding NewFunctionName, UpdateSourceTrigger=PropertyChanged}">
                                            <ui:TextBox.InputBindings>
                                                <KeyBinding Command="{Binding CreateFunctionForRangeCommand}" Gesture="Enter" />
                                            </ui:TextBox.InputBindings>
                                        </ui:TextBox>
                                        <Button
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="8,0,0,4"
                                            AutomationProperties.Name="Create and place"
                                            Command="{Binding CreateFunctionForRangeCommand}"
                                            Style="{StaticResource ToolbarPrimaryButton}"
                                            ToolTip="Create a function of the chosen type, owned by this show, place it on the range and open its editor">
                                            <StackPanel Orientation="Horizontal">
                                                <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Create &amp; place" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock
                                            Grid.Row="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Type" />
                                        <ComboBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="New function type"
                                            ItemsSource="{Binding NewFunctionTypes}"
                                            SelectedItem="{Binding NewFunctionType}"
                                            Style="{StaticResource FormComboBox}"
                                            ToolTip="Type of the new function: scene, chaser, color cycle, fade, pulse, flash or strobe" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource HintText}"
                                            Text="The new function belongs to this show and is hidden from the Functions list; its editor opens right away. Or pick a function in the library and click Place to put it on this range." />
                                    </Grid>
                                </ScrollViewer>

                                <!-- Nothing selected: show settings and the show's music -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsShowPanelVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="8,4,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MaxWidth="260" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" MaxWidth="220" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Style="{StaticResource ShowsFieldLabel}" Text="Length (s)" />
                                        <ui:NumberBox
                                            Grid.Column="1"
                                            AutomationProperties.Name="Show length in seconds"
                                            LargeChange="30"
                                            MaxDecimalPlaces="1"
                                            Minimum="1"
                                            SmallChange="1"
                                            Style="{StaticResource FormNumberBox}"
                                            ToolTip="Show length; adding music makes the show at least as long as the song"
                                            Value="{Binding ShowLengthSeconds, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="BPM" />
                                        <ui:NumberBox
                                            Grid.Column="4"
                                            AutomationProperties.Name="Show tempo in beats per minute"
                                            MaxDecimalPlaces="2"
                                            Maximum="300"
                                            Minimum="20"
                                            Style="{StaticResource FormNumberBox}"
                                            ToolTip="Tempo for the beat lines and Beat / Bar snapping"
                                            Value="{Binding ShowBpm, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="First beat (s)" />
                                        <ui:NumberBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            AutomationProperties.Name="First beat in seconds"
                                            MaxDecimalPlaces="3"
                                            Minimum="-3600"
                                            SmallChange="0.01"
                                            Style="{StaticResource FormNumberBox}"
                                            ToolTip="Show time of a beat the grid is counted from (bars start there). Set from the song with Use song tempo."
                                            Value="{Binding ShowBeatOffsetSeconds, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Song tempo"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />
                                        <DockPanel
                                            Grid.Row="1"
                                            Grid.Column="4"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}">
                                            <Button
                                                AutomationProperties.Name="Use song tempo"
                                                Command="{Binding Music.UseSongTempoCommand}"
                                                DockPanel.Dock="Right"
                                                IsEnabled="{Binding Music.CanUseSongTempo}"
                                                Style="{StaticResource ToolbarLabelButton}"
                                                ToolTip="Set the beat grid (BPM and first beat) from the song's detected tempo">
                                                <TextBlock Style="{StaticResource ButtonLabel}" Text="Use" />
                                            </Button>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Music.DetectedBpmText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="Tempo detected in the song" />
                                        </DockPanel>

                                        <!-- Music -->
                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Music" />
                                        <DockPanel
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="4"
                                            Margin="{StaticResource Dmx.FormRowMargin}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button
                                                    AutomationProperties.Name="Add or replace music"
                                                    Command="{Binding Music.AddMusicCommand}"
                                                    Style="{StaticResource ToolbarLabelButton}"
                                                    ToolTip="Add music to this show, or replace its song">
                                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding Music.AddMusicHeader}" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Relink music"
                                                    Command="{Binding Music.RelinkMusicCommand}"
                                                    Style="{StaticResource ToolbarLabelButton}"
                                                    ToolTip="Pick the song at its new location (offset, volume and fade stay)"
                                                    Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Relink…" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Remove music"
                                                    Command="{Binding Music.RemoveMusicCommand}"
                                                    Style="{StaticResource ToolbarButton}"
                                                    ToolTip="Remove the music from this show (the file is not deleted)"
                                                    Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}">
                                                    <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Collect music into project folder"
                                                    Command="{Binding Music.CollectMusicCommand}"
                                                    Style="{StaticResource ToolbarButton}"
                                                    ToolTip="Collect music: copy the songs of all shows into a Music folder next to the project file and link them there">
                                                    <c:DmxIcon Kind="Folder" Size="{StaticResource Dmx.SmallIconSize}" />
                                                </Button>
                                            </StackPanel>
                                            <c:DmxIcon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Music problem"
                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                Kind="Warning"
                                                Size="{StaticResource Dmx.DenseIconSize}"
                                                Visibility="{Binding Music.HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Music.FilePathText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Music.FilePathText}" />
                                        </DockPanel>
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="4"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Text="{Binding Music.StatusText}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding Music.HasProblem, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Volume"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />
                                        <DockPanel
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                Width="40"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Text="{Binding Music.VolumeText}"
                                                TextAlignment="Right" />
                                            <Slider
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Music volume in percent"
                                                IsMoveToPointEnabled="True"
                                                LargeChange="10"
                                                Maximum="100"
                                                Minimum="0"
                                                SmallChange="1"
                                                ToolTip="Music volume"
                                                Value="{Binding Music.VolumePercent, Delay=50}" />
                                        </DockPanel>
                                        <CheckBox
                                            Grid.Row="4"
                                            Grid.Column="4"
                                            Margin="{StaticResource Dmx.FormRowMargin}"
                                            VerticalAlignment="Center"
                                            Content="Mute music"
                                            IsChecked="{Binding Music.IsMuted}"
                                            ToolTip="The song does not play; the show's lights still run"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Row="5"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Starts at (s)"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:NumberBox
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Music start in seconds"
                                            MaxDecimalPlaces="3"
                                            Minimum="{Binding Music.MinOffsetSeconds}"
                                            SmallChange="0.1"
                                            Style="{StaticResource FormNumberBox}"
                                            ToolTip="Show time at which the song starts (negative skips its intro). You can also drag the song on the audio lane."
                                            Value="{Binding Music.OffsetSeconds, UpdateSourceTrigger=LostFocus}"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="3"
                                            Style="{StaticResource ShowsFieldLabel}"
                                            Text="Fade out (s)"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:NumberBox
                                            Grid.Row="5"
                                            Grid.Column="4"
                                            AutomationProperties.Name="Music fade out seconds"
                                            Style="{StaticResource ShowsSecondsBox}"
                                            ToolTip="The music fades out over this many seconds before the show ends (0 = no fade)"
                                            Value="{Binding Music.FadeOutSeconds, UpdateSourceTrigger=LostFocus}"
                                            Visibility="{Binding Music.HasMusic, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="4"
                                            Style="{StaticResource HintText}"
                                            Text="Select an item to edit it, or drag across an empty part of a track to select a time range." />
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

                    <!-- Function library -->
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                                <DockPanel>
                                    <Button
                                        AutomationProperties.Name="Place selected function"
                                        Command="{Binding PlaceSelectedFunctionCommand}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ToolbarLabelButton}"
                                        ToolTip="Place the selected function on the selected range, or at the playhead on the active track (Enter / double-click)">
                                        <StackPanel Orientation="Horizontal">
                                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.SmallIconSize}" />
                                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Place" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Style="{StaticResource PanelTitle}"
                                        Text="Function library"
                                        ToolTip="Drag onto a track, or select and click Place. Placing makes this show's own copy — changes don't affect the original." />
                                </DockPanel>
                            </Border>

                            <Grid>
                                <TextBlock
                                    Margin="8,4"
                                    Style="{StaticResource HintText}"
                                    Text="No functions yet. Create functions on the Functions page, or select a time range on a track and click New function for selection."
                                    Visibility="{Binding HasNoLibrary, Converter={StaticResource BoolToVisibility}}" />
                                <ListBox
                                    x:Name="LibraryList"
                                    Margin="2"
                                    AutomationProperties.Name="Function library"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ShowsCompactListItem}"
                                    ItemsSource="{Binding Library}"
                                    PreviewMouseLeftButtonDown="OnLibraryPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="OnLibraryPreviewMouseMove"
                                    SelectedItem="{Binding SelectedLibraryItem}"
                                    Visibility="{Binding HasLibrary, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.InputBindings>
                                        <KeyBinding Command="{Binding PlaceSelectedFunctionCommand}" Gesture="Enter" />
                                        <MouseBinding Command="{Binding PlaceSelectedFunctionCommand}" Gesture="LeftDoubleClick" />
                                    </ListBox.InputBindings>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShowsLibraryItem}">
                                            <DockPanel ToolTip="{Binding Name}">
                                                <Border
                                                    x:Name="Swatch"
                                                    Width="10"
                                                    Height="10"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding ColorHex}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasColor}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding TypeName}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
