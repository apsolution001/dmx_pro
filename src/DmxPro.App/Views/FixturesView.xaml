<UserControl
    x:Class="DmxPro.App.Views.FixturesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:validation="clr-namespace:DmxPro.Core.Validation;assembly=DmxPro.Core"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FixturesViewModel}"
    mc:Ignorable="d">
    <DockPanel>
        <!-- Page toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding AddFixtureCommand}"
                        Content="Add fixture"
                        Icon="{ui:SymbolIcon Add24}"
                        ToolTip="Add one or more fixtures (Ctrl+Shift+A)" />
                    <ui:Button
                        Margin="4,0,0,0"
                        Appearance="Transparent"
                        AutomationProperties.Name="Delete selected fixtures"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FixtureGrid}"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="Delete selected fixtures" />
                    <ui:Button
                        Appearance="Transparent"
                        AutomationProperties.Name="Duplicate fixture"
                        Command="{Binding DuplicateCommand}"
                        Icon="{ui:SymbolIcon Copy24}"
                        ToolTip="Duplicate to the next free address" />
                    <ui:Button
                        Appearance="Transparent"
                        AutomationProperties.Name="Move to free address"
                        Command="{Binding AutoAddressCommand}"
                        Icon="{ui:SymbolIcon Wand24}"
                        ToolTip="Move the selected fixture to the first free address" />
                    <Rectangle Style="{StaticResource ToolbarSeparator}" />
                    <ui:Button
                        Appearance="Transparent"
                        AutomationProperties.Name="New group from selection"
                        Command="{Binding NewGroupCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FixtureGrid}"
                        Content="Group"
                        Icon="{ui:SymbolIcon Group24}"
                        ToolTip="Make a new group from the selected fixtures" />
                </StackPanel>
                <ui:TextBox
                    Width="260"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search fixtures or profiles"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: fixture table + address map -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <DataGrid
                        x:Name="FixtureGrid"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Fixtures}"
                        SelectedItem="{Binding SelectedFixture}"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FixtureRowViewModel}">
                                        <ui:SymbolIcon
                                            x:Name="StatusIcon"
                                            FontSize="16"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Symbol="CheckmarkCircle24"
                                            ToolTip="Patched correctly" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding WorstIssue}" Value="{x:Static validation:ValidationSeverity.Warning}">
                                                <Setter TargetName="StatusIcon" Property="Symbol" Value="Warning24" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Setter TargetName="StatusIcon" Property="ToolTip" Value="{Binding IssueText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WorstIssue}" Value="{x:Static validation:ValidationSeverity.Error}">
                                                <Setter TargetName="StatusIcon" Property="Symbol" Value="ErrorCircle24" />
                                                <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Setter TargetName="StatusIcon" Property="ToolTip" Value="{Binding IssueText}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*" Binding="{Binding Name}" Header="Name" />
                            <DataGridTextColumn Width="2*" Binding="{Binding ProfileName}" Header="Profile" />
                            <DataGridTextColumn Width="1.2*" Binding="{Binding ModeName}" Header="Mode" />
                            <DataGridTextColumn Width="48" Binding="{Binding Universe}" Header="U" />
                            <DataGridTextColumn Width="90" Binding="{Binding AddressRange}" Header="Address" />
                            <DataGridTextColumn Width="44" Binding="{Binding ChannelCount}" Header="Ch" />
                            <DataGridTextColumn Width="1.5*" Binding="{Binding GroupNames}" Header="Groups" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}" />

                <!-- Address map -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Address map" />
                                <ComboBox
                                    Width="110"
                                    Margin="12,0,0,0"
                                    AutomationProperties.Name="Universe shown on the map"
                                    ItemStringFormat="Universe {0}"
                                    ItemsSource="{Binding Universes}"
                                    SelectedItem="{Binding MapUniverse}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HintText}"
                                    Text="{Binding MapSummary}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl
                            Margin="8"
                            AutomationProperties.Name="DMX address map, 512 channels"
                            ItemsSource="{Binding AddressCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="32" Rows="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AddressCellViewModel}">
                                    <Button
                                        Height="12"
                                        Margin="1"
                                        Command="{Binding DataContext.SelectAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Address}"
                                        Cursor="Hand"
                                        Focusable="False"
                                        ToolTip="{Binding ToolTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="Cell"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AddressCellState.Used}">
                                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AddressCellState.Overlap}">
                                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

            <!-- Right: properties + groups -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="220" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Properties" />
                        </Border>

                        <TextBlock
                            Margin="12"
                            Style="{StaticResource HintText}"
                            Text="Select a fixture to edit it, or click Add fixture."
                            Visibility="{Binding SelectedFixture, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                        <ScrollViewer
                            DataContext="{Binding SelectedFixture}"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <StackPanel Margin="12,10">
                                <!-- Problems for this fixture -->
                                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding DataContext.SelectedIssues, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type validation:ValidationIssue}">
                                            <Border
                                                x:Name="IssueBox"
                                                Margin="0,0,0,6"
                                                Padding="8,6"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                BorderThickness="3,0,0,0">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static validation:ValidationSeverity.Error}">
                                                    <Setter TargetName="IssueBox" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Name" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="Fixture name"
                                        Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Profile" />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="Fixture profile"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItem="{Binding Profile}" />

                                    <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Mode" />
                                    <ComboBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="DMX mode"
                                        ItemsSource="{Binding ModeNames}"
                                        SelectedItem="{Binding ModeName}" />

                                    <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Universe" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Width="100"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Universe"
                                        Text="{Binding Universe, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Address" />
                                    <StackPanel
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <TextBox
                                            Width="100"
                                            AutomationProperties.Name="Start address"
                                            Text="{Binding StartAddress, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="uses" />
                                            <Run Text="{Binding AddressRange, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Enabled" />
                                    <CheckBox
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Content="Send DMX to this fixture"
                                        IsChecked="{Binding Enabled}" />

                                    <TextBlock
                                        Grid.Row="6"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource FormLabel}"
                                        Text="Notes" />
                                    <TextBox
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        MinHeight="56"
                                        Margin="0,0,0,8"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="Notes"
                                        Text="{Binding Notes, UpdateSourceTrigger=LostFocus}"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock
                                    Margin="0,8,0,4"
                                    Style="{StaticResource PanelTitle}"
                                    Text="Channel map" />
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Style="{StaticResource HintText}"
                                    Text="From the fixture profile. ⚠ = meaning unknown, raw channel only." />
                                <ItemsControl ItemsSource="{Binding Channels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChannelMapRow}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Number, StringFormat=CH{0}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Address, StringFormat=DMX {0}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Type}" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                        Text="⚠"
                                                        ToolTip="Unknown meaning — test it before using"
                                                        Visibility="{Binding IsGeneric, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}" />

                <!-- Groups -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="Groups" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <ui:Button
                                        Padding="4"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="New group from selection"
                                        Command="{Binding NewGroupCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=FixtureGrid}"
                                        Icon="{ui:SymbolIcon Add24}"
                                        ToolTip="New group from the selected fixtures" />
                                    <ui:Button
                                        Padding="4"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="Add selection to group"
                                        Command="{Binding AddToGroupCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=FixtureGrid}"
                                        Icon="{ui:SymbolIcon ArrowImport24}"
                                        ToolTip="Add the selected fixtures to the selected group" />
                                    <ui:Button
                                        Padding="4"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="Delete group"
                                        Command="{Binding DeleteGroupCommand}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="Delete the selected group (fixtures stay)" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ListBox
                            AutomationProperties.Name="Fixture groups"
                            BorderThickness="0"
                            ItemsSource="{Binding Groups}"
                            SelectedItem="{Binding SelectedGroup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupRowViewModel}">
                                    <StackPanel>
                                        <TextBox
                                            Padding="2"
                                            AutomationProperties.Name="Group name"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="Click to rename" />
                                        <TextBlock
                                            Margin="2,0,0,0"
                                            Style="{StaticResource HintText}"
                                            Text="{Binding Members}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
