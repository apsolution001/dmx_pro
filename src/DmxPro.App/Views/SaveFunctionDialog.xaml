<ui:FluentWindow
    x:Class="DmxPro.App.Views.SaveFunctionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    Title="{Binding Title}"
    Width="420"
    MinWidth="360"
    d:DataContext="{d:DesignInstance Type=vm:SaveFunctionDialogViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/Logo/dmxpro.ico"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--
        Shared "Save as function" dialog (Shows block, Test & Preview):
        ┌ Save as function ───────────────────────────── ✕ ┐
        │ Saves a copy of … to the Functions list.          │
        │ Name      [Red all                            ]   │
        │           ⚠ Enter a name. / ⓘ already exists      │
        │ Fade in   [0  ] s    Fade out [0  ] s  (optional) │
        ├───────────────────────────────────────────────────┤
        │                                  [Cancel] [Save]  │
        └───────────────────────────────────────────────────┘
        Enter = Save, Esc = Cancel (code-behind, so a focused number box commits first).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    AutomationProperties.Name="DMX Pro"
                    Source="{StaticResource Dmx.Logo.Small.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="10,2,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.ColumnSpan="2"
                Margin="0,0,0,6"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Message}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="1"
                Style="{StaticResource FormLabel}"
                Text="Name" />
            <ui:TextBox
                x:Name="NameBox"
                Grid.Row="1"
                Grid.Column="1"
                AutomationProperties.Name="Function name"
                PlaceholderText="Name in the Functions list"
                Style="{StaticResource FormTextBox}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Name of the new function in the Functions list (required)" />

            <!-- Inline validation: blank name (blocks Save) or a name already used (allowed, but said). -->
            <StackPanel Grid.Row="2" Grid.Column="1">
                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Kind="Error"
                        Size="{StaticResource Dmx.SmallIconSize}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding NameError}"
                        TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasNameWarning, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Kind="Info"
                        Size="{StaticResource Dmx.SmallIconSize}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding NameWarning}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <!-- Optional fades (scenes saved from the Test page). -->
            <StackPanel
                Grid.Row="3"
                Grid.Column="1"
                Orientation="Horizontal"
                Visibility="{Binding ShowFades, Converter={StaticResource BoolToVisibility}}">
                <ui:NumberBox
                    Width="96"
                    AutomationProperties.Name="Fade in seconds"
                    LargeChange="1"
                    MaxDecimalPlaces="3"
                    Maximum="3600"
                    Minimum="0"
                    SmallChange="0.1"
                    Style="{StaticResource FormNumberBox}"
                    ToolTip="Fade in time of the new scene, in seconds (optional)"
                    Value="{Binding FadeInSeconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="4,0,12,0"
                    VerticalAlignment="Center"
                    Text="s fade in" />
                <ui:NumberBox
                    Width="96"
                    AutomationProperties.Name="Fade out seconds"
                    LargeChange="1"
                    MaxDecimalPlaces="3"
                    Maximum="3600"
                    Minimum="0"
                    SmallChange="0.1"
                    Style="{StaticResource FormNumberBox}"
                    ToolTip="Fade out time of the new scene, in seconds (optional)"
                    Value="{Binding FadeOutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Text="s fade out" />
            </StackPanel>
            <TextBlock
                Grid.Row="3"
                Style="{StaticResource FormLabel}"
                Text="Fades"
                Visibility="{Binding ShowFades, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Footer: [Cancel] [Save] -->
        <Border
            Grid.Row="2"
            Padding="8,6"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="80"
                    Padding="{StaticResource Dmx.ButtonPadding}"
                    AutomationProperties.Name="Cancel"
                    Content="Cancel"
                    IsCancel="True"
                    ToolTip="Close without saving (Esc)" />
                <ui:Button
                    x:Name="SaveButton"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Padding="{StaticResource Dmx.ButtonPadding}"
                    Appearance="Primary"
                    AutomationProperties.Name="Save function"
                    Click="OnSaveClick"
                    Content="Save"
                    IsDefault="True"
                    IsEnabled="{Binding CanSave}"
                    ToolTip="Save it to the Functions list (Enter)" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
