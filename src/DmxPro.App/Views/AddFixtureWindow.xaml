<ui:FluentWindow
    x:Class="DmxPro.App.Views.AddFixtureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:profiles="clr-namespace:DmxPro.Core.Profiles;assembly=DmxPro.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    Title="Add fixture"
    Width="820"
    Height="560"
    MinWidth="700"
    MinHeight="460"
    d:DataContext="{d:DesignInstance Type=vm:AddFixtureViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Add fixture"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="12,4,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Fixture tree: manufacturer → model -->
            <DockPanel Grid.Column="0">
                <TextBlock
                    Margin="0,0,0,4"
                    DockPanel.Dock="Top"
                    Style="{StaticResource PanelTitle}"
                    Text="Fixture" />
                <ui:TextBox
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search manufacturer or model"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Border Style="{StaticResource PanelBorder}">
                    <TreeView
                        x:Name="ProfileTree"
                        AutomationProperties.Name="Fixture profiles"
                        BorderThickness="0"
                        ItemsSource="{Binding Manufacturers}"
                        SelectedItemChanged="OnProfileTreeSelectionChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ManufacturerNode}" ItemsSource="{Binding Profiles}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Folder24" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type profiles:FixtureProfile}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Lightbulb24" />
                                    <TextBlock Text="{Binding Model}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Type}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

            <!-- Patch settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Patch" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Mode" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="DMX mode"
                            ItemsSource="{Binding Modes}"
                            SelectedItem="{Binding SelectedMode}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Channels" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Text="{Binding ChannelCount}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Name" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Fixture name"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Universe" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Universe"
                            Text="{Binding Universe, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Address" />
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Orientation="Horizontal">
                            <TextBox
                                Width="120"
                                AutomationProperties.Name="Start address"
                                Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding FindFreeAddressCommand}"
                                Content="Find free address"
                                Icon="{ui:SymbolIcon Search24}" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Amount" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Amount"
                            Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6" Style="{StaticResource FormLabel}" Text="Address gap" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Address gap"
                            Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Unused channels between fixtures when adding more than one" />
                    </Grid>

                    <Border
                        Margin="0,8,0,0"
                        Padding="10,8"
                        Style="{StaticResource PanelBorder}">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource HintText}"
                        Text="Set the same DMX mode and start address on the fixture itself (display or DIP switches)." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="110"
                    Appearance="Primary"
                    Click="OnAddClick"
                    Content="Add"
                    IsDefault="True"
                    IsEnabled="{Binding CanAdd}" />
                <ui:Button
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
