<ui:FluentWindow
    x:Class="DmxPro.App.Views.AddFixtureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:conv="clr-namespace:DmxPro.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    Title="Add fixture"
    Width="800"
    Height="520"
    MinWidth="680"
    MinHeight="420"
    d:DataContext="{d:DesignInstance Type=vm:AddFixtureViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/Logo/dmxpro.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--
        Layout (QLC+ "Add fixture", modernised, compact):
        ┌ Search profiles ───────┐  Name      [RGBW fixture          ]
        │ ▾ Generic              │  Mode      [8ch Full (8 channels) ▾]
        │   ☼ Dimmer             │  Universe  [ 1 ]  Address [ 1 ] [#]
        │   ◧ RGBW fixture  ⚠    │  Quantity  [ 4 ]  Gap     [ 0 ]
        │ ▾ Custom               │  Channels (8)          [Edit as new layout…]
        │   ◧ My Par  Custom ⚠   │  ⚠ Check the channel order matches your light.
        │                        │  # · Channel · Type table
        ├────────────────────────┤
        │ New layout… Import… 7  │  ▣ Will use Universe 1, addresses 1–8 … 25–32
        └────────────────────────┘
        ⚠ reason (red)                                  [Cancel] [Add 4 fixtures]
    -->
    <ui:FluentWindow.Resources>
        <conv:CustomLayoutToVisibilityConverter x:Key="CustomLayoutToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Add fixture"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    AutomationProperties.Name="DMX Pro"
                    Source="{StaticResource Dmx.Logo.Small.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="8,2,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════ Left: profile tree ═══════════ -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border
                        Padding="2"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <ui:TextBox
                            x:Name="SearchBox"
                            Margin="0"
                            AutomationProperties.Name="Search profiles"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Search profiles"
                            Style="{StaticResource FormTextBox}"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Filter by manufacturer, model or type" />
                    </Border>

                    <!-- Import + count -->
                    <Border
                        Padding="2,2,6,2"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom">
                        <DockPanel>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Style="{StaticResource HintText}"
                                Text="{Binding ProfileCountText}" />
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Button
                                    AutomationProperties.Name="New channel layout"
                                    Command="{Binding NewLayoutCommand}"
                                    Style="{StaticResource ToolbarLabelButton}"
                                    ToolTip="New layout: set what each DMX channel of your light does, in its own order"
                                    Visibility="{Binding CanEditLayouts, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="ProfileNew" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        <TextBlock Style="{StaticResource ButtonLabel}" Text="New layout…" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="Import profile"
                                    Command="{Binding ImportCommand}"
                                    Style="{StaticResource ToolbarLabelButton}"
                                    ToolTip="Import a QLC+ (.qxf) or DMX Pro (.dmxprofile.json) fixture profile"
                                    Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="Import" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Import…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Import result: red on failure, quiet hint on success -->
                    <Border
                        Padding="6,2"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom"
                        Visibility="{Binding HasImportMessage, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <c:DmxIcon
                                Margin="0,1,4,0"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Left"
                                Size="{StaticResource Dmx.DenseIconSize}">
                                <c:DmxIcon.Style>
                                    <Style TargetType="c:DmxIcon">
                                        <Setter Property="Kind" Value="Check" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImportFailed}" Value="True">
                                                <Setter Property="Kind" Value="Error" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </c:DmxIcon.Style>
                            </c:DmxIcon>
                            <TextBlock
                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                Text="{Binding ImportMessage}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImportFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <TreeView
                            x:Name="ProfileTree"
                            Padding="2"
                            AutomationProperties.Name="Fixture profiles"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Groups}"
                            SelectedItemChanged="OnProfileTreeSelectionChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:ProfileTreeGroup}" ItemsSource="{Binding Items}">
                                    <StackPanel Height="{StaticResource Dmx.ListRowMinHeight}" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource HintText}"
                                            Text="{Binding Items.Count}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileTreeItem}">
                                    <StackPanel
                                        Height="{StaticResource Dmx.ListRowMinHeight}"
                                        AutomationProperties.Name="{Binding Name}"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding ToolTip}">
                                        <c:DmxIcon
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Kind="{Binding IconKind}"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Dmx.CornerRadius}"
                                            ToolTip="Custom layout made in the channel layout editor: you can edit it"
                                            Visibility="{Binding Profile, Converter={StaticResource CustomLayoutToVisibility}}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="Custom" />
                                        </Border>
                                        <Border
                                            Margin="4,0,0,0"
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="{StaticResource Dmx.CornerRadius}"
                                            ToolTip="Unverified profile: check each channel on the real fixture"
                                            Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:DmxIcon
                                                    Margin="0,0,2,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Kind="Warning"
                                                    Size="{StaticResource Dmx.DenseIconSize}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="Unverified" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <TextBlock
                            Margin="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource Dmx.FontSize.Body}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding EmptyTreeText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsTreeEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ═══════════ Right: fixture properties (no "Fixture" heading: the window title says it) ═══════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="96" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fixture + multiple fixtures in one compact form -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="56" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource FormLabel}"
                        Text="Name" />
                    <ui:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        AutomationProperties.Name="Fixture name"
                        PlaceholderText="Fixture name"
                        Style="{StaticResource FormTextBox}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Several fixtures are numbered: Name 1, Name 2, …" />

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource FormLabel}"
                        Text="Mode" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        AutomationProperties.Name="DMX mode"
                        DisplayMemberPath="Display"
                        IsEnabled="{Binding HasProfile}"
                        ItemsSource="{Binding Modes}"
                        SelectedItem="{Binding SelectedMode}"
                        Style="{StaticResource FormComboBox}"
                        ToolTip="Set the same DMX mode on the fixture itself" />

                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource FormLabel}"
                        Text="Universe" />
                    <ui:NumberBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="100"
                        AutomationProperties.Name="Universe"
                        Maximum="63999"
                        Minimum="1"
                        Style="{StaticResource FormNumberBox}"
                        Value="{Binding Universe, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="12,0,8,4"
                        Style="{StaticResource FormLabel}"
                        Text="Address" />
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="3"
                        Orientation="Horizontal">
                        <ui:NumberBox
                            Width="100"
                            AutomationProperties.Name="Start address"
                            Maximum="512"
                            Minimum="1"
                            Style="{StaticResource FormNumberBox}"
                            ToolTip="First DMX address (1–512). Set the same address on the fixture."
                            Value="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Margin="4,0,0,4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Use next free address"
                            Command="{Binding UseNextFreeAddressCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Use next free address">
                            <c:DmxIcon Kind="AutoAddress" Size="{StaticResource Dmx.ButtonIconSize}" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource FormLabel}"
                        Text="Quantity" />
                    <ui:NumberBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="100"
                        AutomationProperties.Name="Quantity"
                        Maximum="512"
                        Minimum="1"
                        Style="{StaticResource FormNumberBox}"
                        ToolTip="How many fixtures to add, one after another"
                        Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Margin="12,0,8,4"
                        Style="{StaticResource FormLabel}"
                        Text="Gap" />
                    <ui:NumberBox
                        Grid.Row="3"
                        Grid.Column="3"
                        Width="100"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Address gap"
                        Maximum="511"
                        Minimum="0"
                        Style="{StaticResource FormNumberBox}"
                        ToolTip="Address gap: unused channels between consecutive fixtures"
                        Value="{Binding Gap, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Channels of the selected mode -->
                <DockPanel Grid.Row="1">
                    <DockPanel Margin="0,0,0,2" DockPanel.Dock="Top">
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding CanEditLayouts, Converter={StaticResource BoolToVisibility}}">
                            <Button
                                AutomationProperties.Name="Edit channel layout"
                                Command="{Binding EditLayoutCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Edit this custom layout. Lights already using it in the project change with it."
                                Visibility="{Binding IsCustomSelected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Edit" Size="{StaticResource Dmx.ButtonIconSize}" />
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Edit layout…" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Edit as new channel layout"
                                Command="{Binding EditAsNewLayoutCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Copy this channel order into a new layout you can change. The original stays unchanged.">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.ButtonIconSize}" />
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Edit as new layout…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource FormSection}"
                                Text="Channels" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource HintText}"
                                Text="{Binding ChannelCount, StringFormat=({0})}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- A built-in profile is only a template: every light has its own channel order. -->
                    <DockPanel
                        Margin="0,0,0,2"
                        DockPanel.Dock="Top"
                        Visibility="{Binding IsTemplateSelected, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Kind="Warning"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource Dmx.FontSize.Small}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Check the channel order matches your light (see its manual)."
                            TextTrimming="CharacterEllipsis"
                            ToolTip="Built-in profiles are common layouts, not your light's. If the order differs, use Edit as new layout… and set each channel." />
                    </DockPanel>
                    <Border Style="{StaticResource PanelBorder}">
                        <DataGrid
                            AutomationProperties.Name="Channels of the selected mode"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Channels}"
                            SelectionMode="Single"
                            Style="{StaticResource DataTable}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="36"
                                    Binding="{Binding Number}"
                                    Header="#" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    Header="Channel" />
                                <DataGridTemplateColumn Width="120" Header="Type">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModeChannelRow}">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <c:DmxIcon
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Kind="Warning"
                                                    Size="{StaticResource Dmx.DenseIconSize}"
                                                    ToolTip="Meaning unknown: raw channel only. Test it before using."
                                                    Visibility="{Binding IsGeneric, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Type}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <!-- Live footprint preview -->
                <Border
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    Padding="6,3"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Dmx.CornerRadius}">
                    <StackPanel>
                        <DockPanel>
                            <c:DmxIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Kind="Universe"
                                Size="{StaticResource Dmx.SmallIconSize}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Footprint preview"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding PreviewText}" />
                                        <Setter Property="ToolTip" Value="{Binding PreviewText}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewText}" Value="">
                                                <Setter Property="Text" Value="No addresses yet: fix the problem below." />
                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <!-- Safety rule 7: an unverified profile is always flagged, never presented as confirmed. -->
                        <DockPanel Margin="0,2,0,0" Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}">
                            <c:DmxIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Kind="Unverified"
                                Size="{StaticResource Dmx.SmallIconSize}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Unverified profile: test each channel at low intensity first."
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer: reason when invalid, then [Cancel] [Add] -->
        <Border
            Grid.Row="2"
            Padding="8,4"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel
                    Margin="8,0,0,0"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="80"
                        Padding="{StaticResource Dmx.ButtonPadding}"
                        Content="Cancel"
                        IsCancel="True" />
                    <ui:Button
                        x:Name="AddButton"
                        MinWidth="96"
                        Padding="{StaticResource Dmx.ButtonPadding}"
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Click="OnAddClick"
                        Content="{Binding AddButtonText}"
                        IsDefault="True"
                        IsEnabled="{Binding CanAdd}" />
                </StackPanel>
                <DockPanel VerticalAlignment="Center" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Kind="Warning"
                        Size="{StaticResource Dmx.SmallIconSize}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding Problem}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
