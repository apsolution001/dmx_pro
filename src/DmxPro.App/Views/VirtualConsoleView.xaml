<UserControl
    x:Class="DmxPro.App.Views.VirtualConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:console="clr-namespace:DmxPro.Core.VirtualConsole;assembly=DmxPro.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=vm:VirtualConsoleViewModel}"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewKeyUp="OnPreviewKeyUp"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <c:ConsoleColorBrushConverter x:Key="ConsoleColor" />
        <c:ConsoleCellsToPixelsConverter x:Key="CellsToPixels" />

        <!-- Page tabs: flat text tabs with an accent underline on the selected page. -->
        <Style x:Key="ConsolePageTab" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.TabHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="Double-click or F2 to rename" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border
                                x:Name="HoverFill"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource Dmx.CornerRadius}"
                                Opacity="0" />
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Dmx.CornerRadius}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Rectangle
                                x:Name="Underline"
                                Height="2"
                                Margin="8,0"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                RadiusX="1"
                                RadiusY="1"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Dmx.HoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Dmx.HoverOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The fixed "Shows" tab left of the page tabs: same look as a page tab, selected while the Shows list is open. -->
        <Style x:Key="ConsoleShowsTab" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinHeight" Value="{StaticResource Dmx.TabHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="HoverFill"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource Dmx.CornerRadius}"
                                Opacity="0" />
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Dmx.CornerRadius}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Rectangle
                                x:Name="Underline"
                                Height="2"
                                Margin="8,0"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                RadiusX="1"
                                RadiusY="1"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Dmx.HoverIn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Dmx.HoverOut}" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsShowsTabSelected}" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Labelled variant of the toolbar toggle (icon + text). -->
        <Style
            x:Key="ConsoleToolbarToggle"
            BasedOn="{StaticResource ToolbarToggleButton}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Padding" Value="{StaticResource Dmx.LabelledButtonPadding}" />
        </Style>

        <!-- Console tile (button presentation). DataContext = ConsoleWidgetViewModel. -->
        <Style x:Key="ConsoleTile" TargetType="c:ConsoleTileButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Command" Value="{Binding ActivateCommand}" />
            <Setter Property="PressCommand" Value="{Binding PressCommand}" />
            <Setter Property="ReleaseCommand" Value="{Binding ReleaseCommand}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="c:ConsoleTileButton">
                        <Border
                            x:Name="Bd"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Full colour fill when active. -->
                                <Border
                                    x:Name="Fill"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="5"
                                    Visibility="Collapsed" />
                                <!-- Colour strip at rest: shows the tile colour without lighting the whole tile. -->
                                <Border
                                    x:Name="Strip"
                                    Height="8"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="5,5,0,0" />
                                <Border
                                    x:Name="Hover"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="5"
                                    Visibility="Collapsed" />
                                <StackPanel
                                    Margin="6,6,6,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <c:DmxIcon
                                        x:Name="Icon"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        Kind="{Binding Icon}"
                                        Size="24"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        x:Name="Text"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayLabel}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="State"
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding StateText}"
                                        TextAlignment="Center"
                                        Visibility="{Binding HasStateText, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Colour source: widget colour, else theme accent; Blackout uses the critical colour. -->
                            <DataTrigger Binding="{Binding HasColor}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{Binding Color, Converter={StaticResource ConsoleColor}}" />
                                <Setter TargetName="Strip" Property="Background" Value="{Binding Color, Converter={StaticResource ConsoleColor}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:VirtualConsoleWidgetKind.Blackout}">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:VirtualConsoleWidgetKind.ReleaseAll}">
                                <Setter TargetName="Strip" Property="Background" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                                <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>

                            <!-- Active: full colour, thick border and the state word (never colour alone). -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Strip" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                    <Condition Binding="{Binding HasColor}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource ConsoleColor}, ConverterParameter=Contrast}" />
                                <Setter TargetName="State" Property="Foreground" Value="{Binding Color, Converter={StaticResource ConsoleColor}, ConverterParameter=Contrast}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:ConsoleWidgetViewModel}">
            <c:ConsoleTileButton Style="{StaticResource ConsoleTile}" />
        </DataTemplate>

        <!-- Fader presentation: the whole widget is the fader; label on top, value at the bottom. -->
        <DataTemplate x:Key="FaderTemplate" DataType="{x:Type vm:ConsoleWidgetViewModel}">
            <Border
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                <Grid>
                    <c:ConsoleFader
                        x:Name="Fader"
                        AutomationProperties.Name="{Binding DisplayLabel}"
                        CornerRadius="5"
                        FillBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                        LineBrush="{DynamicResource TextFillColorPrimaryBrush}"
                        ToolTip="{Binding ToolTipText}"
                        TrackBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Value="{Binding Level, Mode=TwoWay}" />
                    <DockPanel Margin="4" IsHitTestVisible="False">
                        <Border
                            Padding="6,1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            CornerRadius="3"
                            DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <c:DmxIcon
                                    x:Name="Icon"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Kind="{Binding Icon}"
                                    Size="14"
                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding DisplayLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="6,1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            CornerRadius="3"
                            DockPanel.Dock="Bottom">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding ValueText}" />
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasColor}" Value="True">
                    <Setter TargetName="Fader" Property="FillBrush" Value="{Binding Color, Converter={StaticResource ConsoleColor}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                    <Setter TargetName="Fader" Property="IsEnabled" Value="False" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Label presentation: a heading with an optional colour bar. -->
        <DataTemplate x:Key="LabelTemplate" DataType="{x:Type vm:ConsoleWidgetViewModel}">
            <DockPanel Margin="4,0">
                <Rectangle
                    Width="4"
                    Margin="0,4,8,4"
                    DockPanel.Dock="Left"
                    Fill="{Binding Color, Converter={StaticResource ConsoleColor}}"
                    RadiusX="2"
                    RadiusY="2"
                    Visibility="{Binding HasColor, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding DisplayLabel}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding DisplayLabel}"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- Picks the template from the widget's presentation (Buttons ⇄ Sliders switches it live). -->
        <Style x:Key="WidgetBody" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ContentTemplate" Value="{StaticResource TileTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presentation}" Value="{x:Static console:WidgetPresentation.Slider}">
                    <Setter Property="ContentTemplate" Value="{StaticResource FaderTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Presentation}" Value="{x:Static console:WidgetPresentation.Label}">
                    <Setter Property="ContentTemplate" Value="{StaticResource LabelTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Height" Value="{StaticResource Dmx.ControlHeight}" />
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Dmx.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═══════════ Page toolbar ═══════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PageToolbar}">
            <DockPanel LastChildFill="True">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <ToggleButton
                        AutomationProperties.Name="Show buttons as sliders"
                        IsChecked="{Binding SelectedPage.ShowButtonsAsSliders, Mode=TwoWay}"
                        IsEnabled="{Binding HasSelectedPage}"
                        Style="{StaticResource ConsoleToolbarToggle}"
                        ToolTip="Swap every function button on this page for a fader of the same colour (and back)">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Channel" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Sliders" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Style="{StaticResource ToolbarSeparator}" Visibility="{Binding ShowEditChrome, Converter={StaticResource BoolToVisibility}}" />
                    <ToggleButton
                        AutomationProperties.Name="{Binding EditLayoutLabel}"
                        IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                        IsEnabled="{Binding HasSelectedPage}"
                        Style="{StaticResource ToolbarEditToggleButton}"
                        ToolTip="Edit layout: add, move, resize and set up widgets"
                        Visibility="{Binding ShowEditChrome, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Edit" Size="{StaticResource Dmx.EditButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="{Binding EditLayoutLabel}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="Operator mode"
                        IsChecked="{Binding IsOperatorMode, Mode=TwoWay}"
                        Style="{StaticResource ConsoleToolbarToggle}"
                        ToolTip="Operator mode (F12): locks the layout and hides editing; not saved">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Size="{StaticResource Dmx.ButtonIconSize}">
                                <c:DmxIcon.Style>
                                    <Style TargetType="c:DmxIcon">
                                        <Setter Property="Kind" Value="Unlock" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOperatorMode}" Value="True">
                                                <Setter Property="Kind" Value="Lock" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </c:DmxIcon.Style>
                            </c:DmxIcon>
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Operator mode" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Shows: every show of the project"
                        Command="{Binding OpenShowsTabCommand}"
                        Style="{StaticResource ConsoleShowsTab}"
                        ToolTip="All shows of the project: pick one and play it">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Kind="Play"
                                Size="{StaticResource Dmx.DenseIconSize}" />
                            <TextBlock VerticalAlignment="Center" Text="Shows" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparator}" Margin="4,0,6,0" />
                    <ListBox
                        x:Name="PageTabs"
                        AutomationProperties.Name="Console pages"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ConsolePageTab}"
                        ItemsSource="{Binding Pages}"
                        MouseDoubleClick="OnPageTabsDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedPage}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VirtualConsolePageViewModel}">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBox
                                        MinWidth="120"
                                        Margin="-8,0"
                                        VerticalAlignment="Center"
                                        IsVisibleChanged="OnRenameBoxVisibleChanged"
                                        KeyDown="OnRenameBoxKeyDown"
                                        LostKeyboardFocus="OnRenameBoxLostFocus"
                                        Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowEditChrome, Converter={StaticResource BoolToVisibility}}">
                        <Button
                            AutomationProperties.Name="Add page"
                            Command="{Binding AddPageCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Add a console page">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ToolbarIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Rename page"
                            Command="{Binding RenamePageCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Rename the page (F2)">
                            <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.ToolbarIconSize}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Delete page"
                            Command="{Binding DeletePageCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Delete the page and its widgets">
                            <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.ToolbarIconSize}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════ Show transport bar (bottom, every page, also in operator mode) ═══════════ -->
        <views:ConsoleShowTransportBar
            x:Name="TransportBar"
            DataContext="{Binding ShowPlayer}"
            DockPanel.Dock="Bottom" />

        <!-- ═══════════ Edit panel (right): palette + properties ═══════════ -->
        <Border
            Width="248"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            DockPanel.Dock="Right"
            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Add widget" />
                </Border>
                <StackPanel Margin="4" DockPanel.Dock="Top">
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VirtualConsolePaletteItem}">
                                <Button
                                    Margin="0,0,0,1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Add {0}'}"
                                    Command="{Binding DataContext.AddWidgetCommand, ElementName=Root}"
                                    CommandParameter="{Binding Kind}"
                                    PreviewMouseLeftButtonDown="OnPaletteMouseDown"
                                    PreviewMouseMove="OnPaletteMouseMove"
                                    Style="{StaticResource ToolbarLabelButton}"
                                    ToolTip="{Binding Description}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:DmxIcon Kind="{Binding Icon}" Size="{StaticResource Dmx.ButtonIconSize}" />
                                        <TextBlock
                                            Style="{StaticResource ButtonLabel}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="4,2,0,0"
                        Style="{StaticResource HintText}"
                        Text="Click to add at the first free spot, or drag onto the page." />
                </StackPanel>

                <Border
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Top"
                    Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding HasSelectedWidget, Converter={StaticResource BoolToVisibility}}">
                            <Button
                                AutomationProperties.Name="Duplicate widget"
                                Command="{Binding DuplicateWidgetCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Duplicate (Ctrl+D)">
                                <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.SmallIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Delete widget"
                                Command="{Binding DeleteWidgetCommand}"
                                Style="{StaticResource PanelHeaderButton}"
                                ToolTip="Delete (Del)">
                                <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Properties" />
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBlock
                        Margin="8"
                        Style="{StaticResource HintText}"
                        Text="Select a widget on the page to change its label, colour, target and key. Drag to move, drag the corner to resize, arrow keys nudge (Shift+arrows resize)."
                        Visibility="{Binding HasNoSelectedWidget, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer
                        DataContext="{Binding SelectedWidget}"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding DataContext.HasSelectedWidget, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Text="Label" />
                            <ui:TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                AutomationProperties.Name="Label"
                                Style="{StaticResource FormTextBox}"
                                Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource FormLabel}"
                                Text="{Binding TargetCaption}"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.Name="{Binding TargetCaption}"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding DataContext.SelectedTargetOptions, ElementName=Root}"
                                SelectedValue="{Binding TargetId}"
                                SelectedValuePath="Id"
                                Style="{StaticResource FormComboBox}"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource FormLabel}"
                                Text="Mode"
                                Visibility="{Binding HasMode, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationProperties.Name="Mode"
                                ItemsSource="{Binding DataContext.ModeOptions, ElementName=Root}"
                                SelectedItem="{Binding Mode}"
                                Style="{StaticResource FormComboBox}"
                                ToolTip="Toggle: click on, click off. Flash: on only while held."
                                Visibility="{Binding HasMode, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource FormLabel}"
                                Text="Key" />
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <ui:TextBox
                                    AutomationProperties.Name="Key shortcut"
                                    PlaceholderText="e.g. A, 1, F5"
                                    Style="{StaticResource FormTextBox}"
                                    Text="{Binding KeyShortcut}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="4"
                                Margin="0,2,8,4"
                                VerticalAlignment="Top"
                                Style="{StaticResource FormLabel}"
                                Text="Colour" />
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding DataContext.ColorPresets, ElementName=Root}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VirtualConsoleColorPreset}">
                                            <Button
                                                AutomationProperties.Name="{Binding Name}"
                                                Background="{Binding Hex, Converter={StaticResource ConsoleColor}}"
                                                Command="{Binding DataContext.SetColorCommand, ElementName=Root}"
                                                CommandParameter="{Binding Hex}"
                                                Style="{StaticResource ColorSwatch}"
                                                ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,2,0,0">
                                    <Button
                                        Margin="4,0,0,4"
                                        AutomationProperties.Name="Theme colour"
                                        Command="{Binding DataContext.SetColorCommand, ElementName=Root}"
                                        CommandParameter="{x:Null}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ToolbarLabelButton}"
                                        ToolTip="Use the theme colour (no widget colour)">
                                        <TextBlock Text="None" />
                                    </Button>
                                    <ui:TextBox
                                        AutomationProperties.Name="Colour hex"
                                        PlaceholderText="#RRGGBB"
                                        Style="{StaticResource FormTextBox}"
                                        Text="{Binding ColorText}" />
                                </DockPanel>
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource HintText}"
                                    Text="Use the form #RRGGBB, e.g. #FF8000."
                                    Visibility="{Binding HasColorError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Margin="0,2,0,0"
                                Style="{StaticResource HintText}"
                                Text="Key shortcuts work on the active page when not editing. F12 is reserved for operator mode." />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══════════ Canvas ═══════════ -->
        <Grid
            x:Name="CanvasHost"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            SizeChanged="OnCanvasHostSizeChanged">
            <ScrollViewer
                x:Name="CanvasScroller"
                Focusable="False"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding ShowCanvas, Converter={StaticResource BoolToVisibility}}">
                <Grid
                    x:Name="WidgetSurface"
                    Width="{Binding CanvasWidth}"
                    Height="{Binding CanvasHeight}"
                    Margin="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AllowDrop="True"
                    Background="Transparent"
                    DragOver="OnSurfaceDragOver"
                    Drop="OnSurfaceDrop"
                    MouseLeftButtonDown="OnSurfaceMouseDown">
                    <c:ConsoleGridLines
                        CellSize="{Binding CellSize}"
                        Columns="{Binding SelectedPage.Columns, FallbackValue=24}"
                        IsHitTestVisible="False"
                        LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Rows="{Binding SelectedPage.Rows, FallbackValue=16}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl
                        Focusable="False"
                        ItemsSource="{Binding SelectedPage.Widgets}"
                        KeyboardNavigation.TabNavigation="Local">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource CellsToPixels}">
                                            <Binding Path="X" />
                                            <Binding ElementName="Root" Path="DataContext.CellSize" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Canvas.Top">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource CellsToPixels}">
                                            <Binding Path="Y" />
                                            <Binding ElementName="Root" Path="DataContext.CellSize" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Width">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource CellsToPixels}">
                                            <Binding Path="Width" />
                                            <Binding ElementName="Root" Path="DataContext.CellSize" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Height">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource CellsToPixels}">
                                            <Binding Path="Height" />
                                            <Binding ElementName="Root" Path="DataContext.CellSize" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConsoleWidgetViewModel}">
                                <Grid Margin="2">
                                    <ContentControl Content="{Binding}" Style="{StaticResource WidgetBody}" />

                                    <!-- Edit layer: covers the widget in edit mode (select, drag to move, corner to resize). -->
                                    <Grid
                                        Background="Transparent"
                                        Cursor="SizeAll"
                                        LostMouseCapture="OnEditLayerLostCapture"
                                        MouseLeftButtonDown="OnEditLayerMouseDown"
                                        MouseLeftButtonUp="OnEditLayerMouseUp"
                                        MouseMove="OnEditLayerMouseMove"
                                        ToolTip="{Binding DisplayLabel}"
                                        Visibility="{Binding DataContext.IsEditMode, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                                        <Rectangle
                                            x:Name="Frame"
                                            RadiusX="6"
                                            RadiusY="6"
                                            Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                            StrokeDashArray="2 2"
                                            StrokeThickness="1" />
                                        <Border
                                            x:Name="ResizeHandle"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,-3,-3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                            BorderThickness="2"
                                            CornerRadius="3"
                                            Cursor="SizeNWSE"
                                            Tag="Resize"
                                            ToolTip="Drag to resize"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Frame" Property="StrokeThickness" Value="2" />
                                        <Setter TargetName="Frame" Property="StrokeDashArray" Value="{x:Null}" />
                                        <Setter TargetName="ResizeHandle" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Page exists but is empty. -->
            <StackPanel
                IsHitTestVisible="False"
                Style="{StaticResource EmptyStatePanel}"
                Visibility="{Binding IsSelectedPageEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource EmptyStateTitle}" Text="This page is empty" />
                <TextBlock Style="{StaticResource EmptyStateText}" Text="Turn on Edit layout, then click or drag buttons and faders from the palette on the right." />
            </StackPanel>

            <!-- Fixed Shows tab: the list of every show. -->
            <views:ConsoleShowsPanel
                x:Name="ShowsPanel"
                DataContext="{Binding ShowPlayer}"
                Visibility="{Binding DataContext.IsShowsTabSelected, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

            <!-- No pages at all. -->
            <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding ShowNoConsoleState, Converter={StaticResource BoolToVisibility}}">
                <c:DmxIcon
                    Kind="Console"
                    Size="{StaticResource Dmx.EmptyStateIconSize}"
                    Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No console yet" />
                <TextBlock Style="{StaticResource EmptyStateText}" Text="Create a ready-made page (Blackout, Release All, Master, colour buttons and chasers from your functions) or start with an empty page." />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Command="{Binding CreateDefaultPageCommand}" Style="{StaticResource ToolbarPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Wizard" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Create default page" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding AddPageCommand}"
                        Style="{StaticResource ToolbarLabelButton}">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Empty page" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
