<UserControl
    x:Class="DmxPro.App.Views.SceneChannelsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SceneChannelsTabViewModel}"
    d:DesignHeight="520"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <!--
        "Channels" tab of the Scene editor. Scales to hundreds of fixtures: the left list picks which lights to
        edit (virtualized, extended selection, all selected when the editor opens), the right side shows one fader
        bank per selected light side by side in a virtualized horizontal strip: every channel of its profile mode,
        0-255. The strip on top sets one channel type on all selected lights at once.

        ┌ [search lights   ] ┐║┌ Set on selected [Red · 4 lights ▾] ───●──── [255]          4 lights · 32 channels ┐
        │ [Select all][Clear]│║├ PAR 1            [✓][-] ┬ PAR 2 ...                                              ┤
        │ ▣ PAR 1 U1 · 1–8 ⚠ │║│ [x][x][x][x][ ][x]...   │                                                       │
        │ ▣ PAR 2 U1 · 9–16  │║│  ▮  ▮  ▮  ▯  ▯  ▮       │   (each fader: include, icon, value box, slider,      │
        │ ...                │║│  1  2  3  4  5  6       │    number, name, DMX address)                         │
        └────────────────────┘║└─────────────────────────┴───────────────────────────────────────────────────────┘
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="200"
                MinWidth="150"
                MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!--  ═════════════ Left: light picker ═════════════  -->
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <StackPanel Margin="4,2" DockPanel.Dock="Top">
                    <Grid>
                        <ui:TextBox
                            Margin="0"
                            Padding="26,4,8,0"
                            AutomationProperties.Name="Search lights"
                            PlaceholderText="Search lights"
                            Style="{StaticResource FormTextBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Filter the lights by name" />
                        <c:DmxIcon
                            Margin="7,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            IsHitTestVisible="False"
                            Kind="Search"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                    </Grid>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Style="{StaticResource StatusText}"
                            Text="{Binding SelectedCount, StringFormat={}{0} selected}" />
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Height="{StaticResource Dmx.PanelHeaderButtonSize}"
                                Margin="0,0,2,0"
                                Padding="4,0"
                                AutomationProperties.Name="Select all lights"
                                Command="{Binding SelectAllCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Select all listed lights: show the faders of every light (Ctrl+A)">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="SelectAll" Size="{StaticResource Dmx.DenseIconSize}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Text="All" />
                                </StackPanel>
                            </Button>
                            <Button
                                Height="{StaticResource Dmx.PanelHeaderButtonSize}"
                                Padding="4,0"
                                AutomationProperties.Name="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Clear selection (Esc)">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Close" Size="{StaticResource Dmx.DenseIconSize}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Text="None" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <ListBox
                    AutomationProperties.Name="Lights in this scene"
                    BorderThickness="0"
                    ItemsSource="{Binding FilteredFixtures}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Extended"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.InputBindings>
                        <!--  Route Ctrl+A / Esc to the VM so off-screen (virtualized) items are selected too.  -->
                        <KeyBinding
                            Command="{Binding SelectAllCommand}"
                            Key="A"
                            Modifiers="Control" />
                        <KeyBinding Command="{Binding ClearSelectionCommand}" Key="Escape" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SceneFixtureTabViewModel}">
                            <!--  One line per light: icon, name, detail (trims first), caution mark.  -->
                            <DockPanel ToolTip="{Binding Detail}">
                                <c:DmxIcon
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Kind="{Binding IconKind}"
                                    Size="{StaticResource Dmx.DenseIconSize}" />
                                <c:DmxIcon
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Kind="Unverified"
                                    Size="{StaticResource Dmx.DenseIconSize}"
                                    ToolTip="Unverified profile: channel meanings are not confirmed"
                                    Visibility="{Binding ProfileUnverified, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <Run Text="{Binding Header, Mode=OneWay}" />
                                    <Run
                                        FontSize="{StaticResource Dmx.FontSize.Caption}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Detail, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

        <!--  ═════════════ Right: fader banks of the selected lights ═════════════  -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <!--  Set one channel type on every selected light (resolved from each profile; Unknown/Fine not offered).  -->
                <Border
                    DockPanel.Dock="Top"
                    Style="{StaticResource ToolbarStrip}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Style="{StaticResource StatusText}"
                            Text="{Binding SelectionSummary}" />
                        <!--
                            Copy the first selected light, paste onto every selected light (QLC+ copy / paste values).
                            One place for both, at the left of the strip.
                        -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Copy values of the first selected light"
                                Command="{Binding CopySelectedCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Copy: remember the channel values of the first selected light. Select one light on the left, then Copy.">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Copy" Size="{StaticResource Dmx.ButtonIconSize}" />
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Paste to all selected lights"
                                Command="{Binding PasteToSelectedCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Paste to selected: set every selected light to the copied values (each matched by its own profile, e.g. Red to Red)">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Paste" Size="{StaticResource Dmx.ButtonIconSize}" />
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Paste to selected" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource StatusText}"
                                Text="{Binding CopiedText}" />
                            <Rectangle Style="{StaticResource ToolbarSeparator}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasBulkTypes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Set on selected" />
                            <ComboBox
                                MinWidth="160"
                                Margin="0"
                                AutomationProperties.Name="Channel type to set on all selected lights"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding BulkTypes}"
                                SelectedItem="{Binding BulkType}"
                                Style="{StaticResource FormComboBox}"
                                ToolTip="Which channel type to set. Each light's profile decides which of its channels that is." />
                            <Slider
                                Width="140"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Level for all selected lights, 0 to 255"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                LargeChange="10"
                                Maximum="255"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                ToolTip="Moves this channel type on every selected light (and includes it in the scene)"
                                Value="{Binding BulkValue}" />
                            <c:DmxValueBox
                                Width="48"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Level for all selected lights"
                                ToolTip="Type 0–255 and press Enter to set it on every selected light · ↑/↓ ±1 · PageUp/PageDown ±10"
                                Value="{Binding BulkValue}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <ItemsControl
                        AutomationProperties.Name="Channel faders of the selected lights"
                        Focusable="False"
                        ItemsSource="{Binding SelectedBanks}"
                        KeyboardNavigation.TabNavigation="Continue"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer
                                    CanContentScroll="True"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SceneFixtureTabViewModel}">
                                <!--  Thin divider on the right separates neighbouring banks.  -->
                                <Border
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,1,0"
                                    SnapsToDevicePixels="True">
                                    <views:SceneFixtureTab />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Empty state  -->
                    <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            Kind="Channel"
                            Size="{StaticResource Dmx.EmptyStateIconSize}"
                            Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No lights selected" />
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="Select lights on the left to edit their channels, or click All. Use Ctrl or Shift to pick several." />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
