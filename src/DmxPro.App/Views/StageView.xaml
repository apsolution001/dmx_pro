<UserControl
    x:Class="DmxPro.App.Views.StageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:StagePageViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <!--
        Stage (virtual stage plan). The lights glow in what the engine sends, also while output is disabled.

        ┌ [Place unplaced] [Arrange ▾] │ [Fit] [Names] │ Stage [12] × [8] m                                     ┐
        ├ ⚠ error strip (only when the live preview or an edit failed)                                         ┤
        │ Lights          │ ┌──────────────── dark stage floor, metre grid ────────────────┐                  │
        │ [search]        │ │        ●          ●          ●          ●                    │                  │
        │ ✓ PAR 1  U1·1   │ │       ╱ ╲        ╱ ╲        ╱ ╲        ╱ ╲  (glow + beam)    │                  │
        │   PAR 9  U1·81  │ └══════════════════════ front edge ════════════════════════════┘                  │
        │ (drag onto the  │                         AUDIENCE                                                  │
        ├ 38 lights · 36 on stage · 2 not placed · live      Showing what would be sent — output is disabled    ┤
    -->
    <UserControl.Resources>
        <Style x:Key="StageSizeBox" BasedOn="{StaticResource FormNumberBox}" TargetType="ui:NumberBox">
            <Setter Property="Width" Value="84" />
            <Setter Property="Minimum" Value="{x:Static vm:StagePageViewModel.MinStageSize}" />
            <Setter Property="Maximum" Value="{x:Static vm:StagePageViewModel.MaxStageSize}" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="2" />
            <Setter Property="MaxDecimalPlaces" Value="2" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═════════════ Page toolbar ═════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PageToolbar}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="Place unplaced lights"
                    Command="{Binding PlaceUnplacedCommand}"
                    Style="{StaticResource ToolbarLabelButton}"
                    ToolTip="Place unplaced: put every light that is not on the stage yet into free spots">
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon Kind="AutoPatch" Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Place unplaced" />
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.Name="Arrange menu"
                    Click="OnArrangeMenuButtonClick"
                    Style="{StaticResource ToolbarLabelButton}"
                    ToolTip="Arrange the lights on the stage evenly (all lights on the stage; every light when none is placed yet)">
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon Kind="AddressMap" Size="{StaticResource Dmx.ButtonIconSize}" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Arrange" />
                        <c:DmxIcon
                            Margin="4,0,0,0"
                            Kind="ChevronDown"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding ArrangeInLineCommand}" Header="In one line" />
                            <MenuItem Command="{Binding ArrangeInGridCommand}" Header="In a grid" />
                            <MenuItem Header="In a grid with">
                                <MenuItem
                                    Command="{Binding ArrangeInGridCommand}"
                                    CommandParameter="2"
                                    Header="2 columns" />
                                <MenuItem
                                    Command="{Binding ArrangeInGridCommand}"
                                    CommandParameter="3"
                                    Header="3 columns" />
                                <MenuItem
                                    Command="{Binding ArrangeInGridCommand}"
                                    CommandParameter="4"
                                    Header="4 columns" />
                                <MenuItem
                                    Command="{Binding ArrangeInGridCommand}"
                                    CommandParameter="6"
                                    Header="6 columns" />
                                <MenuItem
                                    Command="{Binding ArrangeInGridCommand}"
                                    CommandParameter="8"
                                    Header="8 columns" />
                                <MenuItem
                                    Command="{Binding ArrangeInGridCommand}"
                                    CommandParameter="12"
                                    Header="12 columns" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button
                    AutomationProperties.Name="Remove the selected light from the stage"
                    Command="{Binding RemoveFromStageCommand}"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Remove from stage: take the selected light off the plan (Delete). It stays patched.">
                    <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.ToolbarIconSize}" />
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparator}" />

                <Button
                    AutomationProperties.Name="Zoom to fit"
                    Command="{Binding FitCommand}"
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Fit: zoom so the whole stage is visible (Home). Mouse wheel zooms, middle or right drag pans.">
                    <c:DmxIcon Kind="FullScreen" Size="{StaticResource Dmx.ToolbarIconSize}" />
                </Button>
                <ToggleButton
                    AutomationProperties.Name="Show light names"
                    IsChecked="{Binding ShowNames}"
                    Style="{StaticResource ToolbarToggleButton}"
                    ToolTip="Show or hide the names under the lights">
                    <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.ToolbarIconSize}" />
                </ToggleButton>

                <Rectangle Style="{StaticResource ToolbarSeparator}" />

                <TextBlock
                    Margin="2,0,6,0"
                    VerticalAlignment="Center"
                    Text="Stage" />
                <ui:NumberBox
                    AutomationProperties.Name="Stage width in metres"
                    Style="{StaticResource StageSizeBox}"
                    ToolTip="Stage width in metres (left to right)"
                    Value="{Binding StageWidth, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Text="×" />
                <ui:NumberBox
                    AutomationProperties.Name="Stage depth in metres"
                    Style="{StaticResource StageSizeBox}"
                    ToolTip="Stage depth in metres (front to back)"
                    Value="{Binding StageDepth, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Text="m" />
            </StackPanel>
        </Border>

        <!-- ═════════════ Error strip (live preview stopped / edit failed; safety rule 10) ═════════════ -->
        <Border
            Padding="6,3"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <c:DmxIcon
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Kind="Error"
                    Size="{StaticResource Dmx.DenseIconSize}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource Dmx.FontSize.Small}"
                    FontWeight="SemiBold"
                    Text="{Binding ErrorMessage}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- ═════════════ Status line ═════════════ -->
        <Border
            Padding="8,2"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding OutputNote, Converter={StaticResource NullToVisibility}}">
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Kind="OutputOff"
                        Size="{StaticResource Dmx.DenseIconSize}" />
                    <TextBlock
                        Style="{StaticResource StatusText}"
                        Text="{Binding OutputNote}"
                        ToolTip="The stage shows the values after Grand Master, Blackout and strobe safety. Enable output in Input / Output (Ctrl+6) to send them to the real lights." />
                </StackPanel>
                <TextBlock
                    AutomationProperties.LiveSetting="Off"
                    Style="{StaticResource StatusText}"
                    Text="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <!-- ═════════════ Body: lights list | stage ═════════════ -->
        <Grid Margin="{StaticResource Dmx.PageBodyMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ═════════════ Lights list (drag source) ═════════════ -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <c:DmxIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Kind="Fixtures"
                                Size="{StaticResource Dmx.SmallIconSize}" />
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Lights" />
                        </DockPanel>
                    </Border>

                    <Grid Margin="4,4,4,2" DockPanel.Dock="Top">
                        <ui:TextBox
                            Margin="0"
                            Padding="26,3,8,0"
                            AutomationProperties.Name="Search lights"
                            PlaceholderText="Search lights"
                            Style="{StaticResource FormTextBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Filter the lights by name, universe or profile" />
                        <c:DmxIcon
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            IsHitTestVisible="False"
                            Kind="Search"
                            Size="{StaticResource Dmx.SmallIconSize}" />
                    </Grid>

                    <TextBlock
                        Margin="6,0,6,4"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource HintText}"
                        Text="Drag a light onto the stage to place it. Enter places the selected light, Delete takes it off." />

                    <Grid>
                        <ListBox
                            x:Name="LightList"
                            AutomationProperties.Name="Lights"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredLights}"
                            PreviewMouseLeftButtonDown="OnLightListPreviewMouseLeftButtonDown"
                            PreviewMouseMove="OnLightListPreviewMouseMove"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedLight}"
                            SelectionMode="Single"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.InputBindings>
                                <KeyBinding Command="{Binding PlaceOnStageCommand}" Key="Enter" />
                                <KeyBinding Command="{Binding RemoveFromStageCommand}" Key="Delete" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="MinHeight" Value="{StaticResource Dmx.ListRowMinHeight}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem
                                                    Command="{Binding PlaceOnStageCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Place on stage"
                                                    InputGestureText="Enter" />
                                                <MenuItem
                                                    Command="{Binding RemoveFromStageCommand}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Header="Remove from stage"
                                                    InputGestureText="Delete" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StageLightViewModel}">
                                    <DockPanel x:Name="Row">
                                        <!-- On-stage mark; empty space keeps the names aligned. -->
                                        <Grid
                                            Width="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left">
                                            <c:DmxIcon
                                                x:Name="PlacedMark"
                                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                Kind="Check"
                                                Size="{StaticResource Dmx.DenseIconSize}"
                                                Visibility="{Binding IsPlaced, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock
                                                x:Name="NameText"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDrawable}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Margin="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintText}"
                            Text="No matching lights."
                            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

            <!-- ═════════════ The stage (floor stays dark in both themes, like a real stage) ═════════════ -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <c:StageCanvas
                        AutomationProperties.HelpText="Click a light to select it, drag to move it (Shift: free move), arrow keys nudge it, Delete removes it, mouse wheel zooms, middle or right drag pans, Home fits the stage."
                        AutomationProperties.Name="Stage plan"
                        FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        SelectionBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        Stage="{Binding}" />

                    <!-- Nothing patched -->
                    <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasNoLights, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            Kind="Stage"
                            Size="{StaticResource Dmx.EmptyStateIconSize}"
                            Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No lights patched yet" />
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="Add lights on the Fixtures page (Ctrl+1); they appear here on the stage plan and glow in their live colour." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
