<UserControl
    x:Class="DmxPro.App.Views.ConsoleShowTransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ShowPlayerViewModel}"
    d:DesignWidth="1100"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewKeyUp="OnPreviewKeyUp"
    mc:Ignorable="d">

    <!--
        Show transport bar docked at the bottom of the Virtual Console (every page, also in operator mode).
        DataContext = ShowPlayerViewModel. Timeline only: no editing, faint item blocks for orientation.
    -->
    <UserControl.Resources>
        <!-- Product of [fraction 0..1, size in px] → px. -->
        <c:ConsoleCellsToPixelsConverter x:Key="FractionToPixels" />

        <!-- Transport buttons stay one step larger than toolbar buttons: they are used live. -->
        <Style
            x:Key="TransportButton"
            BasedOn="{StaticResource ToolbarButton}"
            TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style
            x:Key="TransportSkipButton"
            BasedOn="{StaticResource ToolbarLabelButton}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Small}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- Fast-forward / rewind: press = one seek step, hold = repeat every 150 ms (accelerating in the ViewModel). -->
        <Style x:Key="TransportRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template" Value="{StaticResource Dmx.SubtleButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="{StaticResource Dmx.FontSize.Small}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Delay" Value="350" />
            <Setter Property="Interval" Value="150" />
        </Style>

        <!-- Double-triangle glyphs (24×24 box), filled with the inherited text colour so hover/disabled states apply. -->
        <Style x:Key="TransportGlyph" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- Diagonal stripes (alpha mask only, so the colour still comes from the theme brush it masks). -->
        <LinearGradientBrush
            x:Key="OverrideStripes"
            MappingMode="Absolute"
            SpreadMethod="Repeat"
            StartPoint="0,0"
            EndPoint="8,8">
            <GradientStop Offset="0" Color="Black" />
            <GradientStop Offset="0.5" Color="Black" />
            <GradientStop Offset="0.5" Color="#40000000" />
            <GradientStop Offset="1" Color="#40000000" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border
        MinHeight="34"
        Padding="8,2"
        Background="{DynamicResource LayerFillColorDefaultBrush}"
        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MaxWidth="240" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Transport buttons ═══ -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!-- Play/pause: the widest, accent-filled button so it is found at a glance. -->
                <Button
                    Width="36"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="{Binding PlayPauseToolTip}"
                    Command="{Binding PlayPauseCommand}"
                    Style="{StaticResource ToolbarPrimaryButton}"
                    ToolTip="{Binding PlayPauseToolTip}">
                    <c:DmxIcon Kind="{Binding PlayPauseIcon}" Size="{StaticResource Dmx.ButtonIconSize}" />
                </Button>
                <Button
                    AutomationProperties.Name="Stop show"
                    Command="{Binding StopCommand}"
                    Style="{StaticResource TransportButton}"
                    ToolTip="Stop the show and release its lights">
                    <c:DmxIcon Kind="Stop" Size="{StaticResource Dmx.ToolbarIconSize}" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparator}" />
                <RepeatButton
                    AutomationProperties.Name="Rewind"
                    Command="{Binding FastSeekCommand}"
                    CommandParameter="-1"
                    LostMouseCapture="OnFastSeekLostCapture"
                    PreviewMouseLeftButtonUp="OnFastSeekMouseUp"
                    Style="{StaticResource TransportRepeatButton}"
                    ToolTip="Rewind: click to jump back one seek step, hold to rewind faster (Left arrow while the bar has focus; step size in Settings). The music is silent while you hold and continues in sync when you let go.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M11,6 L3,12 L11,18 Z M21,6 L13,12 L21,18 Z" Style="{StaticResource TransportGlyph}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding LargeStepBackText}" />
                    </StackPanel>
                </RepeatButton>
                <Button
                    AutomationProperties.Name="Back 1 second"
                    Command="{Binding SkipCommand}"
                    CommandParameter="-1"
                    Content="−1 s"
                    Style="{StaticResource TransportSkipButton}"
                    ToolTip="Back 1 second (Shift+Left while the bar has focus)" />
                <Button
                    AutomationProperties.Name="Forward 1 second"
                    Command="{Binding SkipCommand}"
                    CommandParameter="1"
                    Content="+1 s"
                    Style="{StaticResource TransportSkipButton}"
                    ToolTip="Forward 1 second (Shift+Right while the bar has focus)" />
                <RepeatButton
                    AutomationProperties.Name="Fast forward"
                    Command="{Binding FastSeekCommand}"
                    CommandParameter="1"
                    LostMouseCapture="OnFastSeekLostCapture"
                    PreviewMouseLeftButtonUp="OnFastSeekMouseUp"
                    Style="{StaticResource TransportRepeatButton}"
                    ToolTip="Fast forward: click to jump one seek step, hold to go faster (Right arrow while the bar has focus; step size in Settings). The music is silent while you hold and continues in sync when you let go.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding LargeStepForwardText}" />
                        <Path
                            Margin="4,0,0,0"
                            Data="M3,6 L11,12 L3,18 Z M13,6 L21,12 L13,18 Z"
                            Style="{StaticResource TransportGlyph}" />
                    </StackPanel>
                </RepeatButton>
                <Rectangle Style="{StaticResource ToolbarSeparator}" />
            </StackPanel>

            <!-- ═══ Show name + details ═══ -->
            <DockPanel
                Grid.Column="1"
                MinWidth="140"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
                <!-- Music mark: note when the show has music; caution icon + short text when it is missing / broken. -->
                <StackPanel
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding MusicToolTip}"
                    AutomationProperties.Name="Show music"
                    Background="Transparent"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    ToolTip="{Binding MusicToolTip}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMusic}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasActiveShow}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasMusicProblem}" Value="True">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <c:DmxIcon
                        VerticalAlignment="Center"
                        Kind="{Binding MusicIcon}"
                        Size="14" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Assertive"
                        FontSize="{StaticResource Dmx.FontSize.Caption}"
                        FontWeight="SemiBold"
                        Text="{Binding MusicProblemText}"
                        Visibility="{Binding HasMusicProblem, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource Dmx.FontSize.Body}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ActiveShow.Name}"
                        Visibility="{Binding HasActiveShow, Converter={StaticResource BoolToVisibility}}">
                        <Run
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ActiveShow.Name, Mode=OneWay}" />
                        <Run
                            FontSize="{StaticResource Dmx.FontSize.Caption}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ActiveShow.DetailsText, Mode=OneWay, StringFormat=' · {0}'}" />
                    </TextBlock>
                    <TextBlock
                        MaxWidth="240"
                        VerticalAlignment="Center"
                        Style="{StaticResource HintText}"
                        Text="{Binding EmptyBarText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding EmptyBarText}"
                        Visibility="{Binding HasNoActiveShow, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <!-- ═══ Timeline: click/drag to jump; arrows when focused ═══ -->
            <ContentControl
                x:Name="Timeline"
                Grid.Column="2"
                Height="{StaticResource Dmx.ControlHeight}"
                VerticalAlignment="Center"
                AutomationProperties.HelpText="Click or drag to jump. Left/Right arrow: 5 seconds back/forward, with Shift 1 second. Home: start."
                AutomationProperties.Name="Show timeline"
                Cursor="Hand"
                FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                Focusable="True"
                IsEnabled="{Binding HasActiveShow}"
                IsTabStop="True"
                LostMouseCapture="OnTimelineLostMouseCapture"
                MouseLeftButtonDown="OnTimelineMouseDown"
                MouseLeftButtonUp="OnTimelineMouseUp"
                MouseMove="OnTimelineMouseMove"
                ToolTip="Click or drag to jump. Left/Right: ∓5 s (Shift: 1 s), Home: start">
                <Border
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="{StaticResource Dmx.CornerRadius}">
                    <Grid x:Name="TimelineSurface" Background="Transparent">
                        <!-- Faint item blocks per track (orientation only). -->
                        <ItemsControl
                            x:Name="BlockLayer"
                            Margin="0,2"
                            Focusable="False"
                            IsHitTestVisible="False"
                            ItemsSource="{Binding ActiveShow.Blocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource FractionToPixels}">
                                                <Binding Path="Left" />
                                                <Binding ElementName="BlockLayer" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Width">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource FractionToPixels}">
                                                <Binding Path="Width" />
                                                <Binding ElementName="BlockLayer" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Canvas.Top">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource FractionToPixels}">
                                                <Binding Path="Top" />
                                                <Binding ElementName="BlockLayer" Path="ActualHeight" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Height">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource FractionToPixels}">
                                                <Binding Path="Height" />
                                                <Binding ElementName="BlockLayer" Path="ActualHeight" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShowTimelineBlock}">
                                    <Rectangle
                                        Margin="0.5,0.5"
                                        Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                        Opacity="0.35"
                                        RadiusX="2"
                                        RadiusY="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Played part + playhead. Keeps moving while the show is muted by an override. -->
                        <Grid MinWidth="2" HorizontalAlignment="Left">
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource FractionToPixels}">
                                    <Binding Path="Progress" />
                                    <Binding ElementName="TimelineSurface" Path="ActualWidth" />
                                </MultiBinding>
                            </Grid.Width>
                            <Rectangle>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Opacity" Value="0.2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="OpacityMask" Value="{StaticResource OverrideStripes}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <Rectangle
                                Width="2"
                                HorizontalAlignment="Right"
                                Visibility="{Binding HasActiveShow, Converter={StaticResource BoolToVisibility}}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Grid>
                    </Grid>
                </Border>
            </ContentControl>

            <!-- ═══ Time + state ═══ -->
            <StackPanel
                Grid.Column="3"
                Margin="8,0,4,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding HasActiveShow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show time"
                    FontSize="{StaticResource Dmx.FontSize.Body}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Typography.NumeralAlignment="Tabular">
                    <Run Text="{Binding PositionText, Mode=OneWay}" />
                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="/" />
                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ActiveShow.LengthPreciseText, Mode=OneWay}" />
                </TextBlock>
                <Border
                    Margin="8,0,0,0"
                    Style="{StaticResource StatusPill}"
                    Tag="{Binding StatusKind}"
                    ToolTip="{Binding StatusToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <c:DmxIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Kind="{Binding StatusIcon}"
                            Size="12" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontWeight="SemiBold"
                            Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
