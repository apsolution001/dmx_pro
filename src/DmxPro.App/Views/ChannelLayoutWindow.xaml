<ui:FluentWindow
    x:Class="DmxPro.App.Views.ChannelLayoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:conv="clr-namespace:DmxPro.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:validation="clr-namespace:DmxPro.Core.Validation;assembly=DmxPro.Core"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    Title="{Binding WindowTitle}"
    Width="660"
    Height="580"
    MinWidth="560"
    MinHeight="440"
    d:DataContext="{d:DesignInstance Type=vm:ChannelLayoutViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/Logo/dmxpro.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--
        Layout (QLC+ fixture editor, reduced to one channel list):
        ┌ Edit channel layout · Custom Par 7ch ──────────────────────────── ✕ ┐
        │ Name          [Par 7ch                 ]  Manufacturer [Custom     ] │
        │ Start from    [RGBW (4 channels)      ▾] [Apply]   Channels [ 7  ]   │
        │ ⓘ Used by 4 lights: saving updates all of them.                      │
        │ Order  [1 D][2 R][3 G][4 B][5 W][6 S][7 ?]      (chip = function)    │
        │ [+ Insert][+ Add] │ [⧉][🗑] │ [↑][↓]                                 │
        │ ┌ #  Function          Name                  Default ┐               │
        │ │ 1  ☼ Dimmer      ▾   [Dimmer           ]   [255]   │               │
        │ │ 2  ● Red         ▾   [Red              ]   [  0]   │               │
        │ └──────────────────────────────────────────────────────┘             │
        │ ⚠ Channel 7 has an unknown function …   (validation list)            │
        ├───────────────────────────────────────────────────────────────────────┤
        │ Use it for [Selected lights (2) ▾]               [Cancel] [Save]      │
        └───────────────────────────────────────────────────────────────────────┘
    -->
    <ui:FluentWindow.Resources>
        <conv:HexToBrushConverter x:Key="LayoutHexToBrush" />

        <!-- Slim controls that fit the 22 px table row. -->
        <Style
            x:Key="CellComboBox"
            BasedOn="{StaticResource FormComboBox}"
            TargetType="ComboBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style
            x:Key="CellTextBox"
            BasedOn="{StaticResource FormTextBox}"
            TargetType="ui:TextBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4,1,4,0" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style
            x:Key="CellValueBox"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="c:DmxValueBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Value at start and on release (0–255) · Up/Down ±1, PageUp/PageDown ±10" />
        </Style>

        <!-- Function icon: coloured for colour channels, neutral otherwise. -->
        <Style x:Key="TypeIcon" TargetType="c:DmxIcon">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Size" Value="{StaticResource Dmx.DenseIconSize}" />
            <Setter Property="Kind" Value="{Binding IconKind}" />
            <Setter Property="Foreground" Value="{Binding ColorHex, Converter={StaticResource LayoutHexToBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorHex}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TypeOptionTemplate" DataType="{x:Type vm:ChannelLayoutTypeOption}">
            <StackPanel Orientation="Horizontal">
                <c:DmxIcon Style="{StaticResource TypeIcon}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="FooterIcon" TargetType="c:DmxIcon">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Size" Value="{StaticResource Dmx.SmallIconSize}" />
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding CancelCommand}" Gesture="Escape" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding WindowTitle}"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    AutomationProperties.Name="DMX Pro"
                    Source="{StaticResource Dmx.Logo.Small.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <DockPanel Grid.Row="1" Margin="8,2,8,4">
            <!-- ═══════════ Name, manufacturer, template, channel count ═══════════ -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource FormLabel}"
                    Text="Name" />
                <ui:TextBox
                    x:Name="ModelBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    AutomationProperties.Name="Layout name"
                    PlaceholderText="Model of your light, e.g. Par 7ch"
                    Style="{StaticResource FormTextBox}"
                    Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Model name shown in the profile tree (required)" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="12,0,8,4"
                    Style="{StaticResource FormLabel}"
                    Text="Manufacturer" />
                <ui:TextBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Width="140"
                    AutomationProperties.Name="Manufacturer"
                    PlaceholderText="Custom"
                    Style="{StaticResource FormTextBox}"
                    Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Folder in the profile tree (empty = Custom)" />

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource FormLabel}"
                    Text="Start from" />
                <DockPanel Grid.Row="1" Grid.Column="1">
                    <Button
                        Margin="4,0,0,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Apply template"
                        Command="{Binding ApplyTemplateCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarLabelButton}"
                        ToolTip="Replace all channels with the chosen template">
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Apply" />
                    </Button>
                    <ComboBox
                        AutomationProperties.Name="Start from template"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding Templates}"
                        SelectedItem="{Binding SelectedTemplate}"
                        Style="{StaticResource FormComboBox}"
                        ToolTip="A typical channel order to start from. Then change it to match your light." />
                </DockPanel>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="12,0,8,4"
                    Style="{StaticResource FormLabel}"
                    Text="Channels" />
                <ui:NumberBox
                    Grid.Row="1"
                    Grid.Column="3"
                    Width="140"
                    AutomationProperties.Name="Channel count"
                    Maximum="512"
                    Minimum="1"
                    Style="{StaticResource FormNumberBox}"
                    ToolTip="How many DMX channels the light uses in this mode (1–512). More adds Unknown channels at the end; fewer removes from the end."
                    Value="{Binding ChannelCount}" />
            </Grid>

            <!-- Used by N lights (editing a layout the project uses) -->
            <DockPanel
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                Visibility="{Binding HasUsedBy, Converter={StaticResource BoolToVisibility}}">
                <c:DmxIcon
                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                    Kind="Info"
                    Style="{StaticResource FooterIcon}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding UsedByText}"
                    TextWrapping="Wrap" />
            </DockPanel>

            <!-- Copied from a built-in profile -->
            <DockPanel
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                Visibility="{Binding HasSourceHint, Converter={StaticResource BoolToVisibility}}">
                <c:DmxIcon
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Kind="Info"
                    Style="{StaticResource FooterIcon}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SourceHint}"
                    TextWrapping="Wrap" />
            </DockPanel>

            <!-- ═══════════ Live order preview: one chip per channel ═══════════ -->
            <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Left"
                    Style="{StaticResource FormLabel}"
                    Text="Order" />
                <ScrollViewer
                    MaxHeight="72"
                    AutomationProperties.Name="Channel order preview"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelLayoutRowViewModel}">
                                <Border
                                    x:Name="Chip"
                                    Width="26"
                                    Margin="0,0,2,2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    ToolTip="{Binding ChipToolTip}">
                                    <StackPanel>
                                        <!-- Light colour bar (colour channels) or a neutral bar. -->
                                        <Rectangle Height="3">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{Binding ColorHex, Converter={StaticResource LayoutHexToBrush}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ColorHex}" Value="{x:Null}">
                                                            <Setter Property="Fill" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            FontWeight="SemiBold"
                                            Text="{Binding ChipText}" />
                                        <TextBlock
                                            Margin="0,0,0,1"
                                            HorizontalAlignment="Center"
                                            FontSize="{StaticResource Dmx.FontSize.Caption}"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Number}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ═══════════ Validation list (errors block Save) ═══════════ -->
            <ScrollViewer
                MaxHeight="76"
                Margin="0,4,0,0"
                DockPanel.Dock="Bottom"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Problems with this layout"
                    ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type validation:ValidationIssue}">
                            <DockPanel Margin="0,0,0,1">
                                <c:DmxIcon
                                    x:Name="IssueIcon"
                                    Margin="0,1,4,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Kind="Warning"
                                    Size="{StaticResource Dmx.DenseIconSize}" />
                                <TextBlock
                                    x:Name="IssueText"
                                    FontSize="{StaticResource Dmx.FontSize.Small}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static validation:ValidationSeverity.Error}">
                                    <Setter TargetName="IssueIcon" Property="Kind" Value="Error" />
                                    <Setter TargetName="IssueIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="IssueText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ═══════════ Channel table with its own toolbar strip ═══════════ -->
            <Border Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Insert channel"
                                Command="{Binding InsertRowCommand}"
                                Style="{StaticResource ToolbarLabelButton}"
                                ToolTip="Insert an Unknown channel above the selected one (Insert)">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Insert" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Add channel at the end"
                                Command="{Binding AddRowCommand}"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Add an Unknown channel at the end">
                                <c:DmxIcon Kind="New" Size="{StaticResource Dmx.ToolbarIconSize}" />
                            </Button>
                            <Rectangle Style="{StaticResource ToolbarSeparator}" />
                            <Button
                                AutomationProperties.Name="Duplicate channel"
                                Command="{Binding DuplicateRowCommand}"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Duplicate the selected channel (Ctrl+D)">
                                <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.ToolbarIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Delete channel"
                                Command="{Binding DeleteRowCommand}"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Delete the selected channel (Del). Later channels move up.">
                                <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.ToolbarIconSize}" />
                            </Button>
                            <Rectangle Style="{StaticResource ToolbarSeparator}" />
                            <Button
                                AutomationProperties.Name="Move channel up"
                                Command="{Binding MoveRowUpCommand}"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Move the selected channel up (Alt+Up)">
                                <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.ToolbarIconSize}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Move channel down"
                                Command="{Binding MoveRowDownCommand}"
                                Style="{StaticResource ToolbarButton}"
                                ToolTip="Move the selected channel down (Alt+Down)">
                                <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.ToolbarIconSize}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <DataGrid
                        x:Name="RowGrid"
                        AutomationProperties.Name="Channels in DMX order"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Rows}"
                        KeyboardNavigation.TabNavigation="Continue"
                        SelectedItem="{Binding SelectedRow}"
                        SelectionMode="Single"
                        Style="{StaticResource DataTable}">
                        <DataGrid.InputBindings>
                            <KeyBinding Command="{Binding DeleteRowCommand}" Gesture="Delete" />
                            <KeyBinding Command="{Binding InsertRowCommand}" Gesture="Insert" />
                            <KeyBinding Command="{Binding DuplicateRowCommand}" Gesture="Ctrl+D" />
                            <KeyBinding Command="{Binding MoveRowUpCommand}" Gesture="Alt+Up" />
                            <KeyBinding Command="{Binding MoveRowDownCommand}" Gesture="Alt+Down" />
                        </DataGrid.InputBindings>
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource DataTableRow}" TargetType="DataGridRow">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <EventSetter Event="GotKeyboardFocus" Handler="OnRowGotKeyboardFocus" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding InsertRowCommand}"
                                    Header="Insert channel above"
                                    InputGestureText="Insert">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding DuplicateRowCommand}"
                                    Header="Duplicate"
                                    InputGestureText="Ctrl+D">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding DeleteRowCommand}"
                                    Header="Delete"
                                    InputGestureText="Del">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Command="{Binding MoveRowUpCommand}"
                                    Header="Move up"
                                    InputGestureText="Alt+Up">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="MoveUp" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding MoveRowDownCommand}"
                                    Header="Move down"
                                    InputGestureText="Alt+Down">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="MoveDown" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="36"
                                Binding="{Binding Number}"
                                Header="#" />
                            <DataGridTemplateColumn
                                Width="150"
                                MinWidth="120"
                                Header="Function">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChannelLayoutRowViewModel}">
                                        <ComboBox
                                            AutomationProperties.Name="{Binding Number, StringFormat=Function of channel {0}}"
                                            ItemTemplate="{StaticResource TypeOptionTemplate}"
                                            ItemsSource="{x:Static vm:ChannelLayoutTypeOption.All}"
                                            SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Type"
                                            Style="{StaticResource CellComboBox}"
                                            ToolTip="What this channel controls on your light (see its manual)" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="*"
                                MinWidth="120"
                                Header="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChannelLayoutRowViewModel}">
                                        <ui:TextBox
                                            AutomationProperties.Name="{Binding Number, StringFormat=Name of channel {0}}"
                                            PlaceholderText="{Binding Placeholder}"
                                            Style="{StaticResource CellTextBox}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Optional name; empty uses the name shown in grey" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="68" Header="Default">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChannelLayoutRowViewModel}">
                                        <c:DmxValueBox
                                            AutomationProperties.Name="{Binding Number, StringFormat=Default value of channel {0}}"
                                            Style="{StaticResource CellValueBox}"
                                            Value="{Binding DefaultValue}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ═══════════ Footer: apply choice, save error, [Cancel] [Save] ═══════════ -->
        <Border
            Grid.Row="2"
            Padding="8,4"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisibility}}">
                    <c:DmxIcon
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Kind="Error"
                        Style="{StaticResource FooterIcon}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding SaveError}"
                        TextWrapping="Wrap" />
                </DockPanel>

                <DockPanel>
                    <StackPanel
                        Margin="8,0,0,0"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            MinWidth="80"
                            Padding="{StaticResource Dmx.ButtonPadding}"
                            AutomationProperties.Name="Cancel"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            ToolTip="Close without saving (Esc)" />
                        <ui:Button
                            x:Name="SaveButton"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Padding="{StaticResource Dmx.ButtonPadding}"
                            Appearance="Primary"
                            AutomationProperties.Name="Save layout"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            ToolTip="Save the layout to your profile library (Ctrl+S)" />
                    </StackPanel>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasApplyTargets, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="Use it for" />
                        <ComboBox
                            MinWidth="200"
                            Margin="0"
                            AutomationProperties.Name="Switch lights to the new layout"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding ApplyTargets}"
                            SelectedItem="{Binding SelectedApplyTarget}"
                            Style="{StaticResource FormComboBox}"
                            ToolTip="After saving, switch these patched lights to the new layout" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
