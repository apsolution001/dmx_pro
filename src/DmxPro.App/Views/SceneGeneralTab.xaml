<UserControl
    x:Class="DmxPro.App.Views.SceneGeneralTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SceneGeneralTabViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <!--
        Scene editor, General tab: only which lights the scene uses. Channel levels are set on the Channels tab; the
        fade times sit in the editor toolbar (FunctionEditorPanel).

        [+ Add ▾] [−] │ [⌕ Find light        ]                                    3 lights
        ┌───┬──────────────┬──────────────────────┬──────────┬──────────────┐
        │ ⚠ │ Name         │ Profile              │ Mode     │ Address      │
        │   │ PAR 1        │ Generic RGBW         │ 4ch      │ U1 · 1–4     │
        └───┴──────────────┴──────────────────────┴──────────┴──────────────┘
    -->
    <UserControl.Resources>
        <!-- Labelled "Add ▾" toggle, as high as the panel-header buttons. -->
        <Style
            x:Key="SceneAddToggle"
            BasedOn="{StaticResource ToolbarToggleButton}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="{StaticResource Dmx.PanelHeaderButtonSize}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <!-- Search box in a toolbar row: the form text box without its bottom form margin. -->
        <Style
            x:Key="SceneSearchBox"
            BasedOn="{StaticResource FormTextBox}"
            TargetType="ui:TextBox">
            <Setter Property="Margin" Value="0" />
            <!-- Left room for the search icon; top/bottom as FormTextBox. -->
            <Setter Property="Padding" Value="26,4,8,0" />
        </Style>

        <!-- Checkbox entry of the Add flyout: icon by kind, name, detail. -->
        <DataTemplate x:Key="SceneChoiceCheckBox" DataType="{x:Type vm:SceneFixtureChoice}">
            <CheckBox
                Margin="0"
                FontSize="{StaticResource Dmx.FontSize.Small}"
                AutomationProperties.Name="{Binding AutomationName}"
                IsChecked="{Binding IsInScene, Mode=TwoWay}">
                <DockPanel>
                    <c:DmxIcon
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Kind="{Binding IconKind}"
                        Size="{StaticResource Dmx.DenseIconSize}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="{StaticResource Dmx.FontSize.Caption}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Detail}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <!-- ═════════════ Toolbar row: Add ▾, Remove, find ═════════════ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
                <DockPanel>
                    <ToggleButton
                        x:Name="AddToggle"
                        AutomationProperties.Name="Add lights or groups to the scene"
                        DockPanel.Dock="Left"
                        IsHitTestVisible="{Binding IsOpen, ElementName=AddPopup, Converter={StaticResource InvertBool}}"
                        Style="{StaticResource SceneAddToggle}"
                        ToolTip="Add lights or whole groups to this scene">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.DenseIconSize}" />
                            <TextBlock
                                Margin="4,0,2,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Dmx.FontSize.Small}"
                                Text="Add" />
                            <c:DmxIcon Kind="ChevronDown" Size="{StaticResource Dmx.DenseIconSize}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        AutomationProperties.Name="Remove selected lights from the scene"
                        Command="{Binding RemoveSelectedCommand}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource PanelHeaderButton}"
                        ToolTip="Remove the selected lights from this scene (Delete)">
                        <c:DmxIcon Kind="Remove" Size="{StaticResource Dmx.DenseIconSize}" />
                    </Button>
                    <Rectangle
                        Margin="4,0"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ToolbarSeparator}" />
                    <Grid
                        Width="180"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                        <ui:TextBox
                            AutomationProperties.Name="Find a light in this scene"
                            PlaceholderText="Find light"
                            Style="{StaticResource SceneSearchBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Filter the list by name, profile, mode or address" />
                        <c:DmxIcon
                            Margin="7,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            IsHitTestVisible="False"
                            Kind="Search"
                            Size="{StaticResource Dmx.DenseIconSize}" />
                    </Grid>
                    <TextBlock
                        Margin="8,0,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusText}"
                        Text="{Binding LightCountText}" />
                </DockPanel>
            </Border>

            <!-- Add flyout: groups first, then fixtures; ticked = in the scene. -->
            <Popup
                x:Name="AddPopup"
                AllowsTransparency="True"
                DockPanel.Dock="Top"
                IsOpen="{Binding IsChecked, ElementName=AddToggle, Mode=TwoWay}"
                KeyDown="OnAddPopupKeyDown"
                Opened="OnAddPopupOpened"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=AddToggle}"
                StaysOpen="False">
                <Border
                    x:Name="AddPopupBody"
                    Width="300"
                    Margin="8,0,8,12"
                    Padding="4"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Dmx.CornerRadius}"
                    KeyboardNavigation.TabNavigation="Cycle">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="16"
                            Direction="270"
                            Opacity="0.28"
                            ShadowDepth="4" />
                    </Border.Effect>
                    <DockPanel>
                        <Grid Margin="0,0,0,4" DockPanel.Dock="Top">
                            <ui:TextBox
                                AutomationProperties.Name="Find a fixture or group to add"
                                PlaceholderText="Find fixture or group"
                                Style="{StaticResource SceneSearchBox}"
                                Text="{Binding AddSearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Filter the list by name or address" />
                            <c:DmxIcon
                                Margin="7,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                IsHitTestVisible="False"
                                Kind="Search"
                                Size="{StaticResource Dmx.DenseIconSize}" />
                        </Grid>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,2"
                                    Style="{StaticResource FormSection}"
                                    Text="Groups" />
                                <TextBlock Text="No groups yet — create them on the Fixtures page.">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource HintText}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvailableGroups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl
                                    AutomationProperties.Name="Groups"
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource SceneChoiceCheckBox}"
                                    ItemsSource="{Binding VisibleGroups}" />

                                <TextBlock
                                    Margin="0,4,0,2"
                                    Style="{StaticResource FormSection}"
                                    Text="Fixtures" />
                                <TextBlock Text="This project has no fixtures yet — patch them on the Fixtures page.">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource HintText}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvailableFixtures.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl
                                    AutomationProperties.Name="Fixtures"
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource SceneChoiceCheckBox}"
                                    ItemsSource="{Binding VisibleFixtures}" />
                                <TextBlock
                                    Style="{StaticResource HintText}"
                                    Text="Nothing matches the search."
                                    Visibility="{Binding HasNoAddMatches, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>

            <!-- ═════════════ Lights in the scene ═════════════ -->
            <Grid>
                <DataGrid
                    AutomationProperties.Name="Lights in this scene"
                    IsReadOnly="True"
                    ItemsSource="{Binding Lights}"
                    SelectedItem="{Binding SelectedLight}"
                    SelectionMode="Extended"
                    Style="{StaticResource DataTable}">
                    <DataGrid.InputBindings>
                        <KeyBinding Command="{Binding RemoveSelectedCommand}" Gesture="Delete" />
                    </DataGrid.InputBindings>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource DataTableRow}" TargetType="DataGridRow">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="96"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTemplateColumn
                            Width="2*"
                            MinWidth="96"
                            Header="Profile"
                            SortMemberPath="Profile">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:SceneLightRow}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Profile}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ProfileToolTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="56"
                            Binding="{Binding Mode}"
                            Header="Mode" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="72"
                            Binding="{Binding Address}"
                            Header="Address" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state: the scene has no lights yet. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style BasedOn="{StaticResource EmptyStatePanel}" TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoLights}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <c:DmxIcon
                        Kind="Fixtures"
                        Size="{StaticResource Dmx.EmptyStateIconSize}"
                        Style="{StaticResource EmptyStateIcon}" />
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No lights in this scene" />
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="Add lights, then set their channels on the Channels tab." />
                </StackPanel>

                <!-- The search hides every light. -->
                <TextBlock
                    Margin="8,32,8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource HintText}"
                    Text="No light in this scene matches the search."
                    Visibility="{Binding HasNoSearchMatches, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
