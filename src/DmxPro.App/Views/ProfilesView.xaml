<UserControl
    x:Class="DmxPro.App.Views.ProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:profiles="clr-namespace:DmxPro.Core.Profiles;assembly=DmxPro.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
    mc:Ignorable="d">
    <DockPanel>
        <!-- Page toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarStrip}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ImportCommand}"
                        Content="Import profile…"
                        Icon="{ui:SymbolIcon ArrowImport24}"
                        ToolTip="Import QLC+ (.qxf) or DMX Pro (.dmxprofile.json) files" />
                    <Rectangle Style="{StaticResource ToolbarSeparator}" />
                    <ui:Button
                        Appearance="Transparent"
                        Content="New profile"
                        Icon="{ui:SymbolIcon Add24}"
                        IsEnabled="False"
                        ToolTip="Profile editor — coming next"
                        ToolTipService.ShowOnDisabled="True" />
                    <ui:Button
                        Appearance="Transparent"
                        Content="Edit"
                        Icon="{ui:SymbolIcon Edit24}"
                        IsEnabled="False"
                        ToolTip="Profile editor — coming next"
                        ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
                <ui:TextBox
                    Width="260"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search manufacturer, model, type"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <ui:InfoBar
            Margin="6,6,6,0"
            DockPanel.Dock="Top"
            IsClosable="True"
            IsOpen="{Binding StatusMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=Bool}"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}"
            Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Manufacturer → model tree -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Fixture definitions" />
                    </Border>
                    <TreeView
                        AutomationProperties.Name="Fixture profiles"
                        BorderThickness="0"
                        ItemsSource="{Binding Manufacturers}"
                        SelectedItemChanged="OnTreeSelectionChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ManufacturerNode}" ItemsSource="{Binding Profiles}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Folder24" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type profiles:FixtureProfile}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        x:Name="VerifiedIcon"
                                        Margin="0,0,6,0"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Symbol="Warning24"
                                        ToolTip="Unverified: confirm channels on the real light" />
                                    <TextBlock Text="{Binding Model}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Verified}" Value="True">
                                        <Setter TargetName="VerifiedIcon" Property="Symbol" Value="CheckmarkCircle24" />
                                        <Setter TargetName="VerifiedIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="VerifiedIcon" Property="ToolTip" Value="Verified on the real fixture" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

            <!-- Profile details -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Profile" />
                    </Border>

                    <TextBlock
                        Margin="12"
                        Style="{StaticResource HintText}"
                        Text="Pick a fixture definition on the left, or import a QLC+ fixture file."
                        Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                    <DockPanel Margin="12,10" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Manufacturer" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SelectedProfile.Manufacturer}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Model" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding SelectedProfile.Model}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Type" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SelectedProfile.Type}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Verified" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚠ No — test each channel on the real light" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfile.Verified}" Value="True">
                                                <Setter Property="Text" Value="✓ Yes" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Source" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedProfile.Source}"
                                TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="DMX mode" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Orientation="Horizontal">
                                <ComboBox
                                    MinWidth="220"
                                    AutomationProperties.Name="DMX mode"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Modes}"
                                    SelectedItem="{Binding SelectedMode}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedMode.ChannelCount, StringFormat={}{0} channels}" />
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            Margin="0,4,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Channels}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="50" Binding="{Binding Number}" Header="Ch" />
                                <DataGridTemplateColumn Width="200" Header="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChannelRowViewModel}">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="6,0,0,0"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="⚠"
                                                    ToolTip="Unknown meaning — available as a raw 0–255 channel only"
                                                    Visibility="{Binding IsGeneric, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="130" Binding="{Binding Type}" Header="Type" />
                                <DataGridTextColumn Width="70" Binding="{Binding Default}" Header="Default" />
                                <DataGridTextColumn Width="*" Binding="{Binding Ranges}" Header="Ranges">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
