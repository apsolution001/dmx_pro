<UserControl
    x:Class="DmxPro.App.Views.ProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:profiles="clr-namespace:DmxPro.Core.Profiles;assembly=DmxPro.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:InfoBar
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="{Binding StatusMessage, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=Bool}"
            Message="{Binding StatusMessage}"
            Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
            <ui:InfoBar.Style>
                <Style BasedOn="{StaticResource {x:Type ui:InfoBar}}" TargetType="ui:InfoBar">
                    <Setter Property="Severity" Value="Success" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Severity" Value="Warning" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:InfoBar.Style>
        </ui:InfoBar>

        <!-- Profile list -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Appearance="Primary"
                Command="{Binding ImportCommand}"
                Content="Import profile (.qxf / .json)…"
                DockPanel.Dock="Top"
                Icon="{ui:SymbolIcon ArrowImport24}" />
            <ui:TextBox
                Margin="0,0,0,8"
                DockPanel.Dock="Top"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Search manufacturer, model, type…"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ListView
                AutomationProperties.Name="Fixture profiles"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}"
                VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type profiles:FixtureProfile}">
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Model}" />
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding Manufacturer, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Type, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <ui:SymbolIcon
                                x:Name="VerifiedIcon"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24"
                                ToolTip="Unverified: confirm channels on the real light" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Verified}" Value="True">
                                <Setter TargetName="VerifiedIcon" Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter TargetName="VerifiedIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="VerifiedIcon" Property="ToolTip" Value="Verified on the real fixture" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- Empty state -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource SecondaryText}"
            Text="No profile selected. Pick one on the left or import a QLC+ fixture file."
            Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

        <!-- Profile details -->
        <ui:Card
            Grid.Row="1"
            Grid.Column="2"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding SelectedProfile.DisplayName}" />
                        <Border Margin="12,0,0,0" Style="{StaticResource Badge}">
                            <TextBlock FontSize="12" Text="{Binding SelectedProfile.Type}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="{Binding SelectedProfile.Source}" />

                    <StackPanel Margin="0,16,0,12" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="DMX mode" />
                        <ComboBox
                            MinWidth="220"
                            AutomationProperties.Name="DMX mode"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Modes}"
                            SelectedItem="{Binding SelectedMode}" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}">
                            <Run Text="{Binding SelectedMode.ChannelCount, Mode=OneWay}" />
                            <Run Text="channels" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Channels}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="56" Binding="{Binding Number}" Header="Ch" />
                        <DataGridTemplateColumn Width="200" Header="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ChannelRowViewModel}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                        <ui:SymbolIcon
                                            Margin="6,0,0,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="Warning24"
                                            ToolTip="Unknown meaning — available as a raw 0–255 channel only"
                                            Visibility="{Binding IsGeneric, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="140" Binding="{Binding Type}" Header="Type" />
                        <DataGridTextColumn Width="80" Binding="{Binding Default}" Header="Default" />
                        <DataGridTextColumn Width="*" Binding="{Binding Ranges}" Header="Ranges">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </ui:Card>
    </Grid>
</UserControl>
