<UserControl
    x:Class="DmxPro.App.Views.FunctionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:DmxPro.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fn="clr-namespace:DmxPro.Core.Functions;assembly=DmxPro.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DmxPro.App.Views"
    xmlns:vm="clr-namespace:DmxPro.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FunctionsViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding CloseEditorCommand}" Gesture="Escape" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <!-- Ctrl+F jumps to the search box. -->
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </UserControl.CommandBindings>

    <UserControl.Resources>
        <!-- Small badge next to a function name ("in show: Wedding"). -->
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- "Coming soon" entries of menus: disabled, tooltip still shown. -->
        <Style
            x:Key="ComingSoonMenuItem"
            BasedOn="{StaticResource Dmx.MenuItem}"
            TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ToolTip" Value="Coming soon" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <!-- On-screen stage preview: one circle per targeted fixture, coloured from its scene values. -->
        <DataTemplate x:Key="PreviewLightTemplate" DataType="{x:Type vm:PreviewLight}">
            <StackPanel
                Width="52"
                Margin="0,0,2,2"
                AutomationProperties.Name="{Binding ToolTip}"
                ToolTip="{Binding ToolTip}">
                <Ellipse
                    Width="22"
                    Height="22"
                    Fill="{Binding Color}"
                    Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                    StrokeThickness="1" />
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource Dmx.FontSize.Caption}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItemsPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Right-click menu of the function tree (acts on the selected function). -->
        <ContextMenu x:Key="FunctionContextMenu">
            <MenuItem Header="New">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Scene}"
                    Header="Scene"
                    ToolTip="A static look: fixed values for chosen fixture channels">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Scenes" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Chaser}"
                    Header="Chaser"
                    ToolTip="Plays scenes (or other functions) one after another">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Chaser" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Sequence}"
                    Header="Sequence"
                    ToolTip="Steps with their own channel values, like a chaser of mini-scenes">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Sequence" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.ColorCycle}"
                    Header="Color cycle"
                    ToolTip="Fixtures cycle through a list of colours">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="ColorCycle" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Fade}"
                    Header="Fade"
                    ToolTip="Moves from one scene to another over a time">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Fade" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Pulse}"
                    Header="Pulse"
                    ToolTip="Brightness rises and falls (breathing)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Pulse" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Flash}"
                    Header="Flash"
                    ToolTip="Full-brightness colour while a button is held">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Flash" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding NewFunctionCommand}"
                    CommandParameter="{x:Static fn:FunctionType.Strobe}"
                    Header="Strobe"
                    ToolTip="Flashing light (respects the strobe safety settings)">
                    <MenuItem.Icon>
                        <c:DmxIcon Kind="Strobe" Size="{StaticResource Dmx.SmallIconSize}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding EditCommand}"
                Header="Edit"
                InputGestureText="Enter">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Edit" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Header="Preview"
                InputGestureText="Space"
                IsEnabled="False"
                ToolTip="Works when the engine and DMX output are connected"
                ToolTipService.ShowOnDisabled="True">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Play" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding BeginRenameCommand}"
                Header="Rename"
                InputGestureText="F2">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding DuplicateCommand}"
                Header="Duplicate"
                InputGestureText="Ctrl+D">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Header="Copy"
                InputGestureText="Ctrl+C"
                Style="{StaticResource ComingSoonMenuItem}">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Copy" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Header="Paste"
                InputGestureText="Ctrl+V"
                Style="{StaticResource ComingSoonMenuItem}">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Paste" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Add to Virtual Console" Style="{StaticResource ComingSoonMenuItem}">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Console" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding DeleteCommand}"
                Header="Delete"
                InputGestureText="Del">
                <MenuItem.Icon>
                    <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.SmallIconSize}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═════════════ Page toolbar ═════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PageToolbar}">
            <DockPanel LastChildFill="False">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="New function"
                        Click="OnNewMenuButtonClick"
                        Style="{StaticResource ToolbarPrimaryButton}"
                        ToolTip="Create a new function: scene, chaser, sequence, color cycle, fade, pulse, flash or strobe">
                        <StackPanel Orientation="Horizontal">
                            <c:DmxIcon Kind="Add" Size="{StaticResource Dmx.ButtonIconSize}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="New" />
                            <c:DmxIcon
                                Margin="4,0,0,0"
                                Kind="ChevronDown"
                                Size="{StaticResource Dmx.DenseIconSize}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Scene}"
                                    Header="Scene"
                                    ToolTip="A static look: fixed values for chosen fixture channels">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Scenes" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Chaser}"
                                    Header="Chaser"
                                    ToolTip="Plays scenes (or other functions) one after another">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Chaser" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Sequence}"
                                    Header="Sequence"
                                    ToolTip="Steps with their own channel values, like a chaser of mini-scenes">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Sequence" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.ColorCycle}"
                                    Header="Color cycle"
                                    ToolTip="Fixtures cycle through a list of colours">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="ColorCycle" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Fade}"
                                    Header="Fade"
                                    ToolTip="Moves from one scene to another over a time">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Fade" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Pulse}"
                                    Header="Pulse"
                                    ToolTip="Brightness rises and falls (breathing)">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Pulse" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Flash}"
                                    Header="Flash"
                                    ToolTip="Full-brightness colour while a button is held">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Flash" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding NewFunctionCommand}"
                                    CommandParameter="{x:Static fn:FunctionType.Strobe}"
                                    Header="Strobe"
                                    ToolTip="Flashing light (respects the strobe safety settings)">
                                    <MenuItem.Icon>
                                        <c:DmxIcon Kind="Strobe" Size="{StaticResource Dmx.SmallIconSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button
                        AutomationProperties.Name="Edit selected function"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Edit the selected function (Enter or double-click)">
                        <c:DmxIcon Kind="Edit" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Duplicate selected function"
                        Command="{Binding DuplicateCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Duplicate the selected function (Ctrl+D)">
                        <c:DmxIcon Kind="Duplicate" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Rename selected function"
                        Command="{Binding BeginRenameCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Rename the selected function (F2)">
                        <c:DmxIcon Kind="Rename" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Delete selected function"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Delete the selected function (Del)">
                        <c:DmxIcon Kind="Delete" Size="{StaticResource Dmx.ToolbarIconSize}" />
                    </Button>
                </StackPanel>

                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Show functions used only in shows"
                        Content="Show-only copies"
                        FontSize="{StaticResource Dmx.FontSize.Small}"
                        IsChecked="{Binding ShowHiddenShowCopies}"
                        ToolTip="Also list the show copies that are hidden from this list, so you can tick 'Show in function list'" />
                    <ComboBox
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Function type filter"
                        ItemsSource="{Binding TypeOptions}"
                        SelectedItem="{Binding TypeFilter}"
                        Style="{StaticResource FormComboBox}"
                        ToolTip="Show only one type of function" />
                    <ui:TextBox
                        x:Name="SearchBox"
                        Width="180"
                        Margin="0"
                        AutomationProperties.Name="Search functions"
                        PlaceholderText="Search functions"
                        Style="{StaticResource FormTextBox}"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Search by name, type or show name; several words narrow it down (Ctrl+F). Esc clears.">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Command="{Binding ClearSearchCommand}" Gesture="Escape" />
                        </ui:TextBox.InputBindings>
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="{StaticResource Dmx.PageBodyMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="35*" MinHeight="80" />
                <RowDefinition Height="4" />
                <RowDefinition Height="65*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- ═════════════ Top: function tree, grouped by type (no panel title: the page is the title) ═════════════ -->
            <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Grid>
                        <TreeView
                            x:Name="FunctionTree"
                            Padding="2,0"
                            AutomationProperties.Name="Function list"
                            Background="Transparent"
                            BorderThickness="0"
                            ContextMenu="{StaticResource FunctionContextMenu}"
                            ItemsSource="{Binding Groups}"
                            PreviewKeyDown="OnFunctionTreePreviewKeyDown"
                            PreviewMouseRightButtonDown="OnFunctionTreePreviewMouseRightButtonDown"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.InputBindings>
                                <KeyBinding Command="{Binding DeleteCommand}" Gesture="Delete" />
                                <KeyBinding Command="{Binding DuplicateCommand}" Gesture="Ctrl+D" />
                                <KeyBinding Command="{Binding BeginRenameCommand}" Gesture="F2" />
                            </TreeView.InputBindings>
                            <TreeView.ItemContainerStyle>
                                <!-- Type folders -->
                                <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="ItemContainerStyle">
                                        <Setter.Value>
                                            <!-- Functions -->
                                            <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                <EventSetter Event="MouseDoubleClick" Handler="OnFunctionItemDoubleClick" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHiddenFromList}" Value="True">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FunctionTreeGroupViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel MinHeight="{StaticResource Dmx.ListRowMinHeight}" Orientation="Horizontal">
                                        <c:DmxIcon
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Kind="{Binding IconKind}"
                                            Size="{StaticResource Dmx.DenseIconSize}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding Header}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Count}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:FunctionRowViewModel}">
                                    <StackPanel MinHeight="{StaticResource Dmx.ListRowMinHeight}" Orientation="Horizontal">
                                        <!-- Colour (scene: first fixture; effects: their colour); a hollow ring when there is none -->
                                        <Grid
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                            <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                            <Ellipse
                                                Fill="{Binding Swatch}"
                                                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                StrokeThickness="1"
                                                ToolTip="Colour of the function (on screen only)"
                                                Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBox
                                                MinWidth="160"
                                                Padding="2,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Function name"
                                                IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                                                LostKeyboardFocus="OnRenameBoxLostKeyboardFocus"
                                                Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Command="{Binding CommitRenameCommand}" Gesture="Enter" />
                                                    <KeyBinding Command="{Binding CancelRenameCommand}" Gesture="Escape" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                        <Border
                                            Style="{StaticResource BadgeBorder}"
                                            ToolTip="This is a show's own copy: changing it never changes the original"
                                            Visibility="{Binding HasShowBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                FontSize="{StaticResource Dmx.FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ShowBadge}" />
                                        </Border>
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource Dmx.FontSize.Small}"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Details}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <!-- Empty states -->
                        <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                            <c:DmxIcon
                                Kind="Functions"
                                Size="{StaticResource Dmx.EmptyStateIconSize}"
                                Style="{StaticResource EmptyStateIcon}" />
                            <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No functions yet" />
                            <TextBlock Style="{StaticResource EmptyStateText}" Text="Click New and pick a type. Start with a scene: chasers, fades and sequences build on scenes." />
                            <Button
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="New scene"
                                Command="{Binding NewSceneCommand}"
                                Style="{StaticResource ToolbarPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <c:DmxIcon Kind="Scenes" Size="{StaticResource Dmx.ButtonIconSize}" />
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="New scene" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding NoFilterResults, Converter={StaticResource BoolToVisibility}}">
                            <c:DmxIcon
                                Kind="Search"
                                Size="{StaticResource Dmx.EmptyStateIconSize}"
                                Style="{StaticResource EmptyStateIcon}" />
                            <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No matching functions" />
                            <TextBlock Style="{StaticResource EmptyStateText}" Text="Clear the search (Esc) or pick All types." />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}" />

            <!-- ═════════════ Bottom: hint, summary or editor ═════════════ -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <!-- Nothing selected -->
                    <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding IsNothingSelected, Converter={StaticResource BoolToVisibility}}">
                        <c:DmxIcon
                            Kind="Functions"
                            Size="{StaticResource Dmx.EmptyStateIconSize}"
                            Style="{StaticResource EmptyStateIcon}" />
                        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No function selected" />
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="Double-click a function (or press Enter) to edit it. Selecting never changes the lights." />
                    </StackPanel>

                    <!-- Summary of the selected function (on-screen only) -->
                    <DockPanel Visibility="{Binding IsSummaryVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <Button
                                    AutomationProperties.Name="Edit function"
                                    Command="{Binding EditCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource PanelHeaderButton}"
                                    ToolTip="Edit (Enter)">
                                    <c:DmxIcon Kind="Edit" Size="{StaticResource Dmx.DenseIconSize}" />
                                </Button>
                                <c:DmxIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Kind="{Binding SelectedRow.IconKind}"
                                    Size="{StaticResource Dmx.DenseIconSize}" />
                                <!-- One line: name · type · details (Edit button on the right). -->
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run FontWeight="SemiBold" Text="{Binding SelectedRow.Name, Mode=OneWay}" />
                                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedRow.TypeName, Mode=OneWay}" />
                                    <Run
                                        FontSize="{StaticResource Dmx.FontSize.Small}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding SelectedRow.Details, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,4">
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding SelectedIsShowCopy, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="Show in function list"
                                        Content="Show in function list"
                                        DockPanel.Dock="Left"
                                        IsChecked="{Binding SelectedShowInList}"
                                        ToolTip="Untick to list this copy only in its show" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HintText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap">
                                        <Run Text="Show's own copy (" /><Run Text="{Binding SelectedRow.ShowBadge, Mode=OneWay}" /><Run Text="): changing it never changes the original." />
                                    </TextBlock>
                                </DockPanel>

                                <!-- On-screen only: selecting never changes the lights. -->
                                <ItemsControl
                                    AutomationProperties.Name="On-screen preview"
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource PreviewLightTemplate}"
                                    ItemsPanel="{StaticResource WrapItemsPanel}"
                                    ItemsSource="{Binding SelectedPreviewLights}"
                                    ToolTip="On-screen preview only: the lights do not change. Double-click or Enter to edit." />
                                <TextBlock Style="{StaticResource HintText}" Text="On-screen preview only." />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Function editor of the selected type (shared with the Shows page): toolbar row + editor -->
                    <views:FunctionEditorPanel DataContext="{Binding Editor}" Visibility="{Binding Converter={StaticResource NullToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
