<!--
    DMX Pro logo (vector). Master artwork: Assets/Logo/dmxpro-logo.svg; Assets/Logo/dmxpro.ico is rendered from THIS
    file (keep the two in sync and regenerate the .ico when the drawing changes).

    Concept: a stage spot (light-grey fixture body) throwing an amber beam onto three dots - the three pins of a DMX/XLR
    connector, or three fixtures being lit. One accent (amber) + neutrals, on a dark rounded tile so it reads on dark
    and light backgrounds alike. Brand colours are fixed on purpose (the logo does not follow the theme).

    KEYS
      Dmx.Logo.Image         DrawingImage  Full logo (64x64 design grid) - use at 32 px and larger (About, docs).
      Dmx.Logo.Small.Image   DrawingImage  Simplified logo for 16-24 px (title bar): bigger shapes, no dots, solid beam.
      Dmx.Logo.Drawing / Dmx.Logo.Small.Drawing  The DrawingGroups behind the images.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    mc:Ignorable="po">

    <DrawingGroup x:Key="Dmx.Logo.Drawing" po:Freeze="True">
        <!-- Fixes the drawing bounds to the 64x64 design grid (the tile leaves a 2-unit margin). -->
        <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,64,64" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Tile: dark neutral with a faint light edge, so it stays visible on a dark taskbar. -->
        <GeometryDrawing Brush="#1B1F27">
            <GeometryDrawing.Pen>
                <Pen Brush="#24FFFFFF" Thickness="1" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <RectangleGeometry
                    RadiusX="13"
                    RadiusY="13"
                    Rect="2.5,2.5,59,59" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Fixture body. -->
        <GeometryDrawing Brush="#ECEFF4">
            <GeometryDrawing.Geometry>
                <RectangleGeometry
                    RadiusX="3"
                    RadiusY="3"
                    Rect="22,10,20,10" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- Beam: amber, fading towards the floor. -->
        <GeometryDrawing Geometry="M26,22 L38,22 L53,46 L11,46 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#FFFFB020" />
                    <GradientStop Offset="1" Color="#66FFB020" />
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
        <!-- Three DMX / XLR pins. -->
        <GeometryDrawing Brush="#ECEFF4">
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <EllipseGeometry
                        Center="20,52"
                        RadiusX="4"
                        RadiusY="4" />
                    <EllipseGeometry
                        Center="32,52"
                        RadiusX="4"
                        RadiusY="4" />
                    <EllipseGeometry
                        Center="44,52"
                        RadiusX="4"
                        RadiusY="4" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- 16-24 px variant: shapes snap to a 4-unit (= 1 px at 16 px) grid. -->
    <DrawingGroup x:Key="Dmx.Logo.Small.Drawing" po:Freeze="True">
        <GeometryDrawing Brush="#1B1F27">
            <GeometryDrawing.Geometry>
                <RectangleGeometry
                    RadiusX="12"
                    RadiusY="12"
                    Rect="0,0,64,64" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#ECEFF4">
            <GeometryDrawing.Geometry>
                <RectangleGeometry
                    RadiusX="3"
                    RadiusY="3"
                    Rect="20,8,24,12" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFB020" Geometry="M24,24 L40,24 L56,56 L8,56 Z" />
    </DrawingGroup>

    <DrawingImage
        x:Key="Dmx.Logo.Image"
        Drawing="{StaticResource Dmx.Logo.Drawing}"
        po:Freeze="True" />
    <DrawingImage
        x:Key="Dmx.Logo.Small.Image"
        Drawing="{StaticResource Dmx.Logo.Small.Drawing}"
        po:Freeze="True" />
</ResourceDictionary>
