<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DmxPro.Output</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are required on types and non-obvious members, not on every trivial property. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DmxPro.Output.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxPro.Core\DmxPro.Core.csproj" />
  </ItemGroup>

</Project>
